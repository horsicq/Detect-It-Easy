// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/obfuscators.yara#dexguard_a, dex/obfuscators.yara#dexguard_b, dex/obfuscators.yara#dexguard_c

meta("obfuscator", "DexGuard");

function detect() {
    var o = APKiD.dexguard();

    bDetected = o.a || o.b || o.c;

    return result();
}
