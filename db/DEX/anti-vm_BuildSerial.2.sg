// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#possible_build_serial_check

meta("anti-vm", "possible Build.SERIAL check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/os/Build;") && (APKiD.str("SERIAL"));

    return result();
}
