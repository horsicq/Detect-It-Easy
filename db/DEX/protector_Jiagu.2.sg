// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/packers.yara#jiagu_k (also)

meta("protector", "Jiagu");

function detect() {
    bDetected = DEX.isDexStringPresent("/.jiagu");

    // APKiD jiagu_k: Lvirbox/StubApp; with data ending before the declared file size
    if (APKiD.isDex() && APKiD.str("Lvirbox/StubApp;") && APKiD.isYaraDex() &&
        (APKiD.u32(0x68) + APKiD.u32(0x6C) < APKiD.u32(0x20))) {
        sVersion = "K";
        bDetected = true;
    }

    return result();
}