meta("packer", "AppGuard");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.hex("00?? 4c63 6f6d 2f69 6e63 612f 7365 6375 7269 7479 2f (49|69) (49|69) (49|69) (49|69) (49|69) (49|69) (49|69) [0-10] 3b 00") || APKiD.str("Lcom/inca/security/Proxy/JNISoxProxy;") || APKiD.str("Lcom/inca/security/Service/AppGuardService;"));

    return result();
}
