// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/compilers.yara#jack_4_12, dex/compilers.yara#jack_3x, dex/compilers.yara#jack_4x, dex/compilers.yara#jack_5x, dex/compilers.yara#jack_generic

meta("compiler", "Jack");

function detect() {
    var o = APKiD.compilers();

    if (o.jack_4_12) {
        sVersion = "4.12";
    } else if (o.jack_3x) {
        sVersion = "3.x";
    } else if (o.jack_4x) {
        sVersion = "4.x";
    } else if (o.jack_5x) {
        sVersion = "5.x";
    } else if (o.jack_generic) {
        sOptions = "unknown version";
    }

    bDetected = o.jack_4_12 || o.jack_3x || o.jack_4x || o.jack_5x || o.jack_generic;

    return result();
}
