// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_build_user

meta("anti-vm", "Build.USER check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/os/Build;") && (APKiD.str("TAGS") && APKiD.str("android-build"));

    return result();
}
