// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/packers.yara#manxi_sec

meta("packer", "Manxi Security");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.str("Lcom/manxi/shell/Helper;") || APKiD.str("Lcom/manxi/shell/MXApplication;"));

    return result();
}
