// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_build_model

meta("anti-vm", "Build.MODEL check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/os/Build;") && APKiD.str("MODEL") && (APKiD.str("google_sdk") || APKiD.str("sdk") || APKiD.str("Emulator") || APKiD.text("Android SDK built for x86") || APKiD.text("Full Android on x86"));

    return result();
}
