meta("packer", "JsonPacker");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.hex("b0 9b da 0? 0? 00 b3 9c b0 1c b0 5c 93 0? 0? 0? d8 0? 0? ff b0 5c b4 66 b0 6c 97 05 0c 0a") || APKiD.hex("b0 ?? da 0? 0? 00 b0 ?? 93 0? 0? 0? (b3 69 | db 04 04 01) (b7 69 | df 04 04 01) b0 ?? 94 0? 0? 0? b0 ?? (b7 b4 | 97 04 07 09 )") || APKiD.hex("b0 36 dc 07 05 02 48 07 02 07 d8 08 06 e5 d8 08 08 26 91 03 08 03 b7 74")) && APKiD.hex("6e 20 ?? ?? 10 00 0c ?? 1f 0?");

    return result();
}
