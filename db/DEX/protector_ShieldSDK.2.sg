// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/protectors.yara#shield_sdk

meta("protector", "Shield SDK");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.str("Lcom/shield/android/Shield;") || APKiD.str("Lcom/shield/android/internal/NativeUtils;") || APKiD.str("Lcom/shield/android/common/BuildConfig;") || APKiD.str("Lcom/shield/android/common/ShieldModule;"));

    return result();
}
