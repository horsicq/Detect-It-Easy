// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_build_fingerprint

meta("anti-vm", "Build.FINGERPRINT check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/os/Build;") && APKiD.str("FINGERPRINT") && (APKiD.hex("00 07 67 65 6E 65 72 69 63 00 0A") || APKiD.str("unknown") || APKiD.text("generic/sdk/generic") || APKiD.text("generic/generic/generic") || APKiD.text("generic/google_sdk/generic") || APKiD.text("generic_x86/sdk_x86/generic_x86") || APKiD.text("Android/full_x86/generic_x86") || APKiD.text("generic/vbox86p/vbox86p"));

    return result();
}
