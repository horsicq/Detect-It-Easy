// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/packers.yara#kiwisec_dex

meta("packer", "KiwiSec");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.str("Lcom/kiwisec/crash/CrashUtils;") || APKiD.str("Lcom/kiwivm/security/StubApplication;"));

    return result();
}
