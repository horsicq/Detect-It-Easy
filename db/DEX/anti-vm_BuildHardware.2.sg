// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_build_hardware

meta("anti-vm", "Build.HARDWARE check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/os/Build;") && APKiD.str("HARDWARE") && (APKiD.str("goldfish") || APKiD.str("ranchu") || APKiD.text("vbox86"));

    return result();
}
