// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/obfuscators.yara#gemalto_sdk

meta("obfuscator", "Gemalto");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.text("Lcom/gemalto/idp/mobile/") || APKiD.text("Lcom/gemalto/medl/") || APKiD.text("Lcom/gemalto/ezio/mobile/sdk/"));

    return result();
}
