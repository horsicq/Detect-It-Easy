// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/abnormal.yara#data_injected_after_map

meta("dropper", "injected data after map section");

function detect() {
    bDetected = (APKiD.mapCount() >= 0) && (APKiD.u32(0x20) < APKiD.u32(0x34) + APKiD.mapCount() * 12 + 4);

    return result();
}
