// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/protectors.yara#dpt_shell

meta("protector", "DPT Shell");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.strPrefix("Lcom/luoye/dpt") || APKiD.strPrefix("Lcom/luoyesiqiu/shell") || APKiD.str("dpt-libs") || APKiD.str("dpt_JniBridge") || APKiD.str("libdpt.so"));

    return result();
}
