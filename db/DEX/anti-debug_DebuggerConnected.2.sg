// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_debugger_present

meta("anti-debug", "Debug.isDebuggerConnected() check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/os/Debug;") && (APKiD.text("Debug") && APKiD.text("isDebuggerConnected"));

    return result();
}
