// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_build_product

meta("anti-vm", "Build.PRODUCT check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/os/Build;") && APKiD.str("PRODUCT") && (APKiD.str("google_sdk") || APKiD.str("sdk"));

    return result();
}
