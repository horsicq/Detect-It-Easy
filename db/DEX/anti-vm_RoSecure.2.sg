// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#possible_ro_secure_check

meta("anti-vm", "possible ro.secure check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && (APKiD.text("ro.secure"));

    return result();
}
