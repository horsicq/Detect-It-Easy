// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/packers.yara#medusah_dex (also)

meta("protector", "Medusah");

function detect() {
    bDetected = DEX.isDexItemStringPresent("Lcom/seworks/medusah/MedusahDex;") ||
        (APKiD.isDex() && APKiD.text("Lcom/seworks/medusah"));

    return result();
}