// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_dex.cpp:100-119)

meta("tool", "Android SDK");

function detect() {
    // DEX header version (magic "dex\n" + 3 digits) mapped to the minimum API level that
    // introduced it; other versions are printed as they are. This is the DEX format minimum,
    // not the app's compileSdk.
    var sDexVersion = "";

    for (var i = 4; i < 7; i++) {
        var nChar = DEX.readByte(i);

        if (nChar == 0) {
            break;
        }

        sDexVersion += String.fromCharCode(nChar);
    }

    var oApi = { "035": "API 14", "037": "API 24", "038": "API 26", "039": "API 28", "040": "API 29" };

    sVersion = oApi.hasOwnProperty(sDexVersion) ? oApi[sDexVersion] : sDexVersion;
    bDetected = true;

    return result();
}
