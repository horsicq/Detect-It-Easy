meta("packer", "Custom Multidex");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.hex("1a00 ???? 7110 ???? 0000 0c00 6900 ???? 1a00 ???? 7110 ???? 0000 0c00 6900 ???? 0e00") && APKiD.hex("1201 2203 ???? 6e10 ???? 0700 0c04 1a05 ???? 7030 ???? 4305 1a04 ???? 7110 ???? 0400 0c00 1224 6e30 ???? 4003 6e20 ???? 6000 0c01 1101 0d02 6e10 ???? 0200 28fb") && APKiD.hex("7110 ???? 0100 0c00 6e10 ???? 0000 0c00 1100"));

    return result();
}
