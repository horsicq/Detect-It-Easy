// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/protectors.yara#appiron

meta("protector", "Secucen AppIron");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.str("Lcom/barun/appiron/android/AppIron;") || APKiD.str("Lcom/secucen/appironexpress/AppIronException;") || APKiD.str("Lcom/secucen/appironexpress/AppIronExpress;"));

    return result();
}
