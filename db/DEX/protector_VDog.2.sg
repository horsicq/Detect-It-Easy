// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/packers.yara#crazy_dog_wrapper (also)

meta("protector", "Vdog");

function detect() {
    bDetected = DEX.isDexItemStringPresent("Lcom/vdog/Common;") ||
        (APKiD.isDex() && APKiD.nOf(2, [function () { return APKiD.str("libhdog-x86.so"); }, function () { return APKiD.str("libhdog.so"); },
            function () { return APKiD.str("Lcom/vdog/VDogApplication;"); }, function () { return APKiD.str("Lcom/vdog/VLibrary;"); },
            function () { return APKiD.str("/.cache/libvdog.so"); }]));

    return result();
}