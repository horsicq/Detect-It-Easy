// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/packers.yara#pangxie_dex (also)

meta("protector", "PangXie");

function detect() {
    bDetected = DEX.isDexStringPresent("PangXie") || DEX.isDexStringPresent("nsecure") ||
        (APKiD.isDex() && APKiD.str("Lcom/merry/wapper/WapperApplication;"));

    return result();
}