// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/protectors.yara#bugsmirror

meta("protector", "BugsMirror");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.str("BugsmirrorDefender") || APKiD.str("com.bugsmirrordefender") || APKiD.str("BugsmirrorDefenderServices.BugsmirrorDefenderServices") || APKiD.str("com.bugsmirror.mitigation") || APKiD.str("Lcom/bugsmirror/defender/Defender;") || APKiD.hex("3B 00 1B 4C 63 6F 6D 2F 62 75 67 73 6D 69 72 72 6F 72 2F 64 65 66 65 6E 64 65 72 2F 52 3B 00") || APKiD.str("Lcom/bugsmirrordefender/BuildConfig;") || APKiD.str("Lcom/bugsmirror/defenderapi/generated/BugsmirrorDefenderServicesGrpc;"));

    return result();
}
