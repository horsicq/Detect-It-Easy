// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_qemu_file

meta("anti-vm", "emulator file check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && (APKiD.text("/init.goldfish.rc") || APKiD.text("/sys/qemu_trace") || APKiD.text("/system/bin/qemud") || APKiD.text("/system/bin/qemu-props") || APKiD.text("/system/lib/libc_malloc_debug_qemu.so") || APKiD.text("/dev/qemu_pipe") || APKiD.text("/dev/socket/qemud") || APKiD.text("/dev/socket/genyd") || APKiD.text("/dev/socket/baseband_genyd"));

    return result();
}
