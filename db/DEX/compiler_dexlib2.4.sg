// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/compilers.yara#dexlib2, dex/compilers.yara#dexlib2beta (also)

meta("compiler", "dexlib2");

function detect() {
    if (DEX.getMapItemsHash() == 0x0e27e776) {
        bDetected = true;
    } else if (APKiD.compilers().dexlib2 || APKiD.compilers().dexlib2beta) {
        bDetected = true;
    }

    return result();
}