// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/abnormal.yara#abnormal_header_size

meta("abnormal", "non-standard header size");

function detect() {
    bDetected = APKiD.isDex() && APKiD.isYaraDex() && (APKiD.u32(0x24) !== 0x70);

    return result();
}
