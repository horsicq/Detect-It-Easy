// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/protectors.yara#xiaomi_xsof_sdk

meta("protector", "Xiaomi Security Open Service Client SDK");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.hexCount("00 ?? 636f 6d2e 7869 616f 6d69 2e73 6563 7572 6974 792e 7873 6f66 2e [1-128] 00", 2) > 1);

    return result();
}
