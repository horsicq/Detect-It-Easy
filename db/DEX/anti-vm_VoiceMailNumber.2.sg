// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_voicemail_number

meta("anti-vm", "voice mail number check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/telephony/TelephonyManager;") && (APKiD.str("getVoiceMailNumber") && APKiD.str("15552175049"));

    return result();
}
