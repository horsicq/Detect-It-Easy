// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_build_device

meta("anti-vm", "Build.DEVICE check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/os/Build;") && (APKiD.str("DEVICE") && APKiD.hex("00 07 67 65 6E 65 72 69 63 00 0A"));

    return result();
}
