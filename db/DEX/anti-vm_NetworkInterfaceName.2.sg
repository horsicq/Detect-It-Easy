// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_network_interface_names

meta("anti-vm", "network interface name check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && (APKiD.str("Ljava/net/NetworkInterface;") && APKiD.hex("00 07 67 65 74 4E 61 6D 65 00 0F") && APKiD.str("eth0"));

    return result();
}
