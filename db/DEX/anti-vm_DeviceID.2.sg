// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_device_id

meta("anti-vm", "device ID check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/telephony/TelephonyManager;") && (APKiD.str("getDeviceId") && APKiD.str("000000000000000"));

    return result();
}
