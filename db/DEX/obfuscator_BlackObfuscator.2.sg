// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/obfuscators.yara#blackobfuscator

meta("obfuscator", "BlackObfuscator");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.hexCount("2C ?? ?? ?? ?? ?? 28 ?? 1A 00 ?? ?? 28 ?? 1A 00 ?? ?? 28 ??", 2) >= 2) && (APKiD.hexCount("1A 00 ?? ?? 6E 10 ?? (AC | 00) 00 00 0A ?? 13 02 ?? ?? (14 0? ?? ?? ?? ?? | B7 ??) (B7 ?? | D7 ?? ?? ??)", 2) >= 2);

    return result();
}
