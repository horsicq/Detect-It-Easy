// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/protectors.yara#google_aip_installer_check

meta("protector", "Google Automatic Integrity (Installer check)");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.str("Lcom/pairip/licensecheck/LicenseContentProvider;"));

    return result();
}
