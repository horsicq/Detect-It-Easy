// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/packers.yara#tencent (also)

meta("protector", "TencentProtection");

function detect() {
    bDetected = DEX.isDexItemStringPresent("Lcom/tencent/StubShell/TxAppEntry;") ||
        (APKiD.isDex() && APKiD.nOf(2, [function () { return APKiD.str("libshella.so"); }, function () { return APKiD.str("libshellb.so"); },
            function () { return APKiD.str("libshellc.so"); }])) ||
        APKiD.str("Lcom/tencent/StubShell/TxAppEntry;") || APKiD.str("Lcom/tencent/StubShell/a;");

    return result();
}