// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/obfuscators.yara#apkencryptor (also)

meta("protector", "ApkEncryptor");

function detect() {
    bDetected = DEX.isDexItemStringPresent("Lcn/beingyi/sub/utils/Native;") ||
        ((APKiD.text("Lcn/beingyi/sub/utils/Native") || APKiD.text("Lcom/beingyi/encrypt/StringPool") || APKiD.text("Lcn/beingyi/sub/ui/JniAlert")) &&
            APKiD.isDex() && APKiD.unreadable(false) && APKiD.unreadable(true));

    return result();
}