meta("protector", "NHN AppGuard");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.hex("00 ?? 4C 63 6F 6D 2F 6E 68 6E (63 6C 6F 75 64 | 65 6E 74) 2F 61 70 70 67 75 61 72 64 2F"));

    return result();
}
