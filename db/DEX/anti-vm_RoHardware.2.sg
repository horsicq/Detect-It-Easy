// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_hardware

meta("anti-vm", "ro.hardware check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.text("ro.hardware") && (APKiD.text("goldfish") && APKiD.text("ranchu"));

    return result();
}
