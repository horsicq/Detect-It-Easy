// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/abnormal.yara#illegal_class_names

meta("anti-disassembly", "illegal class name");

function detect() {
    // $invalid (raw regex /is) evaluated over the DEX string table: a string of up to 3
    // characters and L, path components, then a reserved Windows file name.
    bDetected = DEX.isDexStringPresentExp("^[^\\x00]{0,3}[Ll]([^\\x00/]+/)*([Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Cc][Ll][Oo][Cc][Kk]\\$|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(/[^\\x00/]+/+)*;$");

    return result();
}
