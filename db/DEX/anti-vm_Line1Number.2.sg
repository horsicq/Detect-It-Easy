// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_line1_number

meta("anti-vm", "line 1 number check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/telephony/TelephonyManager;") && (APKiD.str("getLine1Number") && APKiD.str("155552155"));

    return result();
}
