// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/protectors.yara#build38

meta("protector", "Build38");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.str("Lcom/build38/tak/TAK;") || APKiD.str("com.build38.tak") || APKiD.str("Build38Module") || APKiD.str("license.tak"));

    return result();
}
