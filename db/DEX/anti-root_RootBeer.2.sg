// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/protectors.yara#rootbeer

meta("anti-root", "RootBeer");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && (APKiD.str("Lcom/scottyab/rootbeer/RootBeer;"));

    return result();
}
