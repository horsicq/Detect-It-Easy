// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/compilers.yara#r8, dex/compilers.yara#r8_merged, dex/compilers.yara#r8_no_marker

meta("compiler", "r8");

function detect() {
    var o = APKiD.compilers();

    if (o.r8) {
        bDetected = true;
    } else if (o.r8_merged) {
        sOptions = "possible dexmerge";
        bDetected = true;
    } else if (o.r8_no_marker) {
        sOptions = "without marker (suspicious)";
        bDetected = true;
    }

    return result();
}
