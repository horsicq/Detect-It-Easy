// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/compilers.yara#dx, dex/compilers.yara#dx_merged

meta("compiler", "dx");

function detect() {
    var o = APKiD.compilers();

    if (o.dx) {
        bDetected = true;
    } else if (o.dx_merged) {
        sOptions = "possible dexmerge";
        bDetected = true;
    }

    return result();
}
