// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/obfuscators.yara#kiwi_amazon (also)

meta("protector", "Kiwi encrypter");

function detect() {
    // APKiD kiwi_amazon also needs "KiwiVersionEncrypter.java"; the existing single-string test is kept.
    bDetected = DEX.isDexStringPresent("Kiwi__Version__Obfuscator");

    return result();
}