meta("anti-vm", "ro.kernel.qemu check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && (APKiD.text("ro.kernel.qemu"));

    return result();
}
