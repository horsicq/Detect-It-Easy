meta("packer", "G-Presto (anti-cheat)");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.str("Lcom/bishopsoft/Presto/SDK/Presto;") && APKiD.hex("02 00 01 00 00 00 00 00 ?? ?? ?? ?? 11 00 00 00 00 (1? | 2? | 3? | 4? | 5? | 6? | 7? | 8? | 9? | a? | b? | c0 | c1 | c2 | c3 | c4 | c5 | c6 | c7)"));

    return result();
}
