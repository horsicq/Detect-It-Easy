// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/protectors.yara#bureau

meta("protector", "Bureau");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.text("api.bureau.id") || APKiD.text("api.stg.bureau.id") || (APKiD.str("Lcom/bureau/devicefingerprint/BureauAPI;") || APKiD.str("Lcom/bureau/base/models/BureauConfig;") || APKiD.str("Lcom/bureau/checkRoot/VerifyRoot;")));

    return result();
}
