meta("obfuscator", "Bitwise AntiSkid");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.hex("41 6E 74 69 53 6B 69 64 20 63 6F 75 72 74 65 73 79 20 6F 66 20 42 69 74 77 69 73 65 00") || APKiD.text("AntiSkid_Encrypted_Strings_Courtesy_of_Bitwise") || APKiD.text("Don't be a script kiddy, go actually learn something. Stealing credit is pathetic, you didn't make this or even contribute to it and you know it.") || APKiD.hex("4F 6E 6C 79 20 73 6B 69 64 73 20 63 61 6E 27 74 20 67 65 74 20 70 6C 61 69 6E 74 65 78 74 2E 20 43 72 65 64 69 74 73 20 74 6F 20 42 69 74 77 69 73 65 2E 00"));

    return result();
}
