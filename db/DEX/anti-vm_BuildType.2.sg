// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_build_type

meta("anti-vm", "ro.build.type check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && (APKiD.text("ro.build.type") && APKiD.text("user"));

    return result();
}
