// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_cpuinfo

meta("anti-vm", "/proc/cpuinfo check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && (APKiD.text("/proc/cpuinfo") && APKiD.text("Goldfish"));

    return result();
}
