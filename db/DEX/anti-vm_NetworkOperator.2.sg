// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_network_operator

meta("anti-vm", "network operator name check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/telephony/TelephonyManager;") && (APKiD.str("getNetworkOperatorName") && APKiD.str("Android"));

    return result();
}
