// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/packers.yara#medusah_appsolid_dex (also)

meta("protector", "AppSolid");

function detect() {
    bDetected = DEX.isDexItemStringPresent("Lweb/apache/sax/app;") ||
        (APKiD.isDex() && APKiD.text("Lweb/apache/sax/app;") && APKiD.text("Lweb/apache/sax/MainActivity;"));

    return result();
}