// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/obfuscators.yara#appsuit_a, dex/obfuscators.yara#appsuit_b

meta("obfuscator", "AppSuit");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.nOf(2, [function () { return APKiD.str("AppSuit"); }, function () { return APKiD.str("APPSUIT"); }, function () { return APKiD.str("Lcom/stealien/const;"); }, function () { return APKiD.str("La_lock;"); }, function () { return APKiD.hex("00 6c6962417070537569742e736f 00"); }, function () { return APKiD.str("checkAppSuit"); }, function () { return APKiD.str("stealien"); }]) || APKiD.strPrefix("Lcom/stealien/appsuit/"));

    return result();
}
