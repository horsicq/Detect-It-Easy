meta("packer", "jar_pack01");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.hex("00 6F 6E 43 72 65 61 74 65 00 28 29 56 00 63 6F 6D 2F 76") && APKiD.hex("2E 6A 61 72 00 2F 64 61 74 61 2F 64 61 74 61 2F 00 2F") && APKiD.hex("2E 6A 61 72 00 77 00 6A 61 76 61 2F 75 74 69 6C 2F 4D 61 70 00 67 65 74 49 6E 74 00"));

    return result();
}
