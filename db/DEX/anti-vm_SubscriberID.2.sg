// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/anti-vm.yara#checks_subscriber_id

meta("anti-vm", "subscriber ID check");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && APKiD.str("Landroid/telephony/TelephonyManager;") && (APKiD.str("getSubscriberId") && APKiD.text("0000000000"));

    return result();
}
