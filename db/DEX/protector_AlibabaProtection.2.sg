// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/protectors.yara#alibaba_sec (also)

meta("protector", "AlibabaProtection");

function detect() {
    bDetected = DEX.isDexItemStringPresent("Lcom/ali/mobisecenhance/StubApplication;") ||
        (APKiD.isDex() && APKiD.str("Lcom/ali/mobisecenhance/Init;"));

    return result();
}