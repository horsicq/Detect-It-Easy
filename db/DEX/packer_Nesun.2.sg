// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/packers.yara#nesun_dex

meta("packer", "Nesun");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.str("zVersion") && APKiD.str("zprotect") && APKiD.str("Lcom/nesun/stub/ZAP;"));

    return result();
}
