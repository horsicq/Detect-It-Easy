// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/protectors.yara#ahnlab_v3_engine

meta("anti-root", "Ahnlab V3 Engine");

function detect() {
    if (!DEX.isHeuristicScan()) {
        return result();
    }

    bDetected = APKiD.isDex() && (APKiD.textCount("Lcom/ahnlab/enginesdk/", 11) > 10);

    return result();
}
