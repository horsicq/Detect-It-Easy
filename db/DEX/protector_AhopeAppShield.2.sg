// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dex/protectors.yara#ahope_appshield

meta("protector", "Ahope AppShield");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.str("Lcom/ahope/app_shields/BuildConfig;") || APKiD.str("Lcom/ahope/app_shields/PureAppClient;"));

    return result();
}
