meta("packer", "MultidexPacker");

function detect() {
    bDetected = APKiD.isDex() && (APKiD.hex("13 00 58 01 71 10 ?? ?? 00 00 0C 00 69 00 ?? ?? 13 00 67 01 71 10 ?? ?? 00 00 0C 00 69 00 ?? ?? 13 00 76 01 71 10 ?? ?? 00 00") && APKiD.hex("70 20 ?? ?? 40 00 6E 10 ?? ?? 0? 00 0B 0? 6E 30 ?? ?? 40 05 6E 20 ?? ?? 03 00 62 00 ?? ?? 22 04 ?? ?? 70 20 ?? ?? 14 00 22 05 ?? ?? 70 20 ?? ?? 35 00 71 30 ?? ?? 40 05"));

    return result();
}
