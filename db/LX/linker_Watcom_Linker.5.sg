// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_lx.cpp:77)

meta("linker", "Watcom Linker");

function detect() {
    var nEP = LX.getEntryPointOffset();
    if (nEP >= 0 && nEP < LX.getSize()) {
        var nScan = Math.min(0x100, LX.getSize() - nEP);
        if (LX.findString(nEP, nScan, "Open Watcom") !== -1 || LX.findString(nEP, nScan, "WATCOM") !== -1) {
            bDetected = true;
        }
    }

    return result();
}
