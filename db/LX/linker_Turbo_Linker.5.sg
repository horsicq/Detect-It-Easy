// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_lx.cpp:62)

meta("linker", "Turbo Linker");

function detect() {
    if (LX.readByte(0x1E) === 0xFB) {
        sVersion = (LX.readByte(0x1F) / 16).toFixed(1);
        bDetected = true;
    }

    return result();
}
