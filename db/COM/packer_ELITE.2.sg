// Detect It Easy: ELITE2.00S COM backward-copy/DLV decoder.
meta("packer", "ELITE");

function detect() {
    var size = Binary.getSize(), limit = Math.min(size, 0xff00);
    if (size >= 512 && size < 0xff00 &&
        Binary.compare("eb01909c061e60fdb9....bf....be....f3a48bf746bf000168....fcc3") &&
        Binary.isSignaturePresent(0, limit, "d1d5fece75068b2c4646b610c3fb611f079d680001c3")) {
        sVersion = "2.00S";
        bDetected = true;
    }
    return result();
}
