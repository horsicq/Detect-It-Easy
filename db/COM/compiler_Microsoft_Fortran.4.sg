// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_com.cpp:190)

meta("compiler", "Microsoft Fortran");

function detect() {
    if (COM.compare("C3")) {
        var nAddr1 = COM.readWord(1);
        if (nAddr1 >= 0x100) {
            var nOff1 = nAddr1 - 0x100;
            if (COM.compare("01....C3", nOff1)) {
                var nAddr2 = COM.readWord(nOff1 + 4);
                if (nAddr2 >= 0x100) {
                    var nOff2 = nAddr2 - 0x100;
                    if (COM.compare("AF32....32....21....22....2A06002BF9C50E0CCD0500D61F9F32....211415C2....21212222", nOff2)) {
                        sVersion = "3.44";
                        bDetected = true;
                    }
                }
            }
        }
    }

    return result();
}
