// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// PMarc self-extracting archive for CP/M (xxfclib archive/pmarc_sfx, PMexe
// or PMsfx 2.00): a "-pms-" stub record at offset 2 and the "PMexe Version"
// or "PMsfx Version" banner at 14, then the "-pm?-" member records.
meta("sfx", "PMarc PMexe");

function detect() {
    if (COM.compare("'-pms-'", 2) && (COM.compare("'PMexe Version '", 14) || COM.compare("'PMsfx Version '", 14))) {
        sOptions = COM.getString(14, 5);
        sVersion = COM.getString(28, 4);
        bDetected = true;
    }

    return result();
}
