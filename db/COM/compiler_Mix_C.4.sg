// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_com.cpp:76-77,131)

meta("compiler", "Mix C");

function detect() {
    if (COM.compare("EB60....DF03....0000B048'RUNTIME.OVY'")) {
        sVersion = "2.02";
        bDetected = true;
    } else if (COM.compare("EB6D....E103....0000B0490000'RUNTIME.OVY'")) {
        sVersion = "2.51";
        bDetected = true;
    } else if (COM.compare("DD2100011832....604A........00'RUNTIME OVY'")) {
        sVersion = "2.0-2.1";
        bDetected = true;
    }

    return result();
}
