// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://sembiance.com/fileFormatSamples/archive/packerJESCOREPacked/
meta("packer", "JESCORE");

function detect() {
    if (COM.compare("be....bd....558bce8d72..bf....d1e9fd57f3a58d75..fcf9bf....c3")) {
        sOptions = "1997 by JES //CORE";
        bDetected = true;
    } else if (COM.compare("be....bd....558bce8d72..bf....d1e9fd57f3a58d75..fcf98bfdc3")) {
        sVersion = "1.2b";
        sOptions = "1997 by JES //CORE";
        bDetected = true;
    }

    return result();
}