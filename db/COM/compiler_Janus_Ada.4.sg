// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_com.cpp:79-82)

meta("compiler", "Janus Ada");

function detect() {
    if (COM.compare("C3....'Copyright 1982 - RR Software P.O. Box 1512, Madison WI  53701'")) {
        sVersion = "1.4.5";
        bDetected = true;
    } else if (COM.compare("C3....'Copyright 1984-RR Software,Inc P.O.Box 1512, Madison WI 53701'")) {
        sVersion = "1.5.0";
        bDetected = true;
    }

    return result();
}
