function detect() {
    if (COM.compare("C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....C3....310D'RTP REV 00.8R'")) {
