// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_com.cpp:153-154)

meta("compiler", "Small C");

function detect() {
    if (COM.compare("2A0600F9CD....CD....CD....") ||
        COM.compare("E1D1C1C5D5E5CD0500C3....")) {
        sVersion = "1.2, plus 1.0";
        bDetected = true;
    }

    return result();
}
