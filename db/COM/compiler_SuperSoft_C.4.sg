// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_com.cpp:199)

meta("compiler", "SuperSoft C");

function detect() {
    if (COM.compare("C3")) {
        var nAddr = COM.readWord(1);
        if (nAddr >= 0x100) {
            var nOff = nAddr - 0x100;
            if (COM.compare("0100003E023CEA....047832....11....0E09CD05002A0600F9CD....C7'SuperSoft C Copyright 1982'0D0A'Run Time Package V1.3'", nOff)) {
                sVersion = "1.1.25";
                bDetected = true;
            }
        }
    }

    return result();
}
