// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_com.cpp:123,188)

meta("compiler", "Microsoft COBOL");

function detect() {
    if (COM.compare("21004C01....11800109EB09037E122B1B0B78B1C20D01C3....")) {
        sVersion = "4.65";
        bDetected = true;
    } else if (COM.compare("C3")) {
        var nAddr1 = COM.readWord(1);
        if (nAddr1 >= 0x100) {
            var nOff1 = nAddr1 - 0x100;
            if (COM.compare("00CD....0021....00C3................30240680........01800000000000007800....F0", nOff1)) {
                sVersion = "4.01";
                bDetected = true;
            }
        }
    }

    return result();
}
