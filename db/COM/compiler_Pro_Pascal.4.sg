// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_com.cpp:197)

meta("compiler", "Pro Pascal");

function detect() {
    if (COM.compare("C3")) {
        var nAddr = COM.readWord(1);
        if (nAddr >= 0x100) {
            var nOff = nAddr - 0x100;
            if (COM.compare("21....C3....0101002100003E..32....ED431701221901010000210000ED431301221501", nOff)) {
                sVersion = "2.1";
                bDetected = true;
            }
        }
    }

    return result();
}
