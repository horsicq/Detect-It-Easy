// https://sembiance.com/fileFormatSamples/archive/packerPacked/
meta("packer", "B. Vorontsov");

function detect() {
    if (COM.compare("BF....BE....B9....FDF3A5FCEB0654")) {
        bDetected = true;
    }

    return result();
}
