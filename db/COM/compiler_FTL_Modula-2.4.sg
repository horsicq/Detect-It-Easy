// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_com.cpp:192-196)

meta("compiler", "FTL Modula-2");

function detect() {
    if (COM.compare("C3")) {
        var nAddr1 = COM.readWord(1);
        if (nAddr1 >= 0x100) {
            var nOff1 = nAddr1 - 0x100;
            if (COM.compare("2A06002BF9CD", nOff1)) {
                var nAddr2 = COM.readWord(nOff1 + 6);
                if (nAddr2 >= 0x100) {
                    var nOff2 = nAddr2 - 0x100;
                    if (COM.compare("2100007D32....C9", nOff2)) {
                        sVersion = "1.18";
                        bDetected = true;
                    } else if (COM.compare("2100007D32....2181007D32....2100007D32....2100007D32....C9", nOff2)) {
                        sVersion = "1.30";
                        bDetected = true;
                    }
                }
                if (!bDetected && COM.compare("2A06002BF9CD....CD....C300000000000000000000", nOff1)) {
                    sVersion = "1.18-1.30";
                    bDetected = true;
                }
            } else if (COM.compare("2A06002BF9C300000000000000000000", nOff1)) {
                sVersion = "1.18-1.30";
                bDetected = true;
            }
        }
    }

    return result();
}
