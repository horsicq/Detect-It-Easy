// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Pocket Soft RTPatch package (xxfclib installer/rtpatch): "K*" (or EE 76
// for the extended 6.02 form) and the generation word 101..650.
meta("archive", "RTPatch package");

function detect() {
    if (Binary.compare("'K*'") || Binary.compare("EE76")) {
        var nGeneration = Binary.readWord(2);
        if ([101, 110, 200, 210, 211, 300, 320, 400, 410, 500, 520, 602, 650].indexOf(nGeneration) >= 0) {
            sVersion = Math.floor(nGeneration / 100) + "." + (nGeneration % 100 < 10 ? "0" : "") + (nGeneration % 100);
            bDetected = true;
        }
    }

    return result();
}
