// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Quantum archive (xxfclib archive/quantum, David Stafford's Q.EXE, the
// Borland installer volumes): "DS", a zero byte, a non-zero version, the file
// count and the LZ window order 10..21.
meta("archive", "Quantum");

function detect() {
    if (Binary.compare("'DS'00") && Binary.getSize() >= 8) {
        var nVersion = Binary.readByte(3);
        var nFiles = Binary.readWord(4);
        var nWindow = Binary.readByte(6);
        if (nVersion != 0 && nFiles >= 1 && nWindow >= 10 && nWindow <= 21) {
            sVersion = (nVersion >> 4) + "." + (nVersion & 15);
            sOptions = nFiles + " files, window " + nWindow;
            bDetected = true;
        }
    }

    return result();
}
