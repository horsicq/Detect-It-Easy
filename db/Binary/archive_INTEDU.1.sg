// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Intellectual Education data container (xxfclib archive/inteduft): the
// fixed four-byte tag 7C 2E 07 04, then the entries with sizes and names.
meta("archive", "INTEDU container");

function detect() {
    if (Binary.compare("7C2E0704")) {
        bDetected = true;
    }

    return result();
}
