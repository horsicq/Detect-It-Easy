// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/yumetodo/DxLib/blob/master/source/DxArchive_.h
// https://himeworks.com/tools/dxextract/
meta("archive", "DXA");

function detect() {
    if (Binary.compare("f70ee9a")) {
        sOptions = "Arcanum Knights";
        sVersion = "xored"; // Key = B34BB1E8
        bDetected = true;
    } else if (Binary.compare("'DEXA'....01db")) {
        sVersion = "unxored";
        bDetected = true;
    } else if (Binary.compare("e94c..69")) {
        sOptions = "Labyrinth of Touhou 2";
        sVersion = "xored"; // Key = 92869C41
        bDetected = true;
    } else if (Binary.compare("'DEXA'....f5..f5")) {
        sOptions = "Labyrinth of Touhou 2";
        sVersion = "unxored";
        bDetected = true;
    }

    return result();
}