// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Titan Quest ARC archive (xxfclib game/titan_quest): "ARC" NUL, version 1,
// the entry and part counts and the table offsets.
meta("archive", "Titan Quest ARC");

function detect() {
    if (Binary.compare("'ARC'0001000000")) {
        var nEntries = Binary.readDword(8);
        if (nEntries >= 1 && nEntries <= 0x100000) {
            sVersion = "1";
            sOptions = nEntries + " entries";
            bDetected = true;
        }
    }

    return result();
}
