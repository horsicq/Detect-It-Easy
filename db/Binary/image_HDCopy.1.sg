// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// HD-COPY floppy image (xxfclib filesystem/hdcopy, Oliver Fromme): FF 18,
// a label of at most 11 characters, the last cylinder 79..83 and a sector
// count of 9/10/15/17/18/20/21, then a 168-byte track map and RLE tracks.
meta("image", "HD-COPY floppy image");

function detect() {
    if (Binary.compare("FF18") && Binary.getSize() > 0xB8) {
        var nLabel = Binary.readByte(2);
        var nCylinder = Binary.readByte(0x0E);
        var nSectors = Binary.readByte(0x0F);
        if (nLabel <= 11 && nCylinder >= 79 && nCylinder <= 83 && [9, 10, 15, 17, 18, 20, 21].indexOf(nSectors) >= 0) {
            sOptions = (nCylinder + 1) + " cylinders, " + nSectors + " sectors";
            bDetected = true;
        }
    }

    return result();
}
