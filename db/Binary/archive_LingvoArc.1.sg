// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// ABBYY Lingvo installer archive (xxfclib archive/lingvoarc): the
// "lingvoArc1" / "lingvoArc2" tags with their fixed bytes, or the
// "LingvoArch" form.
meta("archive", "LingvoArc");

function detect() {
    if (Binary.compare("'lingvoArc1'00FD00DF00FF")) {
        sVersion = "1";
        bDetected = true;
    } else if (Binary.compare("'lingvoArc2'00FD00DF00FF")) {
        sVersion = "2";
        bDetected = true;
    } else if (Binary.compare("'LingvoArch'0100F01F00014000470147011F834101")) {
        sVersion = "h";
        bDetected = true;
    }

    return result();
}
