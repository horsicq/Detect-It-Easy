// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// IBM OS/2 FixPak (CSD) compressed member: a 6-byte header, one of six
// dword/word magic pairs that select the keystream seed (U3 FUN_0065af00),
// followed by the scrambled compressed stream.
meta("archive", "IBM OS/2 FixPak compressed file (CSD)");

function detect() {
    if (Binary.getSize() >= 8) {
        var nMagic = Binary.readDword(0);
        var nWord = Binary.readWord(4);
        if ((nMagic == 0x53234553 && nWord == 0x8A7A) ||
            (nMagic == 0x53594553 && nWord == 0x3473) ||
            (nMagic == 0x538F4853 && nWord == 0x61AF) ||
            (nMagic == 0x53534D53 && nWord == 0x56FF) ||
            (nMagic == 0x53135653 && nWord == 0x0643) ||
            (nMagic == 0x536F5853 && nWord == 0xD9A4)) {
            bDetected = true;
        }
    }

    return result();
}
