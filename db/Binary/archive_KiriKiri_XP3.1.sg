// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// KiriKiri XP3 archive (xxfclib game/kirikiri_xp3): the eleven-byte magic
// "XP3" CR LF SP LF 1A 8B 67 01, then the index offset.
meta("archive", "KiriKiri XP3");

function detect() {
    if (Binary.compare("'XP3'0D0A200A1A8B6701")) {
        bDetected = true;
    }

    return result();
}
