// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// DCP floppy image (xxfclib filesystem/dcp_disk, not the Wintermute DCP
// package): geometry words first (sectors per track, sides, tracks) and the
// "DCP" NUL marker at offset 92; sectors are stored or RDC-compressed.
meta("image", "DCP floppy image");

function detect() {
    if (Binary.compare("'DCP'00", 92)) {
        var nSectors = Binary.readWord(0);
        var nSides = Binary.readWord(2);
        var nTracks = Binary.readWord(4);
        if (nSectors >= 8 && nSectors <= 36 && nSides >= 1 && nSides <= 2 && nTracks >= 35 && nTracks <= 84) {
            sOptions = nTracks + "x" + nSides + "x" + nSectors;
            bDetected = true;
        }
    }

    return result();
}
