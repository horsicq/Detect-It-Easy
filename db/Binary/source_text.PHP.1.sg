// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_binary.cpp:handle_Texts)

meta("source", "PHP");

function detect() {
    if (Binary.isText()) {
        if (Binary.compare("'<?php'") || Binary.compare("EFBBBF'<?php'")) {
            bDetected = true;
        }
    }

    return result();
}
