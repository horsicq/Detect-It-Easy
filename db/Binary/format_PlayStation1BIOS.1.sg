// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/LiquidSevens/psx-models-bios-guide
meta("format", "PlayStation 1 BIOS");

function detect() {
    if (Binary.compare("1300083c3f240835801f013c")) {
        var cexModel = Binary.getString(0x0000012c, 18);

        if (/^CEX-\d+(?:\/\d+)*$/.test(cexModel)) {
            sOptions = cexModel;
            bDetected = true;
        }
    }

    return result();
}