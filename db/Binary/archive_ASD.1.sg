// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// ASD compressed stream (xxfclib archive/asd): the six-byte "ASD01" 1A
// marker, then a length-prefixed member name.
meta("archive", "ASD compressed stream");

function detect() {
    if (Binary.compare("'ASD01'1A")) {
        bDetected = true;
    }

    return result();
}
