// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_binary.cpp:handle_LibraryData)

meta("library", "Python");

function detect() {
    if (!Binary.isText() && !Binary.isPlainText() && Binary.getSize() >= 8 && Binary.compare("'#!'")) {
        var sHead = Binary.read_ansiString(0, Math.min(256, Binary.getSize()));
        if (sHead.indexOf("python") !== -1) {
            bDetected = true;
        }
    }

    return result();
}
