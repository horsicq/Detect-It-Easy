// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// CPX install volume (xxfclib installer/cpx): one of three numeric magics
// (28/2A/2C 16 27 93), then the member records with 8.3 names.
meta("archive", "CPX install volume");

function detect() {
    if (Binary.compare("28162793") || Binary.compare("2A162793") || Binary.compare("2C162793")) {
        bDetected = true;
    }

    return result();
}
