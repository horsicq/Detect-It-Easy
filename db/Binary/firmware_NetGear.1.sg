// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://netgear.com
meta("firmware", "NetGear");

function detect() {
    if (Binary.compare("2A23245E")) { // .CHK Firmware
        sOptions = File.cleanString(Binary.getString(0x00000028, 64));
        bDetected = true;
    }
    return result();
}