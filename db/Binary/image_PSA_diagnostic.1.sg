// PSA diagnostic FAT image (xxfclib filesystem/psa_disk): sixteen spaces and
// the "beer!" tag, then the sector count and length words.
meta("image", "PSA diagnostic FAT image");

function detect() {
    if (Binary.compare("'                beer!'")) {
        bDetected = true;
    }

    return result();
}
