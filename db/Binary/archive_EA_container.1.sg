// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// EA container (xxfclib archive/ea, Electronic Arts data volumes): 1A "EA"
// then the NUL-terminated name of the first member and its sizes.
meta("archive", "EA container");

function detect() {
    if (Binary.compare("1A'EA'")) {
        var c = Binary.readByte(3);
        if (c >= 0x21 && c <= 0x7E) {
            bDetected = true;
        }
    }

    return result();
}
