// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// ARCV installer archive version 4 (xxfclib installer/arcv4): "ARCV",
// a zero byte and the version 4.
meta("archive", "ARCV");

function detect() {
    if (Binary.compare("'ARCV'0004")) {
        sVersion = "4";
        bDetected = true;
    }

    return result();
}
