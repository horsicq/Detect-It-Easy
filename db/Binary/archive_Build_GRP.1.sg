// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Build engine group file (xxfclib game/build_grp, Duke Nukem 3D and other
// Ken Silverman engine games): "KenSilverman" then the entry count and
// 16-byte entries of 12-byte names and sizes.
meta("archive", "Build engine GRP");

function detect() {
    if (Binary.compare("'KenSilverman'")) {
        var nCount = Binary.readDword(12);
        if (nCount >= 1 && nCount <= 0x100000) {
            sOptions = nCount + " files";
            bDetected = true;
        }
    }

    return result();
}
