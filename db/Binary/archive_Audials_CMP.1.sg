// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Audials CMP resource container (xxfclib archive/audials): a text header
// that starts with the resource count, "FilesNumber=<digits>" CR LF.
meta("archive", "Audials CMP resources");

function detect() {
    if (Binary.compare("'FilesNumber='")) {
        var nDigit = Binary.readByte(12);
        if (nDigit >= 0x30 && nDigit <= 0x39) {
            bDetected = true;
        }
    }

    return result();
}
