// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// MLB stored archive (xxfclib archive/mlb_ft): a member count word, the
// version word 6, two offsets and 21-byte records that start with an 8.3
// name.
meta("archive", "MLB archive");

function detect() {
    var nCount = Binary.readWord(0);
    if (Binary.readWord(2) == 6 && nCount >= 1 && Binary.getSize() >= 12 + 21 * nCount) {
        var bName = true;
        for (var i = 0; i < 8; i++) {
            var c = Binary.readByte(12 + i);
            if (c != 0 && (c < 0x20 || c > 0x7E)) {
                bName = false;
            }
        }
        if (bName && Binary.readByte(12) > 0x20) {
            sVersion = "6";
            sOptions = nCount + " files";
            bDetected = true;
        }
    }

    return result();
}
