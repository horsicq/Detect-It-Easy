// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://wiki.multimedia.cx/index.php/TXD
meta("format", "TXD");

function detect() {
    if (Binary.compare("16000000........FFFF031801")) {
        sVersion = "GTA San Andreas";
        bDetected = true;
    } else if (Binary.compare("23000000........FFFF0310")) {
        sOptions = "custom header";
        sVersion = "Adiboo & Paziral's Secret";
        bDetected = true;
    }

    return result();
}