// https://www.gamekult.com/jeux/adibou-et-les-saisons-magiques-3010007102.html
meta("format", "TNI");

function detect() {
    if (Binary.compare("'CSTM'1000000004000000'CMKL'04")) {
        bDetected = true;
    }

    return result();
}