// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// COPYDISK floppy image (xxfclib filesystem/copydisk): 0x20-byte header,
// "COPYDISK", u16 sector size 0x200 at 8, then the raw sectors. Images cut
// inside the last sector are tolerated (decoders pad it with F6).
meta("image", "COPYDISK disk image");

function detect() {
    var nSize = Binary.getSize();
    if (nSize >= 0x20 + 0x200 && Binary.compare("'COPYDISK'0002")) {
        var nData = nSize - 0x20;
        sOptions = Math.ceil(nData / 512) + " sectors";
        if (nData % 512) {
            sOptions += ", last sector short by " + (512 - nData % 512) + " bytes";
        }
        bDetected = true;
    }

    return result();
}
