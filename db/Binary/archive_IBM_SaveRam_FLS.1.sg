// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// IBM SaveRam FLS archive (xxfclib archive/fls): a record count word, then
// 44-byte records; the header record starts FE 00 00 00 01 00 00 FF and the
// first member record carries FE, a flag of 0 or 1 and the tag 00 00 00 01.
meta("archive", "IBM SaveRam FLS");

function detect() {
    var nCount = Binary.readWord(0);
    if (nCount >= 2 && Binary.getSize() >= 2 + 44 * nCount && Binary.compare("FE00000001000 0FF".replace(" ", ""), 2) &&
        Binary.readByte(46) == 0xFE && Binary.readByte(47) <= 1 && Binary.compare("00000001", 48)) {
        sOptions = (nCount - 1) + " files";
        bDetected = true;
    }

    return result();
}
