// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// EVD map image container (xxfclib archive/evd): six words (0, 0, 12,
// 1 or 2, non-zero, non-zero), then entries whose type word repeats, with an
// id and a length of at least 8 before the eight-byte member signature.
meta("format", "EVD map images");

function detect() {
    if (Binary.getSize() >= 44 && Binary.readDword(0) == 0 && Binary.readDword(4) == 0 && Binary.readDword(8) == 12) {
        var nKind = Binary.readDword(12);
        var nType = Binary.readWord(24);
        if ((nKind == 1 || nKind == 2) && Binary.readDword(16) != 0 && Binary.readDword(20) != 0 &&
            nType == Binary.readWord(26) && (nType == 1 || nType == 2) && Binary.readDword(28) != 0 && Binary.readDword(32) >= 8) {
            bDetected = true;
        }
    }

    return result();
}
