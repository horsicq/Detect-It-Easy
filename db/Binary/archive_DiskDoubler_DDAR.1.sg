// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// DiskDoubler archives (xxfclib archive/diskdoubler): the DDAR archive
// ("DDAR" and a small big-endian version), the DDA2 archive ("DDA2" 00 3E)
// and the classic single-file DiskDoubler header (AB CD 00 54).
meta("archive", "DiskDoubler archive");

function detect() {
    if (Binary.compare("'DDAR'000000")) {
        var nVersion = Binary.readByte(7);
        if (nVersion >= 1 && nVersion <= 9) {
            sVersion = String(nVersion);
            sOptions = "DDAR";
            bDetected = true;
        }
    } else if (Binary.compare("'DDA2'003E")) {
        sOptions = "DDA2";
        bDetected = true;
    } else if (Binary.compare("ABCD0054")) {
        sOptions = "single file";
        bDetected = true;
    }

    return result();
}
