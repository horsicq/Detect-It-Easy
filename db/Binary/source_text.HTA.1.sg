// Detect It Easy: detection rule file
// Author: Henglie <ebhenglie@gmail.com>

// https://en.wikipedia.org/wiki/HTML_Application
meta("source", "HTA");

function detect() {
    var sText = Binary.getHeaderString(),
        sSuffix = Binary.getFileSuffix().toLowerCase();

    if (Binary.isText() && (/<hta:application\b/i.test(sText) || sSuffix === "hta")) {
        bDetected = true;
    }

    return result();
}
