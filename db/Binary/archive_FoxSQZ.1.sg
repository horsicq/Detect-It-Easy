// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Fox SQZ compressed archive (xxfclib archive/fox_sqz): the full vendor text
// marker.
meta("archive", "Fox SQZ");

function detect() {
    if (Binary.compare("'FOXSQZ COMPRESSED FILE'00")) {
        bDetected = true;
    }

    return result();
}
