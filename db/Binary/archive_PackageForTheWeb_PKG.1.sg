// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// InstallShield PackageForTheWeb encoded package (.pkg, xxfclib
// archive/pftw_pkg): a Microsoft cabinet whose bytes are XOR-ed with a
// periodic key and nibble-swapped. The key is recovered from the invariant
// cabinet prefix ("MSCF", zero, the file size, zero), as the reader does, and
// the decoded header must show version 1.3, one folder, files and a sane
// file-table offset.
meta("archive", "PackageForTheWeb package");

function swap4(b) {
    return ((b << 4) | (b >> 4)) & 0xFF;
}

function decodeHeader(raw, stream, n) {
    var h = [];
    for (var i = 0; i < 36; i++) {
        h[i] = swap4(raw[i] ^ stream[i % n]);
    }
    return h;
}

function u16(h, at) {
    return h[at] | (h[at + 1] << 8);
}

function u32(h, at) {
    return (h[at] | (h[at + 1] << 8) | (h[at + 2] << 16) | (h[at + 3] << 24)) >>> 0;
}

function periodic(stream, n, count) {
    for (var i = n; i < count; i++) {
        if (stream[i] != stream[i % n]) {
            return false;
        }
    }
    return true;
}

function detect() {
    var nSize = Binary.getSize();
    if (nSize >= 70 && nSize <= 0xFFFFFFFF) {
        var raw = [];
        var known = [];
        var stream = [];
        var i;
        var n;
        for (i = 0; i < 36; i++) {
            raw[i] = Binary.readByte(i);
            known[i] = 0;
        }
        known[0] = 0x4D;
        known[1] = 0x53;
        known[2] = 0x43;
        known[3] = 0x46;
        for (i = 0; i < 4; i++) {
            known[8 + i] = Math.floor(nSize / Math.pow(256, i)) & 0xFF;
        }
        for (i = 0; i < 16; i++) {
            stream[i] = raw[i] ^ swap4(known[i]);
        }
        var bShort = false;
        for (n = 1; n <= 16 && !bDetected; n++) {
            if (!periodic(stream, n, 16)) {
                continue;
            }
            if (n < 16) {
                bShort = true;
            }
            var h = decodeHeader(raw, stream, n);
            if (u32(h, 20) == 0 && h[24] == 3 && h[25] == 1 && u16(h, 26) == 1 && u16(h, 28) != 0 && u16(h, 30) == 0 &&
                u16(h, 34) == 0 && u32(h, 16) >= 44 && u32(h, 16) < nSize) {
                sOptions = "key " + n + ", " + u16(h, 28) + " files";
                bDetected = true;
            }
        }
        if (!bDetected && !bShort) {
            known[16] = 44;
            known[24] = 3;
            known[25] = 1;
            known[26] = 1;
            known[28] = 1;
            for (i = 16; i < 32; i++) {
                stream[i] = raw[i] ^ swap4(known[i]);
            }
            for (n = 17; n <= 32 && !bDetected; n++) {
                if (!periodic(stream, n, 32)) {
                    continue;
                }
                var h2 = decodeHeader(raw, stream, n);
                if (u16(h2, 34) == 0) {
                    sOptions = "key " + n;
                    bDetected = true;
                }
            }
        }
    }

    return result();
}
