// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// FPAK / FPAC install packs (xxfclib archive/fpak): "FPAK" or "FPAC", the
// "FPPF" tag follows in the FPAC form.
meta("archive", "FPAK install pack");

function detect() {
    if (Binary.compare("'FPAK'")) {
        sOptions = "FPAK";
        bDetected = true;
    } else if (Binary.compare("'FPACFPPF'")) {
        sOptions = "FPAC";
        bDetected = true;
    }

    return result();
}
