// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule res/protectors.yara#bugsmirror

// https://www.bugsmirror.com/
meta("protector", "BugsMirror");

// res/common.yara#is_res: { 02 00 0C 00 } at 0 and 1 of ({ 01 00 1C 00 }, { 03 00 00 00 }, { 00 02 00 00 })
function isRes(nSize) {
    return Binary.compare("02000C00") &&
        (Binary.findSignature(0, nSize, "01001C00") !== -1 || Binary.findSignature(0, nSize, "03000000") !== -1 ||
         Binary.findSignature(0, nSize, "00020000") !== -1);
}

function detect() {
    var nSize = Binary.getSize();
    if (isRes(nSize) &&
        (Binary.findSignature(0, nSize, "00....5365637572656420627920427567736d6972726f7200") !== -1 ||
         Binary.findSignature(0, nSize, "..736563757265645f62795f627567736d6972726f7200") !== -1)) {
        bDetected = true;
    }

    return result();
}
