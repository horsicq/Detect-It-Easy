// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// CSQ compressed data (xxfclib archive/csq): "TiGGER" marker, then the
// packed and unpacked sizes and the stored name.
meta("archive", "CSQ compressed data");

function detect() {
    if (Binary.compare("'TiGGER'")) {
        bDetected = true;
    }

    return result();
}
