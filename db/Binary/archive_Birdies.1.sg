// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Birdies archive (xxfclib game/birdies): three numeric archive-level
// magics, followed by the entry count and backslash paths.
meta("archive", "Birdies archive");

function detect() {
    if (Binary.compare("9CEC1200") || Binary.compare("568B3E77") || Binary.compare("B809BA00")) {
        bDetected = true;
    }

    return result();
}
