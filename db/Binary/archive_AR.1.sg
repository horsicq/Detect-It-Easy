// Detect It Easy: detection rule file
// Author: LinXP
// Status: WIP
// doc-ref: https://en.wikipedia.org/wiki/Ar_(Unix)
includeScript("archive-file");
meta("archive", "The archiver (.AR)");

function detect() {

    function ParseLibInfo() {
        if (Binary.getSize() < 0x4C) return;
        var nMachineOffset = Binary.read_uint32(0x48, _BE) + 0x3C,
            nMachine;

        if (nMachineOffset < 0x3C || nMachineOffset + 8 > Binary.getSize()) return;
        if (!Binary.compare("600A", nMachineOffset - 2)) return;

        if (Binary.compare("0000FFFF", nMachineOffset)) {
            if (nMachineOffset + 8 > Binary.getSize()) return;
            nMachine = Binary.read_uint16(nMachineOffset + 6);
        } // long format
        else {
            nMachine = Binary.read_uint16(nMachineOffset);
        } // short format

        var sArch = "";
        switch (nMachine) {
            case 0x014c: sArch = "I386"; break; // Intel 386 or later processors and compatible processors
            case 0x0162: sArch = "R3000"; break; // MIPS little-endian, 0x160 big-endian
            case 0x01c0: sArch = "ARM"; break; // ARM little-endian
            case 0x8664: sArch = "AMD64"; break; // x64
            case 0xAA64: sArch = "ARM64"; break; // ARM64 little-endian
            case 0x01c4: sArch = "ARMNT"; break; // Arm Thumb-2 little-endian
            default: return;
        }
        sType = "format";
        sName = "COFF Library (.LIB)";
        sVersion = sArch;
    }

    if (Binary.compare("'!<arch>'0A")) {
        var nSize = Binary.getSize();
        var nOffset = 8;
        var nItemCount = 0;

        while (nOffset + 60 <= nSize) {
            if (!Binary.compare("600A", nOffset + 58)) break;
            sFileName = Binary.getString(nOffset, 0x10).trim();
            var sLen = Binary.getString(nOffset + 0x30, 0x0A).trim();
            if (!/^\d+$/.test(sLen)) break;
            nFileSize = parseInt(sLen, 10);
            if (isNaN(nFileSize) || nFileSize < 0 || nFileSize > nSize - (nOffset + 60)) break;
            bDetected = true;
            nOffset += 60;
            switch (sFileName) {
                case "/": ParseLibInfo(); break;
                case "debian-binary": ParseDebInfo(); break;
                case "/\/": break;
                default: Archive.add(nFileSize, nFileSize);
            }
            nOffset += nFileSize;
            if (nFileSize & 1) nOffset += 1; // padding
            nItemCount += 1;
        }

        if (bDetected && Binary.isVerbose()) sOption(Archive.contents()); // TODO: parse DIR\FILES
    }

    function ParseDebInfo() {
        sName = "Debian Software package (.DEB)";
        sVersion = Binary.getString(nOffset, nFileSize - 1);
    }

    return result();
}