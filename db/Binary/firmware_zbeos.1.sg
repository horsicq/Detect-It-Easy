// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Compressed BeOS boot image (xxfclib firmware/zbeos): the exact boot stub
// bytes and the gzip stream at the fixed offset 0x20000.
meta("firmware", "Compressed BeOS boot image");

function detect() {
    if (Binary.compare("EB7390F873646653B801DEBE") && Binary.compare("1F8B0800", 131072)) {
        sOptions = "gzip";
        bDetected = true;
    }

    return result();
}
