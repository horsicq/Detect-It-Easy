// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://switchbrew.github.io/libnx/nro_8h_source.html
meta("format", "Nintendo Relocatable Object (.NRO)");

function detect() {
    if (Binary.compare("20000014F0000000'HOMEBREWNRO0'")) {
        bDetected = true;
    }

    return result();
}