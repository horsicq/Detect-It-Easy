// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// NPACK compressed file (xxfclib archive/npack): "MSTSM" followed directly
// by a Stac LZS bit stream (one or more blocks, each closed by an end
// marker); there are no size fields.
meta("archive", "NPACK compressed file");

function detect() {
    if (Binary.getSize() >= 16 && Binary.compare("'MSTSM'")) {
        sOptions = "Stac LZS";
        bDetected = true;
    }

    return result();
}
