// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Microsoft FrontPage ELM theme archive (xxfclib other/elm): a text header
// with the version line, the member count and "name,size" lines.
meta("archive", "FrontPage ELM theme");

function detect() {
    var sHead = Binary.getString(0, 96);
    var aMatch = sHead.match(/^(\d+\.\d+\.\d+\.\d+)\n(\d+)\n[^\n,]+,\d+\n/);
    if (aMatch) {
        sVersion = aMatch[1];
        sOptions = aMatch[2] + " files";
        bDetected = true;
    }

    return result();
}
