// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// InstallShield OBL object library (xxfclib archive/installshield_obl):
// "pOdA", version 1, the member count and a length-prefixed first name.
meta("archive", "InstallShield OBL library");

function detect() {
    if (Binary.compare("'pOdA'01000000")) {
        var nCount = Binary.readDword(8);
        var nName = Binary.readWord(12);
        if (nCount >= 1 && nCount <= 65535 && nName >= 1 && nName <= 255) {
            sOptions = nCount + " objects";
            bDetected = true;
        }
    }

    return result();
}
