// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Apple Hardware Test localisation pack (xxfclib archive/apple_diags): the
// "|_|_" marker, the big-endian decoded size and a checksum before the packed
// text table.
meta("archive", "Apple Hardware Test LOC");

function detect() {
    if (Binary.compare("'|_|_'") && Binary.getSize() > 12) {
        var nDecoded = (Binary.readByte(4) << 24) | (Binary.readByte(5) << 16) | (Binary.readByte(6) << 8) | Binary.readByte(7);
        if (nDecoded > 0 && nDecoded <= 0x10000000) {
            bDetected = true;
        }
    }

    return result();
}
