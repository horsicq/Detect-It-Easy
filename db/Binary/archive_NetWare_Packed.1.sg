// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Novell NetWare packed file (xxfclib archive/netwarepacked): the text
// "Packed File " followed by the original name.
meta("archive", "NetWare packed file");

function detect() {
    if (Binary.compare("'Packed File '")) {
        var c = Binary.readByte(12);
        if (c >= 0x21 && c <= 0x7E) {
            bDetected = true;
        }
    }

    return result();
}
