// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// RDFZ compressed image (xxfclib archive/rdfz): "RDFZ", a word, the "Zlib"
// method tag and the sizes before the zlib stream.
meta("archive", "RDFZ compressed image");

function detect() {
    if (Binary.compare("'RDFZ'") && Binary.compare("'Zlib'", 8)) {
        sOptions = "zlib";
        bDetected = true;
    }

    return result();
}
