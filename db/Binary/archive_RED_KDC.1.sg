// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Knowledge Dynamics RED installer archive (xxfclib installer/red, also the
// .LIF distribution volumes): "RR", format version 1, a header size of
// 39..41, sizes, fragment words and the method 1 (stored) or 11 (-lh5-).
meta("archive", "KDC RED installer archive");

function detect() {
    if (Binary.compare("'RR'01") && Binary.getSize() >= 41) {
        var nHeader = Binary.readByte(3);
        var nMethod = Binary.readWord(24);
        if (nHeader >= 39 && nHeader <= 41 && (nMethod == 1 || nMethod == 11)) {
            sOptions = nMethod == 11 ? "lh5" : "stored";
            bDetected = true;
        }
    }

    return result();
}
