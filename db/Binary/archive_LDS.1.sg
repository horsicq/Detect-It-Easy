// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// LDS compressed stream (xxfclib archive/lds): the native "STOR" header,
// version 1/1, then the stored text.
meta("archive", "LDS STOR stream");

function detect() {
    if (Binary.compare("'STOR'0101")) {
        sVersion = "1.1";
        bDetected = true;
    }

    return result();
}
