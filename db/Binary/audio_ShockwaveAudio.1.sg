// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://preservation.tylerthorsted.com/2023/08/04/shockwave-audio/
meta("audio", "Shockwave Audio");

function detect() {
    if (Binary.compare("'MACRZ'08cd4053", 0x24)) {
        sVersion = File.cleanString(Binary.getString(0x41, 4));
        bDetected = true;
    }

    return result();
}