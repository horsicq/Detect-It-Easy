// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Single-member .CMP install container (xxfclib archive/cmp, Adaptec and
// Cheyenne media): magic 0x007F, header size 0x3D, method 1 or 2, container
// variant 9 or 11 at 0x0E, the LZW block size 0x1000 at 0x37 and the
// original name at 0x28.
meta("archive", "CMP install container");

function detect() {
    if (Binary.getSize() > 0x3D && Binary.readWord(0) == 0x7F && Binary.readWord(2) == 0x3D && Binary.readWord(0x37) == 0x1000) {
        var nMethod = Binary.readWord(4);
        var nVariant = Binary.readWord(0x0E);
        if ((nMethod == 1 || nMethod == 2) && (nVariant == 9 || nVariant == 11)) {
            sVersion = String(nVariant);
            sOptions = nMethod == 1 ? "LZW" : "LZSS/DCL";
            bDetected = true;
        }
    }

    return result();
}
