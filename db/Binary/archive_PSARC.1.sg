// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://www.psdevwiki.com/ps3/PlayStation_archive_(PSARC)
// "PSAR", big-endian major.minor version (1.3, 1.4), the compression tag
// (zlib or lzma), the table-of-contents length, entry size and count.
meta("archive", "PSARC");

function detect() {
    if (Binary.compare("'PSAR'")) {
        var nMajor = (Binary.readByte(4) << 8) | Binary.readByte(5);
        var nMinor = (Binary.readByte(6) << 8) | Binary.readByte(7);
        var sCompression = Binary.getString(8, 4);
        if (nMajor == 1 && nMinor <= 15 && (sCompression == "zlib" || sCompression == "lzma")) {
            sVersion = nMajor + "." + nMinor;
            sOptions = sCompression;
            bDetected = true;
        }
    }

    return result();
}
