// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

meta("compiler", "Watcom C");

function detect() {
    if (LE.compareEP("eb$$fb83e4..8bdc891d........891d........66b8....66a3........bb........2bc0b430cd21a2")) {
        sName = "Watcom C/C++";
        sOptions = "1988-93";
        bDetected = true;
    } else if (LE.compareEP("eb$$fb83e4..89e3891d........891d........66b8....66a3........bb........29c0b430cd21a2")) {
        sName = "Open Watcom C/C++";
        sOptions = "1988-2002";
        bDetected = true;
    } else if (LE.compareEP("eb$$fb83e4..89e3891d........891d........55575666b8....cd21668cc00f00e875..0f00eb75")) {
        sName = "Open Watcom C/C++";
        sOptions = "1988-1995";
        bDetected = true;
    } else {
        var nEP = LE.getEntryPointOffset();
        if (nEP >= 0 && nEP < LE.getSize()) {
            var nScan = Math.min(0x100, LE.getSize() - nEP);
            var nOff = LE.findString(nEP, nScan, "Open Watcom");
            if (nOff !== -1) {
                sName = "Open Watcom C/C++";
                var nYr = LE.findString(nOff, Math.min(128, LE.getSize() - nOff), " 2002-");
                sVersion = (nYr !== -1) ? LE.read_ansiString(nYr + 6, 4) : "2002";
                bDetected = true;
            } else {
                nOff = LE.findString(nEP, nScan, "WATCOM");
                if (nOff !== -1) {
                    sName = "Watcom C/C++";
                    var nYr = LE.findString(nOff, Math.min(128, LE.getSize() - nOff), ". 1988-");
                    sVersion = (nYr !== -1) ? LE.read_ansiString(nYr + 7, 4) : "1988";
                    bDetected = true;
                }
            }
        }
    }

    sLang = "C/C++";

    return result();
}