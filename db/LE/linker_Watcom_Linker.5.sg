// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_le.cpp:73)

meta("linker", "Watcom Linker");

function detect() {
    var nEP = LE.getEntryPointOffset();
    if (nEP >= 0 && nEP < LE.getSize()) {
        var nScan = Math.min(0x100, LE.getSize() - nEP);
        if (LE.findString(nEP, nScan, "Open Watcom") !== -1 || LE.findString(nEP, nScan, "WATCOM") !== -1) {
            bDetected = true;
        }
    }

    return result();
}
