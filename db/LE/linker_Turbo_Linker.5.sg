// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_le.cpp:59)

meta("linker", "Turbo Linker");

function detect() {
    if (LE.readByte(0x1E) === 0xFB) {
        sVersion = (LE.readByte(0x1F) / 16).toFixed(1);
        bDetected = true;
    }

    return result();
}
