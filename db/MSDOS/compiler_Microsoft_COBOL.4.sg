// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_msdos.cpp:338-345,1130-1131)

meta("compiler", "Microsoft COBOL");

function detect() {
    if (MSDOS.compareEP("8CC890BE1C0090EA0000..00........040030240680040004000180000000000000")) {
        sVersion = "1.12";
        bDetected = true;
    } else if (MSDOS.compareEP("E8121851E86C0EE85E00721E0BED7508E8480DE82200EB0B1EE8DC09810E0A0000101F59E81D01E9CF17")) {
        sVersion = "3.00A";
        bDetected = true;
    } else if (MSDOS.compareEP("8CD03D....750E8CC00BC07505E8EF017244EB609006368E060E0026F606490040077503EB4E90065755B8")) {
        sVersion = "4.50";
        bDetected = true;
    } else if (MSDOS.compareEP("8CD03D....750E8CC00BC07505E85502723BEB5790E84D027203EB4F90CB065755B8")) {
        sVersion = "5.00";
        bDetected = true;
    } else if (MSDOS.isDeepScan()) {
        var nLimit = MSDOS.isOverlayPresent() ? MSDOS.getOverlayOffset() : MSDOS.getSize();
        if (MSDOS.findString(0, nLimit, "**COBOL: Attempt to use non-updated runtime module (COBRUN.EXE).") !== -1) {
            sVersion = "1.12";
            bDetected = true;
        } else if (MSDOS.findString(0, nLimit, "Insufficient environment space to run COBOL") !== -1) {
            sVersion = "3.00A";
            bDetected = true;
        }
    }

    sLang = "Cobol";

    return result();
}
