// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_msdos.cpp:1123-1126)

meta("compiler", "Microsoft Pascal");

function detect() {
    if (MSDOS.isDeepScan()) {
        var nLimit = MSDOS.isOverlayPresent() ? MSDOS.getOverlayOffset() : MSDOS.getSize();
        if (MSDOS.findString(0, nLimit, "pasuxm.pas[22,21]") !== -1) {
            sVersion = "1.00";
            bDetected = true;
        } else if (MSDOS.findString(0, nLimit, "conuxm.pas") !== -1) {
            sVersion = "2.00";
            bDetected = true;
        } else if (MSDOS.findString(0, nLimit, "pasuxu.pas") !== -1) {
            sVersion = "3.3X";
            bDetected = true;
        } else if (MSDOS.findString(0, nLimit, "PASFILEA") !== -1) {
            sVersion = "4.00";
            bDetected = true;
        }
    }

    sLang = "Pascal";

    return result();
}
