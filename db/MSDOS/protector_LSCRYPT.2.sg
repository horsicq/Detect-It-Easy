// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_msdos.cpp:159)

meta("protector", "LSCRYPT");

function detect() {
    if (MSDOS.compare("'MZ'....................................................'L.S.    Crypt By'")) {
        sVersion = "1.21";
        bDetected = true;
    }

    return result();
}
