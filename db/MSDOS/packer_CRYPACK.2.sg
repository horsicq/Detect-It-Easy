meta("packer", "CRYPACK");

function detect() {
    if (MSDOS.compareEP("EB..061E8CD805....8ED833DB0E0733FFBE....8A0726....32C48807473BFE")) {
        sVersion = "3.0";
        bDetected = true;
    } else if (MSDOS.compareEP("EB499000000000'CRYPACK v3.0 [Unpacker + lamer protection] by GEORGE STARK/YAKUZA'")) {
        sVersion = "3.0";
        bDetected = true;
    }

    return result();
}