// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_msdos.cpp:1134)

meta("compiler", "Digital Research PL/I-86");

function detect() {
    if (MSDOS.isDeepScan()) {
        var nLimit = MSDOS.isOverlayPresent() ? MSDOS.getOverlayOffset() : MSDOS.getSize();
        if (MSDOS.findString(0, nLimit, "FREE Request Out-of-Range$") !== -1) {
            bDetected = true;
        }
    }

    sLang = "PL/I";

    return result();
}
