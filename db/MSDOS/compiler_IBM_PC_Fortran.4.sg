// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_msdos.cpp:370,1243)

meta("compiler", "IBM PC Fortran");

function detect() {
    if (MSDOS.compareEP("BA....D1EAB900802BCAD1EAD1EAD1EA42268B1E020081EB....2BDAF7DB7D0233DB2BD3B8....8ED8")) {
        sVersion = "1.00";
        bDetected = true;
    } else if (MSDOS.isDeepScan()) {
        var nLimit = MSDOS.isOverlayPresent() ? MSDOS.getOverlayOffset() : MSDOS.getSize();
        if (MSDOS.findString(0, nLimit, "1270000000          (C)Copyright IBM Corp") !== -1) {
            sVersion = "2.00(1984)";
            bDetected = true;
        }
    }

    sLang = "Fortran";

    return result();
}
