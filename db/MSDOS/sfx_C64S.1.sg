// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// C64S self-extracting distribution (C64S emulator disk/tape sets, U3 format
// 721): an MZ stub (usually LZEXE-packed) with the marker 59 19 31 64 at
// 0x1C followed by the default target path "C:\C64S"; the records (stored
// or LSB-first LZW) follow the stub.
meta("sfx", "C64S self-extractor");

function detect() {
    if (MSDOS.compare("59193164", 0x1C) && MSDOS.findString(0x20, 0x20, "C:\\C64S") != -1) {
        bDetected = true;
    }

    return result();
}
