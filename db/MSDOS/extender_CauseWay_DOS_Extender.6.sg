// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

meta("extender", "CauseWay DOS Extender");

function detect() {
    if (MSDOS.compareEP("fa161f26a1....83e8..8ed0fb061607be....8bfeb9....f3a407368c......8bd88cca3603......368b......fd8bc53d....76")) {
        sVersion = "3.1X-3.4X";
        bDetected = true;
    } else if (MSDOS.compareEP("eb$$8be88cc60e1f8cc005....0106....b8....cd213c..73..b8....cd21803e......74..8cc005....0306....268b16....3bc273..8ec0a1....33ff")) {
        sVersion = "2.64, 3.25";
        bDetected = true;
    } else if (MSDOS.compareEP("EB6B574152505752415031C5030000000000000000C5030100C5030000D303000000..0BD3030000000000B43FCD21591FE32E068CC00510008EC08BE833D203C95183F9407603B94000B43FCD218BF2D1E9AD8BF826012DE2F85983E94077E107B43ECD21061F58A32C0058CB8BE88CC60E1F8CC005100001061100B800")) {
        sVersion = "2.64-3.25";
        bDetected = true;
    }

    if (bDetected && MSDOS.isDeepScan()) {
        var nVerOff = MSDOS.findString(0, MSDOS.getSize(), "CauseWay DOS Extender v");
        if (nVerOff !== -1) {
            var sVerStr = MSDOS.read_ansiString(nVerOff + 23, 32);
            var aParts = sVerStr.split(" ");
            if (aParts[0]) {
                sVersion = aParts[0];
            }
        }
    }

    return result();
}