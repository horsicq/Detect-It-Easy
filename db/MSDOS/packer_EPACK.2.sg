// Detect It Easy: EPACK 1.6 DOS disk-decoder/EXEC wrapper.
// The Pascal entry alone is insufficient: require its temporary-file names,
// actual transfer routine, EXEC finalizer and retained compressed overlay.
meta("packer", "EPACK");

function detect() {
    var overlay = MSDOS.getOverlayOffset(),
        limit = Math.min(overlay, 0x10000);
    if (overlay > 0 && overlay < MSDOS.getSize() &&
        MSDOS.compareEP("9a0000....5589e531c09a7c02....b8....509a0902....9a3002....9a5b02....5d31c09ae900....") &&
        MSDOS.isSignaturePresent(0, limit, "0874656d702e6578655589e5") &&
        MSDOS.isSignaturePresent(0, limit, "0854454d502e45584555") &&
        MSDOS.isSignaturePresent(0, limit, "cd21591f721f33d226f77504c47e068cc20bd7") &&
        MSDOS.isSignaturePresent(0, limit, "b8004bcd21720233c0ba....8edafa8b26....8e16....fba3....5dca0800")) {
        sVersion = "1.6";
        bDetected = true;
    }
    return result();
}
