meta("packer", "ExeLITE");

function detect() {
    var limit = Math.min(MSDOS.getSize(), 0x100000);
    if (MSDOS.compare("454c49544500", 26) &&
        MSDOS.compareEP("fc8cc80106....ba....03c28bd805....8edb8ec033ff33f6b90800f3a5484b4a75ee0e53508cc82d10008ed89090e9....") &&
        MSDOS.isSignaturePresent(0, limit, "454c49544520762e20322e303053") &&
        ((MSDOS.isSignaturePresent(0, limit, "5d33d28cd856c1ee0403c68ed85e83e60f8cc00bff780683c71048ebf68ec081ef....57c1ef0403c78ec05f83e70fb9....e32d") &&
          MSDOS.isSignaturePresent(0, limit, "b8....03c58ed0bc....b8....03c55068....83ed108edd8ec533c033db33d233ed33f633ffcb")) ||
         MSDOS.isSignaturePresent(0, limit, "5db8....03c58ed0bc....b8....03c55068....83ed108edd8ec533c033db33c933d233ed33f633ffcb"))) {
        sVersion = "2.00S";
        bDetected = true;
    } else if (MSDOS.compareEP("fc8cc80106....ba....03c28bd805....8edb8ec033ff33f6b9....f3a5484b4a75..8ec38ed8be")) {
        sVersion = "1.00";
        bDetected = true;
    } else if (MSDOS.compareEP("b8....bb....0e5a03c20e5053cb")) {
        bDetected = true;
    }

    return result();
}