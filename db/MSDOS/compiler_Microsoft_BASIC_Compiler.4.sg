// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_msdos.cpp:337,1284-1295)

meta("compiler", "Microsoft BASIC Compiler");

function detect() {
    if (MSDOS.compareEP("9A0000..00558BEC81EC00009A..00..00C706..0C")) {
        sVersion = "5.3x";
        sOptions = "BASRUN";
        bDetected = true;
    } else if (MSDOS.isDeepScan()) {
        var nLimit = MSDOS.isOverlayPresent() ? MSDOS.getOverlayOffset() : MSDOS.getSize();
        if (MSDOS.findString(0, nLimit, "Cannot find A:BASRUN.EXE") !== -1) {
            sVersion = "5.3X";
            sOptions = "BASRUN";
            bDetected = true;
        }
    }

    sLang = "Basic";

    return result();
}
