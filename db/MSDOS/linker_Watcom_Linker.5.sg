// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_msdos.cpp:797)

meta("linker", "Watcom Linker");

function detect() {
    var nEP = MSDOS.getEntryPointOffset();
    if (nEP >= 0 && nEP < MSDOS.getSize()) {
        var nScan = Math.min(0x300, MSDOS.getSize() - nEP);
        if (MSDOS.findString(nEP, nScan, "Open Watcom") !== -1 || MSDOS.findString(nEP, nScan, "WATCOM") !== -1) {
            bDetected = true;
        }
    }

    return result();
}
