// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_msdos.cpp:194)

meta("packer", "JMCE");

function detect() {
    if (MSDOS.compare("4D5A......0000000200....FFFF....FC0145780001....00000000656E6372")) {
        sVersion = "0.7r";
        bDetected = true;
    }

    return result();
}
