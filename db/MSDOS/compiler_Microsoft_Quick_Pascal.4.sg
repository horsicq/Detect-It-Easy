// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

meta("compiler", "Microsoft QuickPascal");

function detect() {
    if (MSDOS.compareEP("b0..9a########50b430cd213c..73..cd20b8....8ed88c06....c706........8c0e....58545b3bdc74..0ac074..be....e8....32c0e9")) {
        sVersion = "1.0-1.08";
        sOptions = "1989";
        bDetected = true;
    } else if (MSDOS.isDeepScan()) {
        var nLimit = MSDOS.isOverlayPresent() ? MSDOS.getOverlayOffset() : MSDOS.getSize();
        if (MSDOS.findSignature(0, nLimit, "'Runtime error '00' at '000D0A00'80x87 required'0D0A00'80286 or 80386 required'0D0A00") !== -1) {
            sVersion = "1.0";
            bDetected = true;
        }
    }

    sLang = "Pascal";

    return result();
}