// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_msdos.cpp:355,1136)

meta("compiler", "Artek Ada");

function detect() {
    if (MSDOS.compareEP("B8....BE....9A000100009A0000....9A0000....9A0000....0EE80500EA7D010000")) {
        sVersion = "1.25";
        bDetected = true;
    } else if (MSDOS.isDeepScan()) {
        var nLimit = MSDOS.isOverlayPresent() ? MSDOS.getOverlayOffset() : MSDOS.getSize();
        if (MSDOS.findString(0, nLimit, "Artek Ada Runtime Module (C) ") !== -1) {
            sVersion = "1.25";
            bDetected = true;
        }
    }

    sLang = "Ada";

    return result();
}
