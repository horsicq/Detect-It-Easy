meta("protector", "EXEGUARD");

function detect() {
    if (MSDOS.compareEP("BA....BF....EB$$E8$$$$53BB....EB$$EB$$5B0E075051535653BB....EB")) {
        sVersion = "1.3";
        bDetected = true;
    } else if (MSDOS.compareEP("BA9802BFB900EB01B8E87FFF7C29792FFAEA1DF59E4176E5D8FD5DDD00881C25")) {
        sVersion = "1.3";
        bDetected = true;
    }

    return result();
}