// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

meta("protector", "Aluwain");

function detect() {
    if (MSDOS.compareEP("8BEC1EE8....9D5E")) {
        sVersion = "8.09";
        bDetected = true;
    } else if (MSDOS.compare("4D5A......0000000200....FFFF........FFFF........'aLuWaIn!'")) {
        sVersion = "8.09";
        bDetected = true;
    }

    return result();
}