// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_msdos.cpp:1135)

meta("compiler", "Oberon-M");

function detect() {
    if (MSDOS.isDeepScan()) {
        var nLimit = MSDOS.isOverlayPresent() ? MSDOS.getOverlayOffset() : MSDOS.getSize();
        if (MSDOS.findString(0, nLimit, "$typeguard check failed") !== -1) {
            sVersion = "1.2";
            bDetected = true;
        }
    }

    sLang = "Oberon";

    return result();
}
