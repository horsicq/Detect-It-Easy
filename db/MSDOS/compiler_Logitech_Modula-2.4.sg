// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

meta("compiler", "Logitech Modula-2");

function detect() {
    if (MSDOS.compareEP("8cdb83c3..8cc88ec0bf....33c0268a05473c..74..3c..74..03f08b0c03cb890ceb..26c5358cd903cb8ed983c7..eb..b8....03c350b8....5033c0")) {
        sVersion = "3.00";
        sOptions = "Aug 1987";
        bDetected = true;
    } else if (MSDOS.compareEP("EB$$B8....8ED8C706....00008C06....8CC7BB....26891E02002BDF891E....B44ACD21BD0000")) {
        sVersion = "3.4";
        bDetected = true;
    } else if (MSDOS.isDeepScan()) {
        var nLimit = MSDOS.isOverlayPresent() ? MSDOS.getOverlayOffset() : MSDOS.getSize();
        if (MSDOS.findString(0, nLimit, "$stack overflow$heap overflow$function return error$") !== -1) {
            sVersion = "3.X";
            bDetected = true;
        }
    }

    sLang = "Modula-2";

    return result();
}