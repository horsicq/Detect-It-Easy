// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

meta("compiler", "Microsoft Fortran");

function detect() {
    if (MSDOS.compareEP("b430cd213c..73..9a########558becb8....501eb8....50b8....509a")) {
        sVersion = "1987";
        bDetected = true;
    } else if (MSDOS.isDeepScan()) {
        var nLimit = MSDOS.isOverlayPresent() ? MSDOS.getOverlayOffset() : MSDOS.getSize();
        if (MSDOS.findString(0, nLimit, "foruxm.pas") !== -1) {
            sVersion = "3.1X-3.2X";
            bDetected = true;
        } else if (MSDOS.findString(0, nLimit, "foruxu.pas") !== -1) {
            sVersion = "3.3X";
            bDetected = true;
        } else if (MSDOS.findString(0, nLimit, ": INQUIRE(") !== -1) {
            if (MSDOS.findString(0, nLimit, "MS Run-Time Library - Copyright (c) 1990, Microsoft Corp") !== -1) {
                sVersion = "5.1";
            } else if (MSDOS.findString(0, nLimit, "MS Run-Time Library - Copyright (c) 1989, Microsoft Corp") !== -1) {
                sVersion = "5.0";
            } else if (MSDOS.findString(0, nLimit, "MS Run-Time Library - Copyright (c) 1987, Microsoft Corp") !== -1) {
                sVersion = "4.0-4.1";
            }
            bDetected = true;
        }
    }

    sLang = "Fortran";

    return result();
}