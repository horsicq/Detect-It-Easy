// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

meta("sfx", "PKSFX");

function detect() {
    if (MSDOS.compareEP("b430cd213c..73..cd20bf....8b36....2bf776..8bc405....d1d8b1..d3e83bf0")) {
        if (MSDOS.compareOverlay("1a")) {
            sOptions = "ARC";
            bDetected = true;
        }
    } else if (MSDOS.compare("4D5A........................................................436F7079726967687420313938392D3139393020504B5741524520496E632E")) {
        sVersion = "1.1";
        bDetected = true;
    }

    return result();
}