        sVersion = "1.x";
        bDetected = true;
    } else if (MSDOS.compareEP("8CC88ED88CC381C31000891E10008BC3030606008EC08B0E02008BF14E8BFEFDF3A450B83A0050CB8B3604008CD82D0010730AF7D8B104D3E02BF033C08ED88C")) {
