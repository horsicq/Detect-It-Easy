// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_msdos.cpp:361)

meta("compiler", "Intel iC-86");

function detect() {
    if (MSDOS.compareEP("902E8E1E..00EA0000000000000000000000000000000000")) {
        sVersion = "4.5";
        bDetected = true;
    }

    sLang = "C";

    return result();
}
