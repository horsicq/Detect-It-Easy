// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

meta("compiler", "Digital Research C");

function detect() {
    if (MSDOS.compareEP("eb$$0e17bc....a1....8cdb0e1f891e....a3....8cc80306....a3....b9....2bdb8bf3bf....8cc803050306")) {
        sVersion = "1.1";
        sOptions = "1983";
        bDetected = true;
    } else if (MSDOS.isDeepScan()) {
        var nLimit = MSDOS.isOverlayPresent() ? MSDOS.getOverlayOffset() : MSDOS.getSize();
        if (MSDOS.findString(0, nLimit, "V1.1 CLEAR library.  Copyright 1983 by Digital Research.") !== -1) {
            sVersion = "1.1";
            sOptions = "1983";
            bDetected = true;
        }
    }

    sLang = "C";

    return result();
}