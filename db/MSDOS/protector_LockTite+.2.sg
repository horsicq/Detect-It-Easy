meta("protector", "LockTite+");

function detect() {
    if (MSDOS.compareEP("8cc88ed88cc381c3....8bc30306....8ec08b0e....8bf14e8bfefdf3a450b8....50cb") &&
        !MSDOS.compareEP("8CC88ED88CC381C310008BC3030606008EC08B0E02008BF14E8BFEFDF3A450B8340050CB8B3604008CD82D00108ED88CC02D00108EC0BFFFFFFD8A144E4E8B0C")) {
        bDetected = true;
    }

    return result();
}