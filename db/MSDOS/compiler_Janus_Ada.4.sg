// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_msdos.cpp:357)

meta("compiler", "Janus Ada");

function detect() {
    if (MSDOS.compareEP("E95300....2600..000010'Copyright 1982,83,84,85 - RR Software, Inc.'")) {
        sVersion = "1.5X";
        bDetected = true;
    }

    sLang = "Ada";

    return result();
}
