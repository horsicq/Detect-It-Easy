// Detect It Easy: detection rule file

// Automation packer v5.01: the packed data starts with "LSD!", followed by
// the packed and unpacked sizes (big-endian).
meta("packer", "Automation");

function detect() {
    var nSize = GEMDOS.getSize();
    var nOffset = GEMDOS.findString(0x1C, Math.min(nSize - 0x1C, 0x1000), "LSD!");

    if (nOffset != -1) {
        var nPacked = GEMDOS.read_uint32(nOffset + 4, true);
        var nUnpacked = GEMDOS.read_uint32(nOffset + 8, true);

        if ((nPacked > 0) && (nPacked <= nSize) && (nUnpacked >= nPacked) && (nUnpacked < 0x1000000)) {
            sVersion = "5.01";
            bDetected = true;
        }
    }

    return result();
}
