// Detect It Easy: detection rule file

// UPX packs Atari ST TOS programs (target atari/tos); the packed
// program keeps the "UPX!" block header.
meta("packer", "UPX");

function detect() {
    var nSize = GEMDOS.getSize();
    var nOffset = GEMDOS.findString(0x1C, Math.min(nSize - 0x1C, 0x2000), "UPX!");

    if (nOffset != -1) {
        var nVersion = GEMDOS.read_uint8(nOffset + 4);
        if (nVersion) {
            sOptions = "v" + nVersion;
        }
        bDetected = true;
    }

    return result();
}
