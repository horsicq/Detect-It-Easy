// Detect It Easy: detection rule file

// Speedpacker 3 (The Firehawks): the packed data starts with "SPv3".
meta("packer", "Speedpacker");

function detect() {
    var nSize = GEMDOS.getSize();

    if (GEMDOS.findString(0x1C, Math.min(nSize - 0x1C, 0x1000), "SPv3") != -1) {
        sVersion = "3";
        bDetected = true;
    }

    return result();
}
