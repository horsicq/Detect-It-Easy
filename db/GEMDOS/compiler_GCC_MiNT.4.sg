// Detect It Easy: detection rule file

// GCC / binutils for m68k-atari-mint: the extended MiNT header follows the
// GEMDOS header (a jump over it, then the "MiNT" magic).
meta("compiler", "GCC");

function detect() {
    if (GEMDOS.compare("283A001A4EFB48FA'MiNT'", 0x1C)) {
        sOptions = "MiNT";
        bDetected = true;
    }

    return result();
}
