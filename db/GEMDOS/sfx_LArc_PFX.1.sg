// Detect It Easy: detection rule file

// LArc "PFX" self-extracting program: the TEXT segment ends in DE AD FA CE
// and the DATA segment is one "-lz5-" LArc member.
meta("sfx", "LArc PFX");

function detect() {
    var nTextSize = GEMDOS.read_uint32(2, true);
    var nTextEnd = 0x1C + nTextSize;

    if ((nTextSize >= 4) && (nTextEnd + 7 <= GEMDOS.getSize())) {
        if (GEMDOS.compare("DEADFACE", nTextEnd - 4) && GEMDOS.compare("'-lz5-'", nTextEnd + 2)) {
            bDetected = true;
        }
    }

    return result();
}
