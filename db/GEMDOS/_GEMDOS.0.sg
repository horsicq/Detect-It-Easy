// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

meta("operation system", "Atari ST");

function detect() {
    if (GEMDOS.isVerbose()) {
        sName = GEMDOS.getOperationSystemName();
        sVersion = GEMDOS.getOperationSystemVersion();
        sOptions = GEMDOS.getOperationSystemOptions();

        bDetected = true;
    }

    return result();
}