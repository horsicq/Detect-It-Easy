function getPythonVersionByDll(dllFileName) {
    var pythonVersion = String();

    var startIndex = dllFileName.indexOf("python");
    if (startIndex !== -1) {
        startIndex += 6;
        var endIndex = dllFileName.indexOf(".", startIndex);
        if (endIndex === -1) {
            endIndex = dllFileName.length;
        }
        pythonVersion = dllFileName.substring(startIndex, endIndex);
    }

    if (pythonVersion) {
        if (pythonVersion.length === 1) {
            return pythonVersion + ".0";
        } else if (pythonVersion.length === 2) {
            return pythonVersion[0] + "." + pythonVersion[1];
        } else {
            return pythonVersion[0] + "." + pythonVersion.substring(1);
        }
    } else {
        return null;
    }
}