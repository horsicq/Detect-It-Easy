// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// InstallShield 3 16-bit self-extracting setup (xxfclib installer/installshield_3):
// the NE stub carries a "MYRESOURCE" resource holding the payload descriptor,
// either the version 4 form (size 0x110, version 4: 10 01 00 00 04 00 00 00) or
// the version 6 form (size 0x194, version 6: 94 01 00 00 06 00 00 00); the
// descriptor names the overlay offset and the record count.
meta("installer", "InstallShield");

function detect() {
    var nLimit = NE.getSize() < 0x20000 ? NE.getSize() : 0x20000;
    if (NE.findSignature(0, nLimit, "'MYRESOURCE'") != -1) {
        if (NE.findSignature(0, nLimit, "1001000004000000") != -1) {
            sVersion = "3.x";
            sOptions = "16-bit SFX, descriptor 4";
            bDetected = true;
        } else if (NE.findSignature(0, nLimit, "9401000006000000") != -1) {
            sVersion = "3.x";
            sOptions = "16-bit SFX, descriptor 6";
            bDetected = true;
        }
    }

    return result();
}
