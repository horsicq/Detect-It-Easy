// Detect It Easy: detection rule file
// Author: Tuxy0 <tuxy0@tuxy0.net>

// https://www.processlibrary.com/de/directory/files/bids402/309692/
meta("library", "Borland BIDS Class Library");

function detect() {
    if (Binary.readWord(0) == 0x5A4D) {
        var nNewHeaderOffset = Binary.readDword(0x3C);

        if (Binary.readWord(nNewHeaderOffset) == 0x454E) {
            var nImportedNamesTableOffset = nNewHeaderOffset + Binary.readWord(nNewHeaderOffset + 0x2A);

            if (Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'bids402'") || Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'BIDS402'")) {
                sVersion = "4.0.2";
                bDetected = true;
            
            } else if (Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'bids40'") || Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'BIDS40'")) {
                sVersion = "4.0";
                bDetected = true;
            
            } else if (Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'bids45'") || Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'BIDS45'")) {
                sVersion = "4.5";
                bDetected = true;
            }
        }
    }

    return result();
}