// Detect It Easy: detection rule file
// Author: Tuxy0 <tuxy0@tuxy0.net>

// https://www.processlibrary.com/en/directory/files/owl52t/414358/
meta("library", "Borland Object Windows");

function detect()
{
	if (Binary.readWord(0) == 0x5A4D)
	{
		var nNewHeaderOffset = Binary.readDword(0x3C);

		if (Binary.readWord(nNewHeaderOffset) == 0x454E)
		{
			var nImportedNamesTableOffset = nNewHeaderOffset + Binary.readWord(nNewHeaderOffset + 0x2A);

			if (Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'Owl200'") || Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'OWL200'") || Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'owl200'"))
			{
				sVersion = "2.0";
				bDetected = true;
			}
			else if (Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'Owl250'") || Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'OWL250'") || Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'owl250'"))
			{
				sVersion = "2.5";
				bDetected = true;
			}
		}
	}

	return result();
}