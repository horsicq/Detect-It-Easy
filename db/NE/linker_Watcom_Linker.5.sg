// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_ne.cpp:152)

meta("linker", "Watcom Linker");

function detect() {
    var nEP = NE.getEntryPointOffset();
    if (nEP >= 0 && nEP < NE.getSize()) {
        var nScan = Math.min(0x100, NE.getSize() - nEP);
        if (NE.findString(nEP, nScan, "Open Watcom") !== -1 || NE.findString(nEP, nScan, "WATCOM") !== -1) {
            bDetected = true;
        }
    }

    return result();
}
