// Detect It Easy: detection rule file
// Author: Tuxy0 <tuxy0@tuxy0.net>

meta("Library", "Borland BIDS Class Library");

function detect()
{
	if (Binary.readWord(0) == 0x5A4D)
	{
		var nNewHeaderOffset = Binary.readDword(0x3C);

		if (Binary.readWord(nNewHeaderOffset) == 0x454E)
		{
			var nImportedNamesTableOffset = nNewHeaderOffset + Binary.readWord(nNewHeaderOffset + 0x28);

			if (Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'bids40'") || Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'BIDS40'"))
			{
				bDetected = true;
				sVersion = "4.0";
				sOptions = "16-bit";
			}
			else if (Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'bids402'") || Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'BIDS402'"))
			{
				bDetected = true;
				sVersion = "4.0.2";
				sOptions = "16-bit";
			}
			else if (Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'bids45'") || Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'BIDS45'"))
			{
				bDetected = true;
				sVersion = "4.5";
				sOptions = "16-bit";
			}
		}
	}

	return result();
}