// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_ne.cpp:137)

meta("linker", "Turbo Linker");

function detect() {
    if (NE.readByte(0x1E) === 0xFB) {
        sVersion = (NE.readByte(0x1F) / 16).toFixed(1);
        bDetected = true;
    }

    return result();
}
