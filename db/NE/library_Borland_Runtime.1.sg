// Detect It Easy: detection rule file
// Author: Tuxy0 <tuxy0@tuxy0.net>

// https://groups.google.com/g/comp.os.ms-windows.programmer.misc/c/ZHvNC_NIQrc
meta("library", "Borland Runtime");

function detect()
{
    if (Binary.readWord(0) == 0x5A4D)
    {
        var nNewHeaderOffset = Binary.readDword(0x3C);

        if (Binary.readWord(nNewHeaderOffset) == 0x454E)
        {
            var nImportedNamesTableOffset = nNewHeaderOffset + Binary.readWord(nNewHeaderOffset + 0x2A);

            if (Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'BC40RTL'")) || Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'bc40rtl'"))
            {
                sVersion = "4.0";
                bDetected = true;
            }
            else if (Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'BC450RTL'") || Binary.isSignaturePresent(nImportedNamesTableOffset, 512, "'bc450rtl'"))
            {
                sVersion = "4.5";
                bDetected = true;
            }
        }
    }

    return result();
}