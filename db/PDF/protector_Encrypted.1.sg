// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pdf.cpp:50-58)

meta("protector", "Unknown");

function detect() {
    if (PDF.isEncrypted()) {
        var sEnc = PDF.getEncryption();
        if (sEnc) {
            sVersion = sEnc;
        }
        sOptions = "Encrypted";
        bDetected = true;
    }

    return result();
}
