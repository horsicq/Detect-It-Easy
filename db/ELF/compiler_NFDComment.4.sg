// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_elf.cpp:57-554, 685-869; nfd_binary.cpp:1474-1960)

// Compilers named in the .comment section (GCC and Rust have their own rules).
meta("compiler", "NFD .comment");

function detect() {
    var aKeys = ["AppleLLVM", "AndroidClang", "AlipayClang", "AlpineClang", "AlibabaClang", "PlexClang", "UbuntuClang", "DebianClang",
        "ApportableClang", "ARMAssembler", "ARMC", "ARMCCPP", "ARMNEONCCPP", "ARMThumbCCPP", "ThumbC", "ARMThumbMacroAssembler", "clang",
        "DynASM", "Delphi", "SnapdragonLLVMARM", "NASM"];

    // Languages as NFD derives them from these compilers (nfd_binary.cpp getLanguage).
    var oLanguages = {
        AppleLLVM: "C/C++", AndroidClang: "C/C++", AlipayClang: "C/C++", AlpineClang: "C/C++", AlibabaClang: "C/C++", PlexClang: "C/C++",
        UbuntuClang: "C/C++", DebianClang: "C/C++", ApportableClang: "C/C++", clang: "C/C++",
        ARMC: "C", ThumbC: "C", ARMCCPP: "C/C++", ARMNEONCCPP: "C/C++", ARMThumbCCPP: "C/C++",
        ARMAssembler: "Assembler", ARMThumbMacroAssembler: "Assembler", DynASM: "Assembler",
        Delphi: "Object Pascal (Delphi)", NASM: "ASMx" + (APKiD_isElf64() ? "64" : "86")
    };

    ELF_NFD_emitCommentDetects(aKeys, function (sKey) {
        return oLanguages[sKey];
    });

    return result();
}
