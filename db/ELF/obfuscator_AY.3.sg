// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/obfuscators.yara#ay

// https://github.com/adamyaxley/Obfuscate
meta("obfuscator", "AY");

function detect() {
    // /\_ZN2ay\d\dobfuscated_dataILy(.*)decryptEv/
    if (APKiD_re("_ZN2ay", [0], /^_ZN2ay\d\dobfuscated_dataILy[^\n]*decryptEv/)) {
        bDetected = true;
    }

    return result();
}
