// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#appcamo

// http://appcamo.com/s2/s2_1.php
meta("protector", "AppCamo");

function detect() {
    var nCount = 0;
    if (APKiD_hex("00 6170 7063 616d 6f 00")) nCount++;                     // \0appcamo\0
    if (APKiD_hex("00 6c69 6261 6c69 622e 736f 00")) nCount++;              // \0libalib.so\0
    if (nCount && APKiD_hex("00 6461 6c76 696b 2f73 7973 7465 6d2f 4465 7843 6c61 7373 4c6f 6164 6572 00")) nCount++; // \0dalvik/system/DexClassLoader\0

    if (nCount >= 2) {
        bDetected = true;
    }

    return result();
}
