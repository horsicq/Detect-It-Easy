// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#easyprotector

// https://github.com/lamster2018/EasyProtector
meta("protector", "EasyProtector");

function detect() {
    if (APKiD_hex("00 6c 69 62 61 6e 74 69 74 72 61 63 65 2e 73 6f 00") &&                                         // \0libantitrace.so\0
        APKiD_hex("00 70 74 72 61 63 65 20 6d 79 73 65 6c 66 2e 2e 2e 00") &&                                      // \0ptrace myself...\0
        APKiD_hex("00" + APKiD_textToHex("I was be traced...trace pid:%d") + "00")) {
        bDetected = true;
    }

    return result();
}
