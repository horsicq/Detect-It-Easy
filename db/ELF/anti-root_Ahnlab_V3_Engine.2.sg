// https://www.ahnlab.com/en
meta("anti-root", "Ahnlab V3 Engine");

function detect() {
    if (ELF.isHeuristicScan() && APKiD_str("engmgr_startRootCheck")) {
        bDetected = true;
    }

    return result();
}
