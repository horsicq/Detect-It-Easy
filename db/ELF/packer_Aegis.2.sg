// https://androidrepublic.org
meta("packer", "Aegis");

function detect() {
    var nCount = 0;
    if (APKiD_hex("00 6c69 6261 6567 6973 5f65 2e73 6f00")) nCount++;                // \0libaegis_e.so\0
    if (APKiD_hex("00 6c69 6261 6567 6973 5f65 5f61 726d 3634 2e73 6f00")) nCount++;  // \0libaegis_e_arm64.so\0
    if (APKiD_hex("00 6c69 6261 6567 6973 5f65 5f78 3836 2e73 6f00")) nCount++;       // \0libaegis_e_x86.so\0
    if (nCount && nCount < 2 && APKiD_str("https://www.androidrepublic.org")) nCount++;

    if (nCount >= 2) {
        bDetected = true;
    }

    return result();
}
