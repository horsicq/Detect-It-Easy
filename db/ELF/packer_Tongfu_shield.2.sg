// https://www.tongfudun.com
meta("packer", "Tongfu shield");

function detect() {
    if (APKiD_hex("00 6c69 6265 6769 732e 736f 00") ||                                           // \0libegis.so\0
        APKiD_hex("6173 7365 7473 2f6c 6962 6567 6973 2e61 00") ||                                // assets/libegis.a\0
        APKiD_hex("00 636f 6d2f 7061 7965 6769 732f 4669 7273 7441 7070 6c69 6361 7469 6f6e 00")) { // \0com/payegis/FirstApplication\0
        bDetected = true;
    }

    return result();
}
