// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/packers.yara#tso_trusteer_sdk

// https://www.ibm.com/products/trusteer-mobile-sdk
meta("packer", "Trusteer SDK (TSO)");

function detect() {
    // for any segment PT_LOAD and for 2 sections matching the name regex
    if (APKiD_countSectionNames(/(\.tsotext|\.tsodata|\.gnu\.version_x|\.gnu\.version_y)/) >= 2 && APKiD_isSegmentTypePresent(1)) {
        sOptions = "to be verified!";
        bDetected = true;
    }

    return result();
}
