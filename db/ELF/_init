    var aParts = sString.split(sSep),
        nCount = aParts.length;

    if (nEnd === undefined) nEnd = -1;
    if (nStart < 0) nStart += nCount;
    if (nEnd < 0) nEnd += nCount;

    if ((nStart >= nCount) || (nEnd < 0) || (nStart > nEnd)) {
        return "";
    }

    return aParts.slice(Math.max(0, nStart), nEnd + 1).join(sSep);
}

function ELF_NFD_has(sString, sPart) {
    return sString.indexOf(sPart) != -1;
}

