    if (nSection != -1) {
        var nOffset = ELF.getSectionFileOffset(nSection),
            nSize = Math.min(ELF.getSectionFileSize(nSection), 0x100000, Math.max(0, ELF.getSize() - nOffset)),
            sCurrent = "";

        for (var nPos = 0; nPos < nSize; nPos += 0x10000) {
            var aBytes = ELF.readBytes(nOffset + nPos, Math.min(0x10000, nSize - nPos));

            for (var i = 0; i < aBytes.length; i++) {
