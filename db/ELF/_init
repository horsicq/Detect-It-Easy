    if (APKiD_cache[sKey] !== undefined) {
        return APKiD_cache[sKey];
    }
    var oResult;
    var nPhnum = APKiD_elfHeader("phnum");
    if (nIndex >= 0 && nIndex < nPhnum) {
        var bBE = APKiD_isBigEndian();
        var b64 = APKiD_isElf64();
        var nHeader = APKiD_elfHeader("phoff") + nIndex * APKiD_elfHeader("phentsize");
        if (nHeader + (b64 ? 56 : 32) <= File.getSize()) {
            oResult = {
                type: ELF.read_uint32(nHeader, bBE),
                flags: ELF.read_uint32(nHeader + (b64 ? 4 : 24), bBE),
                offset: b64 ? ELF.read_uint64(nHeader + 8, bBE) : ELF.read_uint32(nHeader + 4, bBE)
            };
        }
    }
    APKiD_cache[sKey] = oResult;
    return oResult;
}

