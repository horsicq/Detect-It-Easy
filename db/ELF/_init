// Detect It Easy: DiE-JS framework file
// Don't change anything unless you're sure about what you're doing

var File = ELF;
var X = ELF;


var ELF_getSize = ELF.getSize,
    ELF_fileSize = ELF_getSize();

/**
 * Get the cached file size.
 * @returns {Number}
 */
