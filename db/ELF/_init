/**
 * GCC version from one "GCC:" comment string (NFD_Binary::_get_GCC_string).
 * @returns {String}
 */
function ELF_NFD_getGCCVersion(sString) {
    var S = ELF_NFD_section,
        H = ELF_NFD_has;

    if (H(sString, "(experimental)") || H(sString, "(prerelease)")) return S(sString, " ", -3, -1);
    if (H(sString, "(GNU) c ")) return S(sString, "(GNU) c ", 1, -1);
    if (H(sString, "GNU")) return S(sString, " ", 2, -1);
    if (H(sString, "Rev1, Built by MSYS2 project")) return S(sString, " ", -2, -1);
    if (H(sString, "(Ubuntu ")) return S(S(sString, ") ", 1, 1), " ", 0, 0);
    if (H(sString, "StartOS)")) return S(S(sString, ")", 1, 1), " ", 0, 0);
    if (H(sString, "GCC: (c) ")) return S(sString, "GCC: (c) ", 1, 1);

    return S(sString, " ", -1, -1);
}

/**
 * Emit the comment detections of the given keys in this order (NFD handle_Tools/handle_Protection order).
 * fnLang(oRecord) may return a language for _setLang.
 */
function ELF_NFD_emitCommentDetects(aKeys, fnLang) {
    var oDetects = ELF_NFD_getCommentDetects();

    for (var i = 0; i < aKeys.length; i++) {
        var oRecord = oDetects[aKeys[i]];

        if (oRecord) {
            _setResult(oRecord.type, oRecord.name, oRecord.version, oRecord.info);

            if (fnLang) {
                var sLanguage = fnLang(aKeys[i]);

                if (sLanguage) {
                    _setLang(sLanguage);
                }
            }
        }
    }
}

/**
 * ELF notes like XELF::getNotes: PT_NOTE segments, or SHT_NOTE sections when the segments hold none.
 * @returns {Object[]} {name, type, offset (note start), size (whole note), dataOffset}
 */
function ELF_NFD_getNotes() {
    if (ELF_NFD_cache.notes !== undefined) {
        return ELF_NFD_cache.notes;
    }

    var bBE = APKiD_isBigEndian(),
        b64 = APKiD_isElf64(),
        nFileSize = ELF.getSize();

    function parse(nOffset, nSize, aList) {
        var nRecords = 0;

        while ((nSize >= 6) && (nOffset + 12 <= nFileSize)) {
            var nNameLength = ELF.read_uint32(nOffset, bBE) >>> 0,
                nDescLength = ELF.read_uint32(nOffset + 4, bBE) >>> 0,
                nType = ELF.read_uint32(nOffset + 8, bBE) >>> 0,
                nNoteSize = 12 + (Math.ceil(nNameLength / 4) * 4) + (Math.ceil(nDescLength / 4) * 4);

            if ((nNoteSize > 0x7FFFFFFF) || (nSize < nNoteSize)) {
                break;
            }

            var sName = "";

            if (nNameLength >= 1) {
                sName = ELF.getString(nOffset + 12, nNameLength - 1);
            }

            aList.push({ name: sName, type: nType, offset: nOffset, size: nNoteSize, dataOffset: nOffset + 12 + Math.ceil(nNameLength / 4) * 4 });

            nOffset += nNoteSize;
            nSize -= nNoteSize;

            if (++nRecords > 1000) {
                break;
            }
        }
    }

    var aResult = [],
        nPhnum = Math.min(APKiD_elfHeader("phnum"), 100),
        i;

    for (i = 0; i < nPhnum; i++) {
        var nHeader = APKiD_elfHeader("phoff") + i * APKiD_elfHeader("phentsize");

        if (nHeader + (b64 ? 56 : 32) > nFileSize) {
            break;
        }

        if ((ELF.read_uint32(nHeader, bBE) >>> 0) == 4) { // PT_NOTE
            var nOffset = b64 ? ELF.read_uint64(nHeader + 8, bBE) : (ELF.read_uint32(nHeader + 4, bBE) >>> 0),
                nSize = b64 ? ELF.read_uint64(nHeader + 32, bBE) : (ELF.read_uint32(nHeader + 16, bBE) >>> 0);

            parse(nOffset, nSize, aResult);
        }
    }

    if (aResult.length == 0) {
        var nShnum = Math.min(ELF.getNumberOfSections(), 100),
            nShoff = APKiD_elfHeader("shoff"),
            nShentsize = APKiD_elfHeader("shentsize");

        for (i = 0; i < nShnum; i++) {
            var nSHeader = nShoff + i * nShentsize;

            if (nSHeader + (b64 ? 64 : 40) > nFileSize) {
                break;
            }

            if ((ELF.read_uint32(nSHeader + 4, bBE) >>> 0) == 7) { // SHT_NOTE
                parse(ELF.getSectionFileOffset(i), ELF.getSectionFileSize(i), aResult);
            }
        }
    }

    ELF_NFD_cache.notes = aResult;

    return aResult;
}

/**
 * First note with this name (XELF::getNote), or null.
 * @returns {Object|null}
 */
function ELF_NFD_getNote(sName) {
    var aNotes = ELF_NFD_getNotes();

    for (var i = 0; i < aNotes.length; i++) {
        if (aNotes[i].name == sName) {
            return aNotes[i];
        }
    }

    return null;
}
