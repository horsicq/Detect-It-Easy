                var nSize = ELF.getSectionFileSize(nLink);
                if (nSize > 0 && APKiD_re(sAnchor, listBacks, rRegExp, 4096, nOffset, nSize)) {
                    return true;
                }
            }
        }
    }
    return false;
}



