    var bBE = APKiD_isBigEndian();
    var b64 = APKiD_isElf64();
    var nShoff = APKiD_elfHeader("shoff");
    var nShentsize = APKiD_elfHeader("shentsize");
    for (var i = 0; i < nNumberOfSections; i++) {
        var nHeader = nShoff + i * nShentsize;
        if (nHeader + (b64 ? 64 : 40) > File.getSize()) {
            break;
        }
        if (ELF.read_uint32(nHeader + 4, bBE) === 2) { // SHT_SYMTAB
            var nLink = ELF.read_uint32(nHeader + (b64 ? 40 : 24), bBE);
