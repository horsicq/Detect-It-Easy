 * @returns {Number}
 */
ELF.getNumberOfSections = function () {
    return ELF_numberOfSections;
}


/**
 * Get a section number and cache the result.
 * @returns {Number}
 */
ELF.getSectionNumber = function (sSectionName) {
    var sCacheKey = "$" + sSectionName;

    if (ELF_sectionNumbers[sCacheKey] === undefined) {
        ELF_sectionNumbers[sCacheKey] = ELF_getSectionNumber(sSectionName);
    }

    return ELF_sectionNumbers[sCacheKey];
}


/**
