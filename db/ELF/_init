    return ELF.readByte(4) === 2;
}

/**
 * Raw ELF header field, read like the YARA elf module does (independent of
 * the engine's ELF parser, which rejects some packed files): "type",
 * "machine", "phoff", "phentsize", "phnum", "shoff", "shentsize".
 * @returns {Number}
