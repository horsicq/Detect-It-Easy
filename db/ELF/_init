                        aResult.push(sCurrent);
                    }

                    sCurrent = "";
                } else {
                    sCurrent += String.fromCharCode(aBytes[i] & 0xFF);
                }
            }
        }

        if (sCurrent.length) {
            aResult.push(sCurrent);
        }
    }

    ELF_NFD_cache.comments = aResult;

    return aResult;
}

