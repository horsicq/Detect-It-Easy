// APKiD port helpers (APKiD 3.2.0, RedNaga, GPL-3.0; used by the ELF rules
// ported from APKiD elf/*.yara). They reproduce the YARA string semantics the
// rules need over the whole file: text strings are case-sensitive byte
// strings, hex strings support "??", nibble wildcards ("0?", "?8"), fixed and
// bounded jumps ("[4]", "[4-32]", "[-]" = up to 4096 bytes) and "(a|b)"
// alternatives. Counts are numbers of distinct match start offsets (YARA "#").
// Results are cached per file because several rules share strings.
// ---------------------------------------------------------------------------

var APKiD_cache = {};

/**
 * Convert an ASCII/latin1 text string to a hex byte string.
 * @param {String} sText
 * @returns {String}
 */
function APKiD_textToHex(sText) {
    var sResult = "";
    for (var i = 0; i < sText.length; i++) {
        var sByte = (sText.charCodeAt(i) & 0xFF).toString(16);
        sResult += (sByte.length < 2 ? "0" : "") + sByte;
    }
    return sResult;
}

/**
 * Parse a YARA hex string body into the list of its expanded variants
 * (alternatives are expanded). Each variant is an array of tokens:
 * {k: 0, v: value, m: mask} for a byte, {k: 1, lo: n, hi: m} for a jump.
 * @param {String} sPattern
 * @returns {Array}
