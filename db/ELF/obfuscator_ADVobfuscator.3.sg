// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/obfuscators.yara#advobfuscator

// https://github.com/andrivet/ADVobfuscator
meta("obfuscator", "ADVobfuscator");

function detect() {
    var listStrings = [
        "_ZNK17ObfuscatedAddressIPFiiiPciS0_S0_EE8originalEv",
        "_ZNK17ObfuscatedAddressIPFiPcEE8originalEv",
        "_ZNK17ObfuscatedAddressIPFvPciEE8originalEv",
        "_ZNK17ObfuscatedAddressIPFvPcS0_EE8originalEv",
        "_ZNK17ObfuscatedAddressIPFvvEE8originalEv",
        "_Z14ObfuscatedCallI17ObfuscatedAddressIPFvvEEJEEvT_DpOT0_",
        "_ZNK17ObfuscatedAddressIPFiPviEE8originalEv",
        "_ZNK17ObfuscatedAddressIPFvPcEE8originalEv",
        "_ZNK17ObfuscatedAddressIPFvP7_JNIEnvEE8originalEv",
        "_ZNK17ObfuscatedAddressIPFvPcS0_iiEE8originalEv",
        "_ZNK17ObfuscatedAddressIPFvcEE8originalEv",
        "_ZNK17ObfuscatedAddressIPFvPviiEE8originalEv"
    ];

    // All twelve strings contain "ObfuscatedAddressIPF" or "ObfuscatedCall".
    if (APKiD_str("Obfuscated")) {
        for (var i = 0; i < listStrings.length; i++) {
            if (APKiD_str(listStrings[i])) {
                bDetected = true;
                break;
            }
        }
    }

    // /\_ZN\dandrivet\d\dADVobfuscator\d\dMetaString.*decryptEv/
    if (!bDetected && APKiD_re("andrivet", [4], /^_ZN\dandrivet\d\dADVobfuscator\d\dMetaString[^\n]*decryptEv/)) {
        bDetected = true;
    }

    return result();
}
