// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rules elf/protectors.yara#zimperium_zdefend, zimperium_z9, zimperium_zcloud

// https://www.zimperium.com/
meta("protector", "Zimperium");

function detect() {
    var listLibs = [
        ["00 6c69 625a 4465 6665 6e64 2e73 6f00", "zDefend"],   // \0libZDefend.so\0
        ["00 6c69 627a 392e73 6f00", "z9"],                     // \0libz9.so\0
        ["006c 6962 7a63 6c6f 7564 2e73 6f00", "zcloud"]        // \0libzcloud.so\0
    ];
    var bZimperium;
    for (var i = 0; i < listLibs.length; i++) {
        if (APKiD_hex(listLibs[i][0])) {
            if (bZimperium === undefined) {
                bZimperium = APKiD_strCount("zimperium", 11) > 10;
            }
            if (bZimperium) {
                _setResult(sType, sName, "", listLibs[i][1]);
            }
        }
    }

    return result();
}
