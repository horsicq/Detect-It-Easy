// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rules elf/obfuscators.yara#androidrepublic, androidrepublic_vip

// https://androidrepublic.org/
meta("obfuscator", "AndroidRepublic");

function detect() {
    var nCount = 0;
    if (APKiD_hex("00 6c 69 62 65 6d 74 72 65 70 75 62 6c 69 63 76 33 2e 73 6f 00")) nCount++; // \0libemtrepublicv3.so\0
    if (APKiD_hex("00 61 6e 64 72 6f 69 64 72 65 70 75 62 6c 69 63 2e 6f 72 67 00")) nCount++; // \0androidrepublic.org\0
    if (APKiD_str("We are Android Republic, while you snoop around trying to imitate, we are inovating the latest in Android Game modifications www.androidrepublic.org the oldest, the best and the future.")) nCount++;

    if (nCount >= 2) {
        _setResult(sType, sName, "", "");
    }

    // \0libandroidrepublic.so\0
    if (APKiD_hex("006c 6962 616e 6472 6f69 6472 6570 7562 6c69 632e 736f 00")) {
        _setResult(sType, sName, "", "VIP");
    }

    return result();
}
