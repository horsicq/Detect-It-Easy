// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/packers.yara#jiagu_native

// http://jiagu.360.cn/
meta("packer", "Jiagu");

function detect() {
    if (APKiD_str("libjiagu") && APKiD_str("libz.so") && APKiD_str("uncompress") &&
        (APKiD_str("JIAGU_APP_NAME") || APKiD_str("JIAGU_SO_BASE_NAME") ||
         APKiD_str("JIAGU_ENCRYPTED_DEX_NAME") || APKiD_str("JIAGU_HASH_FILE_NAME"))) {
        bDetected = true;
    }

    return result();
}
