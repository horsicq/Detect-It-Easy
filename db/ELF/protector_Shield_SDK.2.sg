// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#shield_sdk

// https://shield.com/
meta("protector", "Shield SDK");

function detect() {
    if (APKiD_hex("00" + APKiD_textToHex("libcashshieldabc-native-lib.so") + "00") &&
        APKiD_hex("00" + APKiD_textToHex("com/shield/android/internal/NativeUtils") + "00")) {
        bDetected = true;
    }

    return result();
}
