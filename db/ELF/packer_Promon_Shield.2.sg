// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rules elf/packers.yara#promon, promon_a

// https://promon.co/
meta("packer", "Promon Shield");

function detect() {
    // promon_a: at least two of the section names matching /\.ncu/, /\.ncc/, /\.ncd/ (promon adds
    // "libshield.so" or /lib[a-z]{10,12}\.so/ to the same condition, so promon_a covers both rules)
    var nNames = 0;
    if (APKiD_countSectionNames(/\.ncu/) > 0) nNames++;
    if (APKiD_countSectionNames(/\.ncc/) > 0) nNames++;
    if (nNames < 2 && APKiD_countSectionNames(/\.ncd/) > 0) nNames++;

    if (nNames >= 2) {
        bDetected = true;
    }

    return result();
}
