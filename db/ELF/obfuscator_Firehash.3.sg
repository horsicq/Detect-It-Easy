// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/obfuscators.yara#firehash

// https://firehash.grayhash.com/
meta("obfuscator", "Firehash");

function detect() {
    if (APKiD_elfHeader("machine") === APKiD_EM_ARM && APKiD_str(".firehash") &&
        APKiD_hex("04002DE5 00000FE1 010051E1 0200 00?A 00F029E1 04009DE4 ??????EA")) {
        bDetected = true;
    }

    return result();
}
