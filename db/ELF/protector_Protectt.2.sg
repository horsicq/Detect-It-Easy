// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#protectt

// https://www.protectt.ai
meta("protector", "Protectt");

function detect() {
    if (APKiD_str("libprotectt-native-lib.so") || APKiD_str("libprotecttai.so") || APKiD_str("libapp-protectt-native-lib.so") ||
        APKiD_hex("00 61 70 70 5f 70 72 6f 74 65 63 74 74 5f 6a 77 74 5f 74 6f 6b 65 6e 00") || // \0app_protectt_jwt_token\0
        APKiD_hex("00 41 70 70 50 72 6f 74 65 63 74 74 00")) {                                  // \0AppProtectt\0
        bDetected = true;
    }

    return result();
}
