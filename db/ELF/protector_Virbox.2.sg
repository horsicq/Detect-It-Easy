// Detect It Easy: detection rule file
// Author: Vito <@ScalletaZ>

// https://lm-global.virbox.com/
meta("protector", "Virbox");

function detect() {
    for (var i = 0; i < ELF.getNumberOfPrograms(); i++) {
        var nOffset = ELF.getProgramFileOffset(i);
        if (ELF.findString(nOffset, 32, "Virbox Protector") != -1) {
            bDetected = true;
            break;
        }
    }

    // Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#virbox_elf: "Virbox Protector\0\0" anywhere
    if (!bDetected && APKiD_hex("5669 7262 6f78 2050 726f 7465 6374 6f72 0000")) {
        bDetected = true;
    }

    return result();
}