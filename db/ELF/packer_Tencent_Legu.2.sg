// https://github.com/rednaga/APKiD/issues/390
meta("packer", "Tencent's Legu");

function detect() {
    if (APKiD_hex("00 6c69 6278 6756 6970 5365 6375 7269 7479 2e73 6f00")) { // \0libxgVipSecurity.so\0
        sOptions = "VMP";
        bDetected = true;
    }

    return result();
}
