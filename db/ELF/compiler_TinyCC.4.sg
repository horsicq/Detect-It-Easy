// https://en.wikipedia.org/wiki/Tiny_C_Compiler
// https://github.com/DosX-dev/TinyCC-builder
meta("compiler", "TinyCC");

function detect() {
    if (ELF.compareEP("F30F1EFA31ED4989D15E4889E24883E4F05054")) {
        sVersion = "0.9.27";
        bDetected = true;
    } else if (ELF.compareEP("554889E54881EC10000000B800000000C9C300000000")) {
        sVersion = "0.9.27";
        sOptions = "nostdlib"
        bDetected = true;
    }

    sLang = "C";

    return result();
}