// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#bshield

// https://bshield.io/
meta("protector", "BShield");

function detect() {
    if (APKiD_hex("00" + APKiD_textToHex("Lio/bshield/callback/ShieldDataProtection;") + "00") ||
        APKiD_hex("00" + APKiD_textToHex("io/bshield/callback/ShieldDataProtection") + "00")) {
        bDetected = true;
    }

    return result();
}
