// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rules elf/protectors.yara#whitecryption_elf, whitecryption_elf_a

// https://www.intertrust.com/products/application-shielding/
meta("protector", "WhiteCryption");

function detect() {
    if (APKiD_str("scpClassInit") || APKiD_str("SCP_EmptyFunction") ||
        APKiD_hex("17482DE9 580000EB 10FF2FE1") ||                     // PUSH {R0-R2,R4,R11,LR}; BL; BX R0
        APKiD_str("whiteCryptionSecureKeyBox") || APKiD_str("Java_com_whitecryption_skb_") ||
        APKiD_str("libSecureKeyBoxJava.so")) {
        bDetected = true;
    }

    return result();
}
