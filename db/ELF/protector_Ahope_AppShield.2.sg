// http://www.ahope.net/sub/app-shields
meta("protector", "Ahope AppShield");

function detect() {
    if (APKiD_hex("00 6c69 6261 686f 7065 [0-2] 2e73 6f00")) { // \0libahope??.so\0
        bDetected = true;
    }

    return result();
}
