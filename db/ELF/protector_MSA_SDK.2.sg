// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#msa_sdk

// http://msa-alliance.cn
meta("protector", "MSA SDK");

function detect() {
    // "\0libmsaoaid(auth|sec).so\0" and "mprotect"
    if (APKiD_hex("00 6C 69 62 6D 73 61 6F 61 69 64 (61 75 74 68 | 73 65 63) 2E 73 6F 00") && APKiD_str("mprotect")) {
        bDetected = true;
    }

    return result();
}
