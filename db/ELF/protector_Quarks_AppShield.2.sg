// https://www.quarkslab.com/white-box-cryptography/
meta("protector", "Quarks AppShield (Epona)");

function detect() {
    if (APKiD_hex("0D044039 0E084039 0F0C4039 02144039 041C4039 0C004039 10104039 03184039" +
                  "05204039 06244039 07284039 132C4039 14304039 15344039 16384039 003C4039")) {
        bDetected = true;
    }

    return result();
}
