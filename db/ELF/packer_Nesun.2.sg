meta("packer", "Nesun");

function detect() {
    if (APKiD_hex("00 2F 64 61 74 61 2F 64 61 74 61 2F 25 73 2F 2E 7A 70 72 6F 74 65 63 74 2F 25 73 2F 6F 72 69 67 69 6E 2E 61 70 6B 00") || // \0/data/data/%s/.zprotect/%s/origin.apk\0
        APKiD_hex("00 2F 64 61 74 61 2F 64 61 74 61 2F 25 73 2F 2E 7A 70 72 6F 74 65 63 74 00") || // \0/data/data/%s/.zprotect\0
        APKiD_hex("00 2E 7A 70 72 6F 74 65 63 74 00") ||                                         // \0.zprotect\0
        APKiD_hex("00 6C 69 62 7A 70 72 6F 74 65 63 74 2E 73 6F 00")) {                          // \0libzprotect.so\0
        bDetected = true;
    }

    return result();
}
