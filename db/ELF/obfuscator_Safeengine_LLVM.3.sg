// https://bbs.pediy.com/thread-195327.htm
meta("obfuscator", "Safeengine LLVM");

function detect() {
    if (APKiD_hex("00 53 61 66 65 6e 67 69 6e 65 20 63 6c 61 6e 67 20 76 65 72 73 69 6f 6e 20") && APKiD_str("(based on LLVM ")) {
        bDetected = true;
    }

    return result();
}
