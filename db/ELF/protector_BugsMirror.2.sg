// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#bugsmirror

// https://www.bugsmirror.com/
meta("protector", "BugsMirror");

function detect() {
    if (APKiD_countSectionNames(/^\.crypted$/) > 0 && APKiD_hex(APKiD_textToHex("libdefender.so") + "00")) {
        bDetected = true;
    }

    return result();
}
