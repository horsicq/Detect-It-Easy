// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#dpt_shell

// https://github.com/luoyesiqiu/dpt-shell
meta("protector", "DPT Shell");

function detect() {
    if (APKiD_countSectionNames(/^\.bitcode$/) > 0 &&
        (APKiD_hex("00 6c 69 62 64 70 74 2e 73 6f 00") || APKiD_hex("00 62 79 74 65 68 6f 6f 6b 5f 74 61 67 00"))) { // \0libdpt.so\0, \0bytehook_tag\0
        bDetected = true;
    }

    return result();
}
