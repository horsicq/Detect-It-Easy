// Detect It Easy: detection rule file
// Author: Henglie <ebhenglie@gmail.com>

// https://github.com/marcelotduarte/cx_Freeze
// https://github.com/marcelotduarte/freeze-core
meta("packer", "CX_Freeze");

function detect() {
    if (ELF.isSectionNamePresent(".interp")) {
        var hasModernInitializer = ELF.isStringInTablePresent(".dynstr", "Py_InitializeFromConfig");
        var hasLegacyInitializer = ELF.isStringInTablePresent(".dynstr", "Py_Initialize") &&
            ELF.isStringInTablePresent(".dynstr", "Py_FrozenFlag");

        if (hasModernInitializer || hasLegacyInitializer) {
            var rodataSection = ELF.getSectionNumber(".rodata");

            if (rodataSection !== -1 &&
                hasCxFreezeStubMarkers(ELF.getSectionFileOffset(rodataSection), ELF.getSectionFileSize(rodataSection))) {
                bDetected = true;
            }
        }
    }

    sLang = "Python";

    return result();
}

/**
 * Checks the .rodata string table for cx_Freeze base-executable messages.
 *
 * @param {number} offset - Section file offset.
 * @param {number} size - Section file size.
 * @returns {boolean} True when the cx_Freeze markers are present.
 */
function hasCxFreezeStubMarkers(offset, size) {
    if (ELF.findString(offset, size, "Unable to calculate directory of executable!") === -1) {
        return false;
    }

    if (ELF.findString(offset, size, "__startup__") === -1) {
        return false;
    }

    return ELF.findString(offset, size, "Out of memory creating sys.path!") !== -1 ||
        ELF.findString(offset, size, "Out of memory creating lib_dir!") !== -1 ||
        ELF.findString(offset, size, "Out of memory creating platlib!") !== -1 ||
        ELF.findString(offset, size, "Out of memory creating executable!") !== -1;
}
