// https://www.appsealing.com/
meta("protector", "AppSealing");

function detect() {
    var listPatterns = [
        "00 6c69 6263 6f76 6175 6c74 2d61 7070 7365 632e 736f 00",                 // \0libcovault-appsec.so\0
        "00 2573 2f61 7070 7365 616c 696e 672e 6465 7800",                         // \0%s/appsealing.dex\0
        "00 4150 5053 4541 4c49 4e47 2d43 4f52 452d 5645 5253 494f 4e5f",          // \0APPSEALING-CORE-VERSION_
        "00 284c 616e 6472 6f69 642f 636f 6e74 656e 742f 436f 6e74 6578 743b 4c63" +
        "6f6d 2f69 6e6b 612f 6170 7073 6561 6c69 6e67 2f41 7070 5365 616c 696e 6741 7070" +
        "6c69 6361 7469 6f6e 3b4c 6a61 7661 2f6c 616e 672f 436c 6173 734c 6f61 6465 723b" +
        "4c61 6e64 726f 6964 2f63 6f6e 7465 6e74 2f72 6573 2f41 7373 6574 4d61 6e61 6765" +
        "723b 4c6a 6176 612f 6c61 6e67 2f53 7472 696e 673b 4c6a 6176 612f 6c61 6e67 2f53" +
        "7472 696e 673b 4c6a 6176 612f 6c61 6e67 2f53 7472 696e 673b 294c 6a61 7661 2f6c" +
        "616e 672f 5374 7269 6e67 3b00",
        "00 636f 6d2f 696e 6b61 2f61 7070 7365 616c 696e 672f 4170 7053 6561 6c69 6e67 4170 706c 6963 6174 696f 6e00",
        "49 6e69 7469 6174 6520 4170 7053 6561 6c69 6e67 2053 6563 7572 6974 7920 3a20 4152 4d36 3420 2843 6f72" +
        "6520 5665 7273 696f 6e20 3d20 2573 2900"                                  // Initiate AppSealing Security : ARM64 (Core Version = %s)
    ];
    var nCount = 0;
    for (var i = 0; i < listPatterns.length && nCount < 2; i++) {
        if (APKiD_hex(listPatterns[i])) {
            nCount++;
        }
    }

    if (nCount >= 2) {
        bDetected = true;
    }

    return result();
}
