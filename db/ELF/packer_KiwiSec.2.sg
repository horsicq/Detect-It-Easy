// https://en.kiwisec.com/
meta("packer", "KiwiSec");

function detect() {
    var listPatterns = [
        "00 6b 69 77 69 5f 64 75 6d 70 65 72 00",                                // \0kiwi_dumper\0
        "00 6c 69 62 4b 77 50 72 6f 74 65 63 74 53 44 4b 2e 73 6f 00",            // \0libKwProtectSDK.so\0
        "00 6c 69 62 6b 77 73 64 61 74 61 65 6e 63 2e 73 6f 00",                  // \0libkwsdataenc.so\0
        "00 6c 69 62 6b 69 77 69 63 72 61 73 68 2e 73 6f 00",                     // \0libkiwicrash.so\0
        "00 63 6F 6D 2F 6B 69 77 69 73 65 63 2F 63 72 61 73 68 2F 4E 61 74 69 76 65 48 61 6E 64 6C 65 72 00", // com/kiwisec/crash/NativeHandler
        "00 63 6F 6D 2F 6B 69 77 69 73 65 63 2F 63 72 61 73 68 2F 43 72 61 73 68 55 74 69 6C 73 00"           // com/kiwisec/crash/CrashUtils
    ];
    for (var i = 0; i < listPatterns.length; i++) {
        if (APKiD_hex(listPatterns[i])) {
            bDetected = true;
            break;
        }
    }

    return result();
}
