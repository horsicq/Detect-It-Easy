// http://www.stealien.com/appsuit.html
meta("packer", "AppSuit");

function detect() {
    if (APKiD_hex("00 6c6962417070537569742e736f 00") && APKiD_hex("00 6c6962556e7061636b65722e736f 00")) {
        bDetected = true;
    }

    return result();
}
