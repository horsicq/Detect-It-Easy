        APKiD_hex("00482DE9 04B08DE2 28D04DE2 10000BE5 14100BE5 18200BE5 1C300BE5 0030A0E3" +
                  "08300BE5 08309BE5 00308DE5 0C309BE5 04308DE5 0030A0E3 08308DE5 10301BE5" +
                  "0C308DE5 14001BE5 18101BE5 1C201BE5 04309BE5 ??????EB 0030A0E1 08300BE5" +
                  "08301BE5 10001BE5 0310A0E1 ??????EB 0030A0E1 08300BE5 08301BE5 0300A0E1" +
                  "04D04BE2 0088BDE8");
    var bArm64 = !bArm32 &&
        APKiD_hex("E10BBFA9 E313BFA9 E51BBFA9 E723BFA9 E97BBFA9 E80307AA 010000D4 E97BC1A8" +
                  "E723C1A8 E51BC1A8 E313C1A8 E10BC1A8 C0035FD6") &&
        APKiD_hex("E10BBFA9 E313BFA9 E51BBFA9 E723BFA9 E92BBFA9 EB33BFA9 ED3BBFA9 EF43BFA9" +
                  "F14BBFA9 F353BFA9 F55BBFA9 F763BFA9 F96BBFA9 FB73BFA9 FD7BBFA9 E0030091" +
                  "??????97 FD7BC1A8 FB73C1A8 F96BC1A8 F763C1A8 F55BC1A8 F353C1A8 F14BC1A8" +
                  "EF43C1A8 ED3BC1A8 EB33C1A8 E92BC1A8 E723C1A8 E51BC1A8 E313C1A8 E10BC1A8 C0035FD6") &&
        (APKiD_hex("E203002A E37F94B9 401C80D2 040080D2 050080D2 060080D2 ??????94") ||
         APKiD_hex("000080D2 010080D2 E203142A 23008052 A4168052 25008052 A6008052 E703132A ??????94") ||
         APKiD_hex("000080D2 010080D2 23008052 C4188052 25008052 C6008052 07008052 ??????94") ||
         APKiD_hex("000080D2 010080D2 23008052 E4188052 25008052 E6008052 07008052 ??????94"));

