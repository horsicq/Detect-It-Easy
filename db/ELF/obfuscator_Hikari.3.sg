// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/obfuscators.yara#hikari

// https://github.com/HikariObfuscator/Hikari
meta("obfuscator", "Hikari");

function detect() {
    // /clang version \d+\.\d+\.\d+ \(.*\) \(.*\/Hikari\.git [0-9a-f]{40}\)/
    if (APKiD_str("/Hikari.git ") &&
        APKiD_re("clang version ", [0], /^clang version \d+\.\d+\.\d+ \([^\n]*\) \([^\n]*\/Hikari\.git [0-9a-f]{40}\)/)) {
        bDetected = true;
    }

    return result();
}
