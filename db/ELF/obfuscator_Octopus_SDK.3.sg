// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/obfuscators.yara#octopus_codevo

// https://codevo.com.tr/portfolio/
meta("obfuscator", "Octopus SDK (Codevo)");

function detect() {
    // /\_ZN\d{1,2}octopus_obf\d{1,2}obfuscated_dataILy(.*)Ev/
    if (APKiD_re("octopus_obf", [4, 5], /^_ZN\d{1,2}octopus_obf\d{1,2}obfuscated_dataILy[^\n]*Ev/)) {
        bDetected = true;
    }

    return result();
}
