// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/anti-vm.yara#check_qemu_entropy

// https://github.com/Fuzion24/AndroidHostileEnvironmentDetection/blob/master/app/jni/emudetect.c
meta("anti-vm", "Checks for QEMU entropy");

function detect() {
    if (ELF.isHeuristicScan() && (APKiD_str("atomicallyIncreasingGlobalVarThread") || APKiD_str("_qemuFingerPrint"))) {
        bDetected = true;
    }

    return result();
}
