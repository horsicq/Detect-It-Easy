// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_elf.cpp:1079-1172; nfd_binary.cpp:1646-1752, 1957-1973)

// Protectors named in the .comment section that no other ELF rule reports
// (Obfuscator-LLVM, ByteGuard, Alipay, Hikari, SnapProtect and Safeengine LLVM have APKiD rules).
meta("protector", "NFD .comment");

function detect() {
    ELF_NFD_emitCommentDetects(["wangzehuaLLVM", "TencentProtection", "ByteDanceSecCompiler", "DingbaozengNativeObfuscator", "NagainLLVM",
        "iJiamiLLVM", "OllvmTll"]);

    var oDetects = ELF_NFD_getCommentDetects();

    // Products with an existing ELF rule under another name: reported under that name, only when that
    // rule (run earlier: obfuscator_*, packer_*) did not already report it from other evidence.
    if (oDetects.TencentLegu && !_isResultPresent("packer", "Tencent's Legu")) {
        _setResult("packer", "Tencent's Legu", "", "");
    }

    if (oDetects.HikariObfuscator && !_isResultPresent("obfuscator", "Hikari")) {
        _setResult("obfuscator", "Hikari", "", "");
    }

    return result();
}
