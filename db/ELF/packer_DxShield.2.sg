meta("packer", "DxShield");

function detect() {
    if (APKiD_hex("00 6C 69 62 64 78 62 61 73 65 2E 73 6F 00 4C 49 42 43 00")) { // \0libdxbase.so\0LIBC\0
        bDetected = true;
    }

    return result();
}
