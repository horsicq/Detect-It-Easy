// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rules elf/packers.yara#appguard_elf, appguard_elf_b

// http://appguard.nprotect.com/en/index.html
meta("packer", "AppGuard");

function detect() {
    // appguard_elf $b ("\0#Lcom/inca/security/AppGuard/xClass;\0") is also a match of appguard_elf_b $b
    if (APKiD_hex("00 6C 69 62 41 70 70 47 75 61 72 64 2E 73 6F 00") ||          // \0libAppGuard.so\0
        APKiD_hex("00 6C 69 62 63 6F 6D 70 61 74 69 62 6C 65 2E 73 6F 00") ||    // \0libcompatible.so\0
        APKiD_hex("00 ?? 4C 63 6F 6D 2F 69 6E 63 61 2F 73 65 63 75 72 69 74 79 2F 41 70 70 47 75 61 72 64 2F 78 43 6C 61 73 73 3B 00")) {
        bDetected = true;
    }

    return result();
}
