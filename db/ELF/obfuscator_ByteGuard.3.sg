// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rules elf/obfuscators.yara#byteguard_0_9_3, byteguard_0_9_2, byteguard_unknown

meta("obfuscator", "ByteGuard");

// /(Apple LLVM|clang) version \d+\.\d+\.\d+ \(Byte(G|g)uard/ at a "clang version " or "Apple LLVM version " anchor
function isByteGuard(rRegExp) {
    return APKiD_re("clang version ", [0], rRegExp, 256) || APKiD_re("Apple LLVM version ", [0], rRegExp, 256);
}

function detect() {
    if (isByteGuard(/^(Apple LLVM|clang) version \d+\.\d+\.\d+ \(Byte(G|g)uard/)) {
        if (isByteGuard(/^(Apple LLVM|clang) version \d+\.\d+\.\d+ \(Byte(G|g)uard(-| )0\.9\.3/)) {
            sVersion = "0.9.3";
        } else if (isByteGuard(/^(Apple LLVM|clang) version \d+\.\d+\.\d+ \(Byte(G|g)uard(-| )0\.9\.2/)) {
            sVersion = "0.9.2";
        }
        bDetected = true;
    }

    // Ported from Nauz File Detector (SpecAbstract nfd_elf.cpp:71-79; nfd_binary.cpp _get_ByteGuard_string): NFD's .comment version wins.
    var oNFD = bDetected ? ELF_NFD_getCommentVersion("ByteGuard") : null;
    if (oNFD) {
        sVersion = oNFD.version;
    }

    return result();
}
