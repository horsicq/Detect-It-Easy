// https://5play.ru
meta("packer", "5play.ru");

function detect() {
    var nCount = 0;
    if (APKiD_hex("00 6c69 6252 4d53 2e73 6f 00")) nCount++;       // \0libRMS.so\0
    if (APKiD_hex("00 4a4e 495f 4f6e 4c6f 6164 00")) nCount++;     // \0JNI_OnLoad\0
    if (nCount && APKiD_hex("FF5F2DE9 427100E3 0120A0E1 0010A0E1 6300E0E3 000000EF")) nCount++;
    if (nCount && nCount < 3 && APKiD_hex("080780D2 E20301AA E10300AA 600C8012 010000D4")) nCount++;

    if (nCount >= 3) {
        bDetected = true;
    }

    return result();
}
