// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_elf.cpp:659-667)

meta("loader", ".NET");

function detect() {
    // .NET (Core) apphost: DT_RUNPATH "$ORIGIN/netcoredeps".
    if (ELF.getRunPath() == "$ORIGIN/netcoredeps") {
        bDetected = true;
    }

    return result();
}
