// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#metafortress

// https://www.insidesecure.com/Products/Application-Protection/Software-Protection/Code-Protection
meta("protector", "InsideSecure MetaFortress");

function detect() {
    if ((APKiD_hex("00 4d65 7461 466f 7274 7265 7373 3a20 2573 0025 733a 2025 730a 00") &&    // \0MetaFortress: %s\0%s: %s\n\0
         APKiD_hex("00 4d65 7461 466f 7274 7265 7373 00")) ||                                 // \0MetaFortress\0
        APKiD_hex("00 4d45 5441 464f 5249 4300 0000 0000 0000") ||                            // \0METAFORIC\0...
        APKiD_hex("00 4a61 7661 5f63 6f6d 5f69 6e73 6964 6573 6563 7572 655f 6863 655f")) {   // \0Java_com_insidesecure_hce_
        bDetected = true;
    }

    return result();
}
