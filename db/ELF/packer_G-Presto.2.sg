// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/packers.yara#gpresto_elf

// https://www.largosoft.co.kr/
meta("packer", "G-Presto (anti-cheat)");

function detect() {
    // $class = { 00 [0-2] "Lcom/bishopsoft/Presto/SDK/Presto;" 00 } and 2 of ($name*)
    if (APKiD_hex("00 [0-2] 4C 63 6F 6D 2F 62 69 73 68 6F 70 73 6F 66 74 2F 50 72 65 73 74 6F 2F 53 44 4B 2F 50 72 65 73 74 6F 3B 00")) {
        var nCount = 0;
        if (APKiD_hex("00 6C 69 62 41 54 47 5F 4C 2E 73 6F 00")) nCount++;                              // \0libATG_L.so\0
        if (APKiD_hex("(00 | 20) 47 2D 50 72 65 73 74 6F (20 | 00)")) nCount++;                         // G-Presto
        if (nCount < 2 && APKiD_hex("00 3c 50 72 65 73 74 6f 5f 45 3e 00")) nCount++;                  // \0<Presto_E>\0
        if (nCount < 2 && APKiD_hex("00 6c 61 72 67 6f 73 6f 66 74 2e 63 6f 2e 6b 72 00")) nCount++;   // \0largosoft.co.kr\0
        if (nCount >= 2) {
            bDetected = true;
        }
    }

    return result();
}
