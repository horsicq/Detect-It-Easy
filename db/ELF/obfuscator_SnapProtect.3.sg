// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/obfuscators.yara#snapprotect

// https://www.snapchat.com/
meta("obfuscator", "SnapProtect");

function detect() {
    // $b = " (snap.protect version " is contained in every match of
    // $a = /clang version \d\.\d\.\d \(snap.protect version \d\.\d\.\d/
    if (APKiD_str(" (snap.protect version ") ||
        APKiD_re("clang version ", [0], /^clang version \d\.\d\.\d \(snap[^\n]protect version \d\.\d\.\d/, 64)) {
        bDetected = true;
    }

    return result();
}
