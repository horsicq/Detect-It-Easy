// https://developer.android.com/google/play/integrity/overview
meta("protector", "Google Automatic Integrity");

function detect() {
    if (APKiD_hex("00 6c69 6270 6169 7269 7063 6f72 652e 736f 00") &&       // \0libpairipcore.so\0
        APKiD_hex("00 4578 6563 7574 6550 726f 6772 616d 00") &&            // \0ExecuteProgram\0
        APKiD_hex("004a 4e49 5f4f 6e4c 6f61 6400") &&                       // \0JNI_OnLoad\0
        APKiD_hex("004a 4e49 5f4f 6e55 6e6c 6f61 6400")) {                  // \0JNI_OnUnLoad\0
        bDetected = true;
    }

    return result();
}
