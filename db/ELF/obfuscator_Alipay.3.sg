// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/obfuscators.yara#alipay

// https://www.jianshu.com/p/477af178d7d8
meta("obfuscator", "Alipay");

function detect() {
    if (APKiD_str("Alipay clang version ") || APKiD_str("Alipay  Obfuscator (based on LLVM ") || APKiD_str("Alipay.Obfuscator.")) {
        bDetected = true;
    }

    // Ported from Nauz File Detector (SpecAbstract nfd_elf.cpp:208-217; nfd_binary.cpp _get_AlipayObfuscator_string): NFD's .comment version wins.
    var oNFD = bDetected ? ELF_NFD_getCommentVersion("AlipayObfuscator") : null;
    if (oNFD) {
        sVersion = oNFD.version;
        sOptions = oNFD.info;
    }

    return result();
}
