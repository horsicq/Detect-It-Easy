// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#denuvo_elf

// https://irdeto.com/denuvo/anti-tamper
meta("protector", "Denuvo");

function detect() {
    if (APKiD_hex("00" + APKiD_textToHex("libvmpc.so") + "00")) {
        bDetected = true;
    }

    return result();
}
