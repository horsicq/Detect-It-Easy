// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rules elf/obfuscators.yara#arxan_arm32, arxan_arm64

// https://www.arxan.com/resources/technology/app-code-obfuscation
meta("obfuscator", "Arxan");

function detect() {
    var nMachine = APKiD_elfHeader("machine");

    if (nMachine === APKiD_EM_ARM) {
        if (APKiD_count("001090E5 000081E0 031000E0 0220A0E3 920101E0 030020E0 010080E0 00F0A0E1", 6) > 5 ||
            APKiD_count("4FF00100 02A1 01FB00F0 8746", 6) > 5 ||
            APKiD_count("??????E? 910000E0 00F0A0E1", 11) > 10) {
            bDetected = true;
        }
    } else if (nMachine === APKiD_EM_AARCH64) {
        if (APKiD_count("09010?8A 4A0080D2 297D0A9B 08010?CA 0801098B 00011FD6", 4) > 3 ||
            APKiD_count("280080D2 69000010 287D089B 00011FD6", 4) > 3) {
            bDetected = true;
        }
    }

    return result();
}
