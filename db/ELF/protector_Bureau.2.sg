// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#bureau

// https://bureau.id
meta("protector", "Bureau");

function detect() {
    // /lib(bureau\-.*|secure_keys|ndkdatacollector)\.so/
    if (APKiD_str("libsecure_keys.so") || APKiD_str("libndkdatacollector.so") ||
        APKiD_re("libbureau-", [0], /^libbureau-[^\n]*\.so/) ||
        APKiD_hex("00" + APKiD_textToHex("Java_com_bureau_checkRoot_VerifyRootNative_checkForRoot") + "00") ||
        APKiD_hex("00" + APKiD_textToHex("Java_com_bureau_devicefingerprint_security_SecureJNI_getKey") + "00") ||
        APKiD_hex("00" + APKiD_textToHex("Java_com_bureau_devicefingerprint_tools_NDKMappers_checkFrida") + "00")) {
        bDetected = true;
    }

    return result();
}
