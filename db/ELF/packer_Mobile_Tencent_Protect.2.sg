// https://intl.cloud.tencent.com/product/mtp
meta("packer", "Mobile Tencent Protect");

function detect() {
    // "\0getenv\0liblog.so\0libz.so\0libdl.so\0libc.so\0libshell.so\0"
    if (APKiD_hex("00 67 65 74 65 6E 76 00 6C 69 62 6C 6F 67 2E 73 6F 00 6C 69 62 7A 2E" +
                  "73 6F 00 6C 69 62 64 6C 2E 73 6F 00 6C 69 62 63 2E 73 6F 00 6C 69 62" +
                  "73 68 65 6C 6C 2E 73 6F 00")) {
        bDetected = true;
    }

    return result();
}
