// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule elf/protectors.yara#nhn_appguard

// https://www.nhncloud.com/kr/service/security/nhn-appguard
meta("protector", "NHN AppGuard");

function detect() {
    // any of /\d{2}ComNhnentAppguardAppguardJavaClass(Impl)?\x00/, /\d{2}AppGuardCallbackJavaClass(Impl)?\x00/
    if (APKiD_re("ComNhnentAppguardAppguardJavaClass", [2], /^\d{2}ComNhnentAppguardAppguardJavaClass(Impl)?\x00/, 48) ||
        APKiD_re("AppGuardCallbackJavaClass", [2], /^\d{2}AppGuardCallbackJavaClass(Impl)?\x00/, 40)) {
        if (APKiD_hex("00 6C 69 62 6C 6F 61 64 65 72 2E 73 6F 00") ||                       // \0libloader.so\0
            APKiD_hex("00 28 28 61 70 70 67 75 61 72 64 5F 61 70 70 6C 69 63 61 74 69 6F 6E 5F 29 29 20 (3D | 21) 3D 20 28 6E 75 6C 6C 70 74 72 29") ||
            APKiD_hex("(00 ?? | ??) 61 70 70 67 75 61 72 64 5F 68 65 61 64 65 72 2D 3E 47 65 74 (45 6E 63 72 79 70 74 65 64 | 4F 72 69 67 69 6E 61 6C)" +
                      "50 61 79 6C 6F 61 64 4C 65 6E 67 74 68 28 29")) {
            bDetected = true;
        }
    }

    return result();
}
