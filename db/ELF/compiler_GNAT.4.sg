// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://en.wikipedia.org/wiki/GNAT
meta("compiler", "GNAT");

function detect() {
    if (ELF.isLibraryPresent("libgnat-13.so")) {
        sVersion = "13.3.0";
        bDetected = true;
    }

    sLang = "Ada";

    return result();
}