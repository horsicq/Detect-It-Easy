// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

meta("protector", "HyperTech Crackproof");

function detect() {
    if (PE.getNumberOfImports() > 0 && PE.getImportLibraryName(0) === "KeRnEl32.dLl") {
        bDetected = true;
    }

    // Ported from Nauz File Detector "HyperTech Crackproof" (SpecAbstract modules/nfd_pe.cpp:1482):
    // any import library named exactly "KeRnEl32.dLl".
    if (!bDetected) {
        for (var nNfdImport = 0; nNfdImport < PE.getNumberOfImports(); nNfdImport++) {
            if (PE.getImportLibraryName(nNfdImport) === "KeRnEl32.dLl") {
                sVersion = sOptions = "";
                bDetected = true;
                break;
            }
        }
    }

    return result();
}