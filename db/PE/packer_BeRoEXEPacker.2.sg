// https://blog.rosseaux.net/page/875fbe6549aa072b5ee0ac9cefff4827/BeRoEXEPacker
meta("packer", "BeRoEXEPacker");

function detect() {
    var nEP = PE.compareEP("837C2408010F85") ? 11 : 0;
    if (PE.compareEP("60BE........BF........FCB28033DBA4B302E8", nEP)) {
        sVersion = "1.00";
        sOptions = "LZBRR";
    } else if (PE.compareEP("60BE........BF........FCAD8D1C07B0803BFB733BE8", nEP)) {
        sVersion = "1.00";
        sOptions = "LZBRS";
    } else if (PE.compareEP("6068........68........68........E8........BE........B9")) {
        sVersion = "1.00";
        sOptions = "LZMA";
    } else if (PE.compareEP("BA........8DB2........8B46..85C0745103C28B7E..8B1E85DB75028BDF03DA03FA525750FF15") || PE.compareEP("60FCB9........BE........BF........F3A4")) {
        sVersion = "1.00";
    } else if (PE.compareEP("6068........68......0068........e8..040000..................00")) {
        sVersion = "1.00";
        sOptions = "LZMA";
    } else if (PE.compareEP("60e8000000005e81c6....0000bf........6081ec0804000089e357fc31c0b4")) {
        sVersion = "1.00";
        sOptions = "CTX1";
    } else if (PE.compareEP("60c8940c0060fcbe........ad8945fc33c0f7d08945f8f7d0b408b923030000")) {
        sVersion = "1.00";
        sOptions = "LZBRA";
    } else if (PE.compare("52c3'(C)BeRo!PE'0000", 2)) {
        bDetected = true;
    }

    if (PE.compare("52c3'BeRo^fr!PE'", 2)) {
        sOptions = "Special PE Header";
    }

    bDetected = bDetected || Boolean(sVersion) || Boolean(sOptions);

    // Ported from Nauz File Detector "BeRoEXEPacker" (SpecAbstract modules/nfd_pe.cpp:98, 185, 186, 187, 189, 191, 193, 542, 923, 924, 2144):
    // PE32, not .NET; import hash and (header marker, or generic tiny header with entry point signature).
    // Also used to fill in the version when the rule above found the product without one.
    if ((!bDetected || (!sVersion && !sOptions)) && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x13e215a53 && nNfdHash32 == 0xdf3c1e0)) {
            if (PE.compare("'MZ'52C3'(C)BeRo!PE'0000")) {
                sVersion = "1.00";
                sOptions = "";
                if (PE.compareEP("60BE........BF........FCB28033DBA4B302E8")) {
                    sVersion = "1.00";
                    sOptions = "LZBRR";
                } else if (PE.compareEP("60BE........BF........FCAD8D1C07B0803BFB733BE8")) {
                    sVersion = "1.00";
                    sOptions = "LZBRS";
                } else if (PE.compareEP("6068........68........68........E8........BE........B9")) {
                    sVersion = "1.00";
                    sOptions = "LZMA";
                } else if (PE.compareEP("837C2408010F85........60BE........BF........FCB28033DBA4B302E8")) {
                    sVersion = "1.00";
                    sOptions = "LZBRR/dll";
                } else if (PE.compareEP("837C2408010F85........60BE........BF........FCAD8D1C07B0803BFB733BE8")) {
                    sVersion = "1.00";
                    sOptions = "LZBRS/dll";
                } else if (PE.compareEP("837C2408010F85........6068........68........68........E8........BE........B9")) {
                    sVersion = "1.00";
                    sOptions = "LZMA/dll";
                }
                bDetected = true;
            } else if (PE.compare("'MZ'....................'PE'0000")) {
                if (PE.compareEP("60BE........BF........FCB28033DBA4B302E8")) {
                    sVersion = "1.00";
                    sOptions = "LZBRR";
                    bDetected = true;
                } else if (PE.compareEP("60BE........BF........FCAD8D1C07B0803BFB733BE8")) {
                    sVersion = "1.00";
                    sOptions = "LZBRS";
                    bDetected = true;
                } else if (PE.compareEP("6068........68........68........E8........BE........B9")) {
                    sVersion = "1.00";
                    sOptions = "LZMA";
                    bDetected = true;
                } else if (PE.compareEP("837C2408010F85........60BE........BF........FCB28033DBA4B302E8")) {
                    sVersion = "1.00";
                    sOptions = "LZBRR/dll";
                    bDetected = true;
                } else if (PE.compareEP("837C2408010F85........60BE........BF........FCAD8D1C07B0803BFB733BE8")) {
                    sVersion = "1.00";
                    sOptions = "LZBRS/dll";
                    bDetected = true;
                } else if (PE.compareEP("837C2408010F85........6068........68........68........E8........BE........B9")) {
                    sVersion = "1.00";
                    sOptions = "LZMA/dll";
                    bDetected = true;
                }
            }
        }
    }

    return result();
}