// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://github.com/packing-box/dataset-packed-pe/tree/main/packed/JDPack
meta("packer", "JDPack");

function detect() {
    if (PE.compareEP("60E8000000005D8BD581ED........2B95........81EA06......8995........83BD")) {
        sVersion = "1.01";
        bDetected = true;
    } else if (PE.compareEP("558BEC6AFF68........68........64A1000000005064892500000000......E801000000")) {
        sVersion = "2.00";
        bDetected = true;
    }

    // Ported from Nauz File Detector "JDPack" (SpecAbstract modules/nfd_pe.cpp:293, 295, 579, 832, 965, 2930):
    // PE32, not .NET; import hash and entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if (((nNfdHash64 == 0x240d976a2 && nNfdHash32 == 0x10c77c1b) ||
            PE.isImportPositionHashPresent(0, 0xc002db0e))) {
            if (PE.compareEP("60E8000000005D8BD581ED........2B95........81EA06......8995........83BD")) {
                sVersion = "1.01";
                sOptions = "";
                bDetected = true;
            } else if (PE.compareEP("558BEC6AFF68........68........64A1000000005064892500000000......E801000000")) {
                sVersion = "2.00";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}