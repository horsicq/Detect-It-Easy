// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/jiowcl/ExePacker
meta("packer", "ExePacker");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    if (PE.compareEP("4883EC28E84B0200004883C428E97AFEFFFFCCCC4883EC28E80F000000") && PE.getNumberOfSections() === 9 && PE.getNumberOfImports() === 4 && PE.getVersionStringInfo("FileDescription") == "Simple PE File Packer Stub") {
        sVersion = "1.0.0-1.2.0";
        bDetected = true;
    }

    return result();
}