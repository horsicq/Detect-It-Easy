// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:225, 581, 966, 2687)

meta("protector", "KaOs PE-DLL eXecutable Undetecter");

function detect() {
    // NFD: PE32, not .NET; import hash, entry point signature and section name ".Kaos12" or ".Kaos2 "
    if (!PE.is64() && !PE.isNet()) {
        if (PE.getImportHash64() == 0x241c3b6a6 && PE.getImportHash32() == 0xbf363f04) {
            if (PE.isSectionNamePresent(".Kaos12") || PE.isSectionNamePresent(".Kaos2 ")) {
                if (PE.compareEP("60FC0FB605........85C075")) {
                    bDetected = true;
                } else if (PE.compareEP("FC0FB605........85C075")) {
                    sOptions = "Modified";
                    bDetected = true;
                }
            }
        }
    }

    return result();
}
