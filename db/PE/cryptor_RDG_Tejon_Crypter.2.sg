meta("cryptor", "RDG Tejon Crypter");

function detect() {
    if (PE.compareEP("6850171001E8EEFFFFFF000000000000300000003800000100000000B365D0B8919CE145AA1BEEE0C80467EE")) {
        sVersion = "0.7";
        bDetected = true;
    }

    // Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:524 _PE_importhash_records): the import hash pair alone, PE32
    if (!bDetected && !PE.is64() && PE.getImportHash64() === 0x2c078d7e86 && PE.getImportHash32() === 0x3c328f0c) {
        sVersion = "0.8";
        sOptions = "TEST";
        bDetected = true;
    }

    return result();
}