// https://github.com/domaindrivendev/Swashbuckle.AspNetCore
meta("library", "Swashbuckle.AspNetCore");

function detect() {
    if (PE.isNetObjectPresent("Swashbuckle.Core")) {
        bDetected = true;
    }

    return result();
}