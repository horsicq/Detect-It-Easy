// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

meta("protector", "MaskPE");

function detect() {
    if (PE.isSectionNamePresent(".MaskPE") && PE.compareEP("60")) {
        var entryPointOffset = PE.getEntryPointOffset(),
            entryPointSection = PE.getEntryPointSection(),
            entryPointSectionEndOffset = entryPointSection !== -1 ?
                PE.getSectionFileOffset(entryPointSection) + PE.getSectionFileSize(entryPointSection) : entryPointOffset,
            entryPointSearchSize = Math.min(0x100, entryPointSectionEndOffset - entryPointOffset);

        if (entryPointSearchSize > 0 && PE.isSignaturePresent(entryPointOffset, entryPointSearchSize, "6160e8........8bc33e8b..40e8")) {
            sVersion = "2.0";
            bDetected = true;
        }
    }

    return result();
}