// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:908, 2103)

meta("protector", "12311134");

function detect() {
    // NFD: PE32, not .NET; section name "Xiao"
    if (!PE.is64() && !PE.isNet() && PE.isSectionNamePresent("Xiao")) {
        sOptions = "TEST";
        bDetected = true;
    }

    return result();
}
