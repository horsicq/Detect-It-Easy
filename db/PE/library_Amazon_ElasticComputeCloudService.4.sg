// https://www.nuget.org/packages/AWSSDK.EC2
meta("library", "Amazon Elastic Compute Cloud Service");

function detect() {
    if (PE.isNetObjectPresent("AWSSDK.EC2")) {
        bDetected = true;
    }

    return result();
}