// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/0xROOTPLS/TriProt-Crypter
meta("cryptor", "TriProt");

function detect() {
    if (PE.is64()) return; // Doesn't support x64 binaries

    if (PE.compareEP("E80B030000E906FEFFFFCCCCCCCCCCCC")) {
        bDetected = true;
    }

    return result();
}