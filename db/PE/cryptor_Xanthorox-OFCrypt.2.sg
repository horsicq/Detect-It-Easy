// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/Xanthorox/Xen-OFCrypt
meta("cryptor", "Xanthorox-OFCrypt");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    if (PE.compareEP("4883EC28E8730200004883C428E97AFEFFFFCCCC4883EC48488D4C2420") && PE.getNumberOfImports() === 6 && PE.isLibraryPresent("lizeSListHead") && PE.isLibraryPresent("EnumSystemLocalesA")) {
        sVersion = "1.0";
        bDetected = true;
    }

    return result();
}