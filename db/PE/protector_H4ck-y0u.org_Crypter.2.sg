// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:680, 4627)

meta("protector", "H4ck-y0u.org Crypter");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0x68ec019f4 && nHash32 == 0x182303e5) {
            sOptions = "TEST";
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
