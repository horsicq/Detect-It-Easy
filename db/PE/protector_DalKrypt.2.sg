meta("protector", "DalKrypt");

function detect() {
    if (PE.compareEP("68........5868........5F33DBEB0D8A140380EA0780F2048814034381FB........72EBFFE7")) {
        sVersion = "1.0";
        bDetected = true;
    }

    // Ported from Nauz File Detector "DalKrypt" (SpecAbstract modules/nfd_pe.cpp:368, 930, 1885):
    // PE32, not .NET; entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        if (PE.compareEP("68........5868........5F33DBEB0D8A140380EA0780F2048814034381FB........72EBFFE7")) {
            sVersion = "1.0";
            sOptions = "";
            bDetected = true;
        }
    }

    return result();
}