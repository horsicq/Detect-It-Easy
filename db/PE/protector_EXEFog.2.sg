// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

// https://fuuproject.wordpress.com/2010/07/26/new-fuu-plugin-deexefog/
meta("protector", "ExeFog");

function detect() {
    var entryPointOffset = PE.getEntryPointOffset(),
        entryPointSection = PE.getEntryPointSection(),
        entryPointSectionEndOffset = entryPointSection !== -1 ?
            PE.getSectionFileOffset(entryPointSection) + PE.getSectionFileSize(entryPointSection) : entryPointOffset,
        entryPointSearchSize = Math.min(0x1000, entryPointSectionEndOffset - entryPointOffset);

    if (PE.compareEP("56e8$$$$$$$$5e5ee9$$$$$$$$e8$$$$$$$$5d83c5..55c3") ||
        PE.compareEP("52e8$$$$$$$$83c4..5a8be4510fb6c981e5") ||
        (entryPointSearchSize > 0 && PE.findSignature(entryPointOffset, entryPointSearchSize, "6545c2fb195bbd004040ebef9155f0401897db0024e8e80000008387202e87d17820fb1cb800b0ef0b000000848e") != -1)) {
        sVersion = "1.1";
        bDetected = true;
    }

    // Ported from Nauz File Detector "ExeFog" (SpecAbstract modules/nfd_pe.cpp:545, 546, 2081):
    // PE32, not .NET; import hash, zero time stamp and linker version, BaseOfData 0x1000, first section flags 0xE0000020.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if (PE.getImageFileHeader("TimeDateStamp") == 0 && PE.getImageOptionalHeader("MajorLinkerVersion") == 0 &&
            PE.getImageOptionalHeader("MinorLinkerVersion") == 0 && PE.getImageOptionalHeader("BaseOfData") == 0x1000 &&
            PE.getNumberOfSections() > 0 && (PE.section[0].Characteristics >>> 0) == 0xe0000020) {
            if ((nNfdHash64 == 0x13e215a53 && nNfdHash32 == 0xdf3c1e0)) {
                sVersion = "1.1";
                sOptions = "";
                bDetected = true;
            } else if ((nNfdHash64 == 0x134c8cd1e && nNfdHash32 == 0x29188619)) {
                sVersion = "1.2";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}