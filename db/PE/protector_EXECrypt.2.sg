// Detect It Easy: detection rule file
// Tags: extra

meta("protector", "EXECrypt");

function detect() {
    if (PE.compareEP("909060E8000000005D81ED........B91500000083C10483C101EB05EBFE83C756EB00EB00")) {
        sVersion = "1.0";
        bDetected = true;
    }

    // Ported from Nauz File Detector "EXECrypt" (SpecAbstract modules/nfd_pe.cpp:392, 543, 1946):
    // PE32, not .NET; import hash and entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x13e215a53 && nNfdHash32 == 0xdf3c1e0)) {
            if (PE.compareEP("909060E8000000005D81ED........B91500000083C10483C101EB05EBFE83C756EB00EB00")) {
                sVersion = "1.0";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}
