// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://github.com/obfuscar/obfuscar
meta("protector", "Obfuscar");

function detect() {
    if (PE.isNet() && PE.isNetObjectPresent("Encoding") &&
        PE.isNetObjectPresent("GetString") && PE.isNetObjectPresent("InitializeArray")) {
        for (var i = 0; i < PE.section.length; i++) {
            // This index/XOR-0xaa byte-array loop is shared by historical
            // releases. It does not establish an exact Obfuscar version.
            if (PE.isSignatureInSectionPresent(i, "0691066120AA00000061D29C0617580A")) {
                sOptions = "String hiding";
                bDetected = true;
                break;
            }
        }
    }

    return result();
}
