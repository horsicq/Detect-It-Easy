// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:942, 1607)

// https://enigmaprotector.com/en/aboutvb.html
meta("protector", "Enigma Virtual Box");

function detect() {
    // NFD: section name ".enigma1" or ".enigma2"
    if (PE.isSectionNamePresent(".enigma1") || PE.isSectionNamePresent(".enigma2")) {
        bDetected = true;
    }

    return result();
}
