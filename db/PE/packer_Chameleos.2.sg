// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/W33v3ly/Chameleos
meta("packer", "Chameleos");

function detect() {
    if (PE.isNet()) return; // Doesn't support .NET
    
    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (PE.is32() && PE.compareEP("81EC10") && /^\.(data|pdata|rdata|text|reloc)[0-9]$/.test(lastSection.Name) && lastSection.IsReadWriteExecute && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "..9090........................90")) {
        sVersion = "1.0.0";
        bDetected = true;
    }

    return result();
}