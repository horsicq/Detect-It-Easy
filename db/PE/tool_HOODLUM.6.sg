// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:7440 handle_PETools; record :963 section name, PE32 only)

meta("tool", "HOODLUM");

function detect() {
    if (!PE.is64() && PE.isSectionNamePresent(".HOODLUM")) {
        bDetected = true;
    }

    return result();
}
