// https://github.com/notcpuid/pe-packer
meta("protector", "notcpuid");

function detect() {
    if (PE.getSectionName(PE.nLastSection) === ".ptext" && PE.section[PE.nLastSection].Characteristics === 0xe0000020 && PE.getEntryPointSection() === PE.nLastSection) {
        if (PE.compareEP(PE.is64() ? "554889E55153525657" : "5589E55153525657")) {
            sVersion = "1.0.5";
        } else {
            sVersion = "1.X+";
        }

        bDetected = true;
    }

    return result();
}