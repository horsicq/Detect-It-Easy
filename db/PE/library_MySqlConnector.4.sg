// https://github.com/mysql-net/MySqlConnector
meta("library", "MySQL Connector");

function detect() {
    if (PE.isNetObjectPresent("MySqlConnection") && PE.isNetObjectPresent("MySqlCommand")) {
        bDetected = true;
    }

    return result();
}