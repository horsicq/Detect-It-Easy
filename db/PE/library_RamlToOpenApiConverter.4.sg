// https://github.com/StefH/RamlToOpenApiConverter
meta("library", "RamlToOpenApiConverter");

function detect() {
    if (PE.isNetObjectPresent("RamlToOpenApiConverter")) {
        bDetected = true;
    }

    return result();
}