// https://www.nvidia.com/en-us/geforce/news/dlss5-breakthrough-in-visual-fidelity-for-games/
meta("library", "Nvidia DLSS NR");

function detect() {
    if (PE.isLibraryPresentExp(/_dlssnr/i)) {
        bDetected = true;
    }

    return result();
}