// https://developer.microsoft.com/en-us/windows/downloads/windows-sdk/
meta("library", "DirectX Graphics");

function detect() {
    if (PE.isLibraryPresentExp(/^dxgi/i)) {
        bDetected = true;
    }

    return result();
}