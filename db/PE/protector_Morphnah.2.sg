    // Ported from Nauz File Detector "Morphnah" (SpecAbstract modules/nfd_pe.cpp:462, 464, 466, 642, 979, 1696):
    // PE32, not .NET; entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
