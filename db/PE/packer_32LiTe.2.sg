// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://www.softpedia.com/get/Compression-tools/32LiTE.shtml
meta("packer", "32LiTe");

function detect() {
    if (PE.compareEP("6006FC1E07BE........6A0468........68")) {
        sVersion = "0.03a";
        bDetected = true;
    }

    // Ported from Nauz File Detector "32Lite" (SpecAbstract modules/nfd_pe.cpp:149, 605, 2326):
    // PE32, not .NET; import hash and entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x20953b667 && nNfdHash32 == 0xf053f402)) {
            if (PE.compareEP("6006FC1E07BE........6A0468........68")) {
                sVersion = "0.03a";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}