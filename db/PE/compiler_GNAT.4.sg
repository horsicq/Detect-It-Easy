// Detect It Easy: detection rule file

// https://github.com/horsicq/Detect-It-Easy/issues/331
// GNAT (Ada) binaries carry characteristic strings; without this rule
// they are misidentified as C binaries.
meta("compiler", "GNAT");

function detect() {
    var nCount = 0;

    if (PE.findString(0, PE.getSize(), "GNAT_FILE_NAME_CASE_SENSITIVE") != -1) {
        nCount++;
    }

    if (PE.findString(0, PE.getSize(), "for Ada/dwarf") != -1) {
        nCount++;
    }

    if (PE.findString(0, PE.getSize(), "Ada Core Technologies") != -1) {
        nCount++;
    }

    if (PE.findString(0, PE.getSize(), "ADA.IO_EXCEPTIONS.LAYOUT_ERROR") != -1) {
        nCount++;
    }

    if (PE.findString(0, PE.getSize(), "ADA.STRINGS") != -1) {
        nCount++;
    }

    if (nCount >= 2) {
        bDetected = true;
    }

    sLang = "Ada";

    return result();
}
