// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/ajaniramon/pepsi-packer-ressurrection
meta("packer", "Pepsi Ressurrection");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (lastSection.Name === ".pepsi" && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "'PEPSI64!'") && PE.isTLSPresent() && PE.isSectionNamePresent(".pstub") && PE.isSectionNamePresent(".psimp")) {
        sVersion = "0.8.0";
        bDetected = true;
    }

    return result();
}