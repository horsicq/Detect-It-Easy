// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

meta("protector", "Krypton");

function detect() {
    if (PE.compareEP("8B0C24E90A7C01..AD4240BDBE9D7A04")) {
        sVersion = "0.2";
        bDetected = true;
    } else if (PE.compareEP("8B0C24E9C08D01..C13A6ECA5D7E796DB3645A71EA")) {
        sVersion = "0.3";
        bDetected = true;
    } else if (PE.compareEP("54E8........5D8BC581ED........2B85")) {
        switch (PE.getEntryPointSignature(21, 3)) {
            case "83E806": sVersion = "0.4"; break;
            case "EB43DF": sVersion = "0.5"; break;
        }
        bDetected = true;
    }

    // Ported from Nauz File Detector "Krypton" (SpecAbstract modules/nfd_pe.cpp:271, 272, 273, 274, 550, 970, 971, 972, 2868):
    // PE32, not .NET; import hash and entry point signature.
    // Also used to fill in the version when the rule above found the product without one.
    if ((!bDetected || (!sVersion && !sOptions)) && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x347ecf0ec && nNfdHash32 == 0x4acfe8ec)) {
            if (PE.compareEP("8B0C24E90A7C01..AD4240BDBE9D7A04")) {
                sVersion = "0.2";
                sOptions = "";
                bDetected = true;
            } else if (PE.compareEP("8B0C24E9C08D01..C13A6ECA5D7E796DB3645A71EA")) {
                sVersion = "0.3";
                sOptions = "";
                bDetected = true;
            } else if (PE.compareEP("54E8000000005D8BC581ED........2B85........83E806")) {
                sVersion = "0.4";
                sOptions = "";
                bDetected = true;
            } else if (PE.compareEP("54E8000000005D8BC581ED........2B85........EB")) {
                sVersion = "0.5";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}