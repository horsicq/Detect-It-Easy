// https://curl.se/download.html
meta("library", "Curl");

function detect() {
    if (PE.isLibraryPresentExp(/libcurl/i)) {
        bDetected = true;
    } else if (PE.isExportFunctionPresentExpFastAnchor("curl_easy_", /^curl_easy_/)) {
        sOptions = "static"; // EAT
        bDetected = true;
    }

    return result();
}