// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_pe.cpp:6567-6570, NFD_PE::handle_Borland)
// NFD reports the Turbo linker (without a version) for every non-.NET Borland/CodeGear/Embarcadero Delphi or
// C++ Builder image when the linker was not identified from the header.

meta("linker", "Turbo Linker");

function detect() {
    if (PE.isNet() || _getNumberOfResults("linker") > 0) {
        return;
    }

    if (_isResultPresent("compiler", "Borland Delphi") || _isResultPresent("compiler", "Embarcadero Delphi") ||
        _isResultPresent("compiler", "Borland C++") || _isResultPresent("compiler", "Embarcadero C++") ||
        _isResultPresent("compiler", "CodeGear C++")) {
        bDetected = true;
    }

    return result();
}
