// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/NamePantrer/EXE_Cryptor
meta("cryptor", "BankShield");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    if (PE.compareEP("4883EC28488D0DC5150000E8400F00004531C031D231C9E8540F00004531C0") && PE.isLibraryPresent("msys-2.0.dll") && PE.getNumberOfSections() === 10) {
        sVersion = "2.0";
        bDetected = true;
    }

    return result();
}