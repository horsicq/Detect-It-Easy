// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:673, 4580)

meta("protector", "CRyptOZ");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0x32a797d70b && nHash32 == 0x9ce9bc9d) {
            sVersion = "3";
            sOptions = "TEST";
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
