// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:707, 4838)

meta("protector", "Anskya Polymorphic Packer");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0x120bc5fc6c && nHash32 == 0x50822fc0) {
            sVersion = "1.3";
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
