    // Returns [version, info] of the first matching record of the given kind, or null.
    function find(oRow, sKind) {
        var aList, i;

        if (sKind == "E" || sKind == "H") {
            aList = oRow[sKind] || [];
            for (i = 0; i < aList.length; i++) {
                if (sKind == "E" ? PE.compareEP(aList[i][0]) : PE.compare(aList[i][0], 0)) {
