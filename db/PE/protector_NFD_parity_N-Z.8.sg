    function isReported(oRow) {
        var aNames = oRow.a ? oRow.a : [oRow.n];

        for (var i = 0; i < aNames.length; i++) {
            for (var j = 0; j < aTypes.length; j++) {
                if (_isResultPresent(aTypes[j], aNames[i])) {
                    return true;
                }
            }
        }

        return false;
    }

    function isPositionHash(nPosition, nHash) {
        if (nPosition !== 0xFFFFFFFF) {
            return PE.isImportPositionHashPresent(nPosition, nHash);
        }

        for (var i = 0; i < nNumberOfImports; i++) {
            if (PE.isImportPositionHashPresent(i, nHash)) {
