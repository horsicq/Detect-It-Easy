// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://github.com/DosX-dev/ASM-Guard
meta("protector", "ASM Guard");

function detect() {
    if (PE.isOverlayPresent() && PE.getNumberOfResources() > 12) {
        if (PE.isSectionNamePresent("ASMGUARD")) {
            sVersion = "2.XX";
            sOptions = "shell mutation";
            bDetected = true;
        } else if (PE.isResourceNamePresent("NT.DLL")) {
            bDetected = true;
        } else if (PE.section[0].Name !== ".text" && PE.resource[0].Name === "OBFUSCATE" && PE.compareEP("60")) {
            sVersion = "2.6";
            bDetected = true;
        }
    }

    return result();
}