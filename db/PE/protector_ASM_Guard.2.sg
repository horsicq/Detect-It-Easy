// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://github.com/DosX-dev/ASM-Guard
meta("protector", "ASM Guard");

function detect() {
    if (PE.isOverlayPresent() && PE.getNumberOfResources() > 12) {
        if (PE.isSectionNamePresent("ASMGUARD")) {
            sVersion = "2.XX";
            sOptions = "shell mutation";
            bDetected = true;
        } else if (PE.isResourceNamePresent("NT.DLL")) {
            bDetected = true;
        } else if (PE.section[0].Name !== ".text" && PE.resource[0].Name === "OBFUSCATE" && PE.compareEP("60")) {
            sVersion = "2.6";
            bDetected = true;
        }
    }

    // Ported from Nauz File Detector "ASM Guard" (SpecAbstract modules/nfd_pe.cpp:915, 1850, 1860):
    // not .NET, overlay present; section name "ASMGUARD", or the marker searched at file offset = overlay size (as NFD does).
    if (!bDetected && !PE.isNet()) {
        var nNfdOverlaySize = PE.isOverlayPresent() ? PE.getOverlaySize() : 0;

        if (nNfdOverlaySize > 0) {
            if (PE.isSectionNamePresent("ASMGUARD") ||
                PE.findSignature(nNfdOverlaySize, PE.isDeepScan() ? nNfdOverlaySize : Math.min(nNfdOverlaySize, 0x100), "'asmg-protected'00") != -1) {
                sVersion = "2.XX";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}