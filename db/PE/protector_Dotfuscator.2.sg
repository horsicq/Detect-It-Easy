// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://files-preemptive-com.s3.amazonaws.com/CE6/DotfuscatorCE_6.3.0%2B8b29d6f4a2.vsix
meta("protector", "Dotfuscator");

function detect() {
    if (_getNumberOfResults("protector") <= 2 && PE.isNetObjectPresent("DotfuscatorAttribute")) {
        bDetected = true;
    }

    return result();
}