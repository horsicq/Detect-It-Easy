// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/vertigo-z/obsidian-protector
meta("protector", "obsidian-protector");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (lastSection && lastSection.Name === ".nexus" && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "C34157415641554154565755534883EC") && PE.getNumberOfImports() === 0) {
        sVersion = "1.2-1.5.1";
        bDetected = true;
    } else if (lastSection && lastSection.Name === ".nexus" && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "C36666666666662E0F1F84") && PE.getNumberOfImports() === 0) {
        sVersion = "1.5";
        bDetected = true;
    } else if (lastSection && lastSection.Name === ".nexus" && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "C3900F0B554889E54883EC1048894D10") && PE.getNumberOfImports() === 0) {
        sVersion = "1.4";
        bDetected = true;
    } else if (lastSection && lastSection.Name === ".nexus" && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "554889E548894D10488955184C894520") && PE.getNumberOfImports() === 0) {
        sVersion = "1.0-1.1";
        bDetected = true;
    }

    return result();
}