// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

meta("packer", "mkfPack");

function detect() {
    if (PE.compareEP("e8$$$$$$$$5b81eb........8b93........536a..68........526a..ff93........5b8bf08bbb........03fb5657e8........83c4..8d93........5253ffe6")) {
        bDetected = true;
    }

    // Ported from Nauz File Detector "MKFPack" (SpecAbstract modules/nfd_pe.cpp:823, 2312):
    // PE32, not .NET; import position hash and the marker "llydd" before the PE header.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdLfanew = PE.readDword(0x3c) - 5;

        if (nNfdLfanew > 0 && PE.isImportPositionHashPresent(0, 0x42b3e7f9) && PE.getString(nNfdLfanew, 5) == "llydd") {
            sVersion = sOptions = "";
            bDetected = true;
        }
    }

    return result();
}