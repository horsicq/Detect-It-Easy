// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule dll/obfuscators.yara#beebyte

// https://www.beebyte.co.uk/
meta("obfuscator", "Beebyte");

function detect() {
    // dll/common.yara#is_dll is "pe.characteristics and pe.DLL" (logical and): any PE with non-zero characteristics
    var nPEOffset = PE.read_uint32(0x3C);
    if (PE.read_uint16(nPEOffset + 0x16) !== 0 &&
        PE.findSignature(0, PE.getSize(), "00426565627974652e4f626675736361746f7200") !== -1) { // \0Beebyte.Obfuscator\0
        bDetected = true;
    }

    return result();
}
