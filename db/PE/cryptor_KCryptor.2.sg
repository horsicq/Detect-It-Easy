meta("cryptor", "K!Cryptor");

function detect() {
    if (PE.compareEP("558bec83ec..53565733db53ff15........8b3d........8945..b8........ff30be........56e8........68........6a..e8........83c4..6a..68........5753ffd0")) {
        sVersion = "0.11";
        bDetected = true;
    }

    // Ported from Nauz File Detector "K!Cryptor" (SpecAbstract modules/nfd_pe.cpp:366, 525, 3016):
    // PE32, not .NET; import hash and entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x0b5c121dc && nNfdHash32 == 0x4dbf4081)) {
            if (PE.compareEP("558BEC83EC..53565733DB53FF15........8B3D........8945..B8........FF30BE........56E8........68........6A..E8........83C4..6A..68........5753FFD0")) {
                sVersion = "0.11";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}