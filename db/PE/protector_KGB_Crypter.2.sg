// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:683, 4648)

meta("protector", "KGB Crypter");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0x8fdee2084 && nHash32 == 0x12e6f129) {
            sVersion = "1.0";
            sOptions = "TEST";
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
