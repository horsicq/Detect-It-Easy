meta("packer", "woody_woodpacker");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    if (PE.compareEP("0AC1AE6AAA....42420AC1866AAB..BCBDBD8E8E")) {
        bDetected = true;
    }

    return result();
}