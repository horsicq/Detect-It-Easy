// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/dest4590/gs60-protector
meta("protector", "GS60");

function detect() {
    if (PE.is32()) return; // Doesn't support x86 binaries

    if (PE.compareEP("4883EC28E8B70200004883C428E96EFEFFFFCCCCCCCC") && PE.getNumberOfImports() === 14 && PE.getNumberOfSections() === 8 && PE.isTLSPresent()) {
        bDetected = true;
    }

    return result();
}