// https://www.all-for-rus.narod.ru/files/pack/daemon_crypt_2.0.rar (pass: "all-for-rus.narod.ru")
meta("cryptor", "Daemon Crypt");

function detect() {
    if (PE.getImportLibraryName(0) === "MSVBVM60.DLL" && PE.compareOverlay("'Daemon_Crypt1152'")) {
        sVersion = "2.0 Public";

        if (PE.isImportPositionHashPresent(0, 0x2c52a22e)) {
            bDetected = true;
        } else if (PE.isImportPositionHashPresent(0, 0xa253d95d)) {
            sOptions = "AV killer";
            bDetected = true;
        } else {
            sOptions = "modified";
            bDetected = true;
        }
    }

    return result();
}