// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:300, 2136)

meta("protector", "Advanced UPX Scrammbler");

function detect() {
    // NFD: PE32, not .NET; UPX import position hash (nfd_pe.cpp:811-819) and the entry point signature
    if (!PE.is64() && !PE.isNet()) {
        if (PE.compareEP("B8........B9........803408..E2FAEB")) {
            if (PE.isImportPositionHashPresent(0, 0xd4fdcab1) ||
                PE.isImportPositionHashPresent(0, 0x1d51299a) ||
                PE.isImportPositionHashPresent(0, 0xb3318086) ||
                PE.isImportPositionHashPresent(0, 0x3778aab9) ||
                PE.isImportPositionHashPresent(0, 0xf375ee03) ||
                PE.isImportPositionHashPresent(0, 0xf737d853) ||
                PE.isImportPositionHashPresent(-1, 0x82a048fc) ||
                PE.isImportPositionHashPresent(-1, 0x554a1748)) {
                sVersion = "0.5";
                bDetected = true;
            }
        }
    }

    return result();
}
