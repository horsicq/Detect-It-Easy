// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

meta("protector", "Xenocode");

function detect() {
    if (PE.isNetObjectPresent("Xenocode.Client.Attributes.AssemblyAttributes")) {
        sVersion = "2.X-3.X";
        bDetected = true;
    } else if (PE.isSectionNamePresent(".xcpad") && PE.compareOverlay("'xvm'0001")) {
        bDetected = true;
    }

    // Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:5528): NFD names it "Xenocode Postbuild 2010 for .NET"
    if (!bDetected && PE.getVersionStringInfo("Packager").indexOf("Xenocode Postbuild 2010 for .NET") != -1) {
        sVersion = PE.getVersionStringInfo("PackagerVersion").trim();
        sOptions = "2010 for .NET";
        bDetected = true;
    }

    return result();
}