// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

meta("protector", "CodeVeil");

function detect() {
    if (PE.compareEP("e9$$$$$$$$e9$$$$$$$$8bff60e8$$$$$$$$5ee8")) {
        sVersion = "1.2";
        bDetected = true;
    } else if (PE.isNet()) {
        if (PE.isNetObjectPresent("____KILL")) {
            sVersion = "4.X";
            bDetected = true;
        } else if (PE.isNetUStringPresent("E_TamperDetected")) {
            sVersion = "3.X-4.X";
            bDetected = true;
        }
    }

    // Ported from Nauz File Detector "CodeVeil" (SpecAbstract modules/nfd_pe.cpp:472, 653, 1110, 1118, 5543):
    // PE32; import hash and entry point signature.
    if (!bDetected && !PE.is64()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x16931477 && nNfdHash32 == 0xfcb11e9f)) {
            if (PE.compareEP("E9$$$$$$$$E9$$$$$$$$8BFF60E8$$$$$$$$5EE8")) {
                sVersion = "1.2";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}