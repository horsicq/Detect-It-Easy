// Detect It Easy: detection rule file
// Tags: extra

meta("cryptor", "Sexe Crypter");

function detect() {
    if (PE.compareEP("558BEC83C4EC53565733C08945ECB8........E830FAFFFF33C05568........64FF306489")) {
        sVersion = "1.1";
        bDetected = true;
    }

    // Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:524 _PE_importhash_records): the import hash pair alone, PE32
    if (!bDetected && !PE.is64() && PE.getImportHash64() === 0x144c4ac3f1 && PE.getImportHash32() === 0xb1309fe4) {
        sVersion = "1.1";
        sOptions = "TEST";
        bDetected = true;
    }

    return result();
}
