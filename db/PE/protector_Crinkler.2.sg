// https://github.com/runestubbe/Crinkler
meta("protector", "Crinkler");

function detect() {
    if (PE.compareEP("B9........01C068........6A0058506A005F485DBB03000000BE........E9")) {
        sVersion = "0.1-0.2";
        bDetected = true;
    } else if (PE.compareEP("B8........31DB43EB58")) {
        sVersion = "0.3-0.4";
        bDetected = true;
    }

    // Ported from Nauz File Detector "Crinkler" (SpecAbstract modules/nfd_pe.cpp:127, 361, 842, 2271):
    // PE32, not .NET; import position hash and entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if (PE.isImportPositionHashPresent(0, 0x0b0e1fbf)) {
            if (PE.compareEP("B8........31DB43EB58")) {
                sVersion = "0.3-0.4";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}