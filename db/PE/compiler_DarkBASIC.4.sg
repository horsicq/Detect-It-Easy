// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://github.com/TheGameCreators/Dark-Basic-Pro/releases/download/12.02.16/Dark.Basic.Pro.Binary.120216.zip
meta("compiler", "DarkBASIC Professional");

function detect() {
    if (PE.isOverlayPresent() && PE.isSignaturePresent(PE.getOverlayOffset(), Math.min(2048, PE.getOverlaySize()), "'dbprocore.dll'")) {
        bDetected = true;
    }

    sLang = "DarkBASIC";

    return result();
}