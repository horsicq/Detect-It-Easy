// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://www.sac.sk/download/security/lamecryp.zip
meta("protector", "LameCrypt");

function detect() {
    if (PE.compareEP("60669CBB........80B3........904B83FBFF75F3669D61")) {
        sVersion = "1.0";
        bDetected = true;
    }

    // Ported from Nauz File Detector "LameCrypt" (SpecAbstract modules/nfd_pe.cpp:398, 973, 1900):
    // PE32, not .NET; entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        if (PE.compareEP("60669CBB........80B3........904B83FBFF75F3669D61")) {
            sVersion = "1.0";
            sOptions = "";
            bDetected = true;
        }
    }

    return result();
}