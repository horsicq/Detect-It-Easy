// https://github.com/YUICompressor-NET/YUICompressor.NET
meta("library", "YUICompressor.NET");

function detect() {
    if (PE.isNetObjectPresent("Yahoo.Yui.Compressor")) {
        bDetected = true;
    }

    return result();
}