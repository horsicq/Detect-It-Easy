// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/jadams/Packer64
meta("packer", "Packer64");

function detect() {
    if (PE.is32()) return; // Doesn't support x86 binaries

    if (PE.compareEP("4883EC28E8970700004883C428E96EFEFFFFCCCCCCCC") && PE.getNumbersOfImports() === 11) {
        bDetected = true;
    }

    return result();
}