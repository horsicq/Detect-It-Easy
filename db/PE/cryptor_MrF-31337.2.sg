// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/MrF-31337/PE-cryptor
meta("cryptor", "MrF-31337");

function detect() {
    if (PE.is64()) return; // Doesn't support x64

    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (lastSection.Name === ".centry" && lastSection.IsReadWriteExecute && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "68......006068")) {
        bDetected = true;
    }

    return result();
}