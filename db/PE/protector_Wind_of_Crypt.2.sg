// Detect It Easy: detection rule file
// Tags: extra

meta("protector", "Wind of Crypt");

function detect() {
    if (PE.compareEP("558BEC83C4EC53........8945ECB8........E828EAFFFF33C05568")) {
        sVersion = "1.0";
        bDetected = true;
    }

    // Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:524 _PE_importhash_records): the import hash pair alone, PE32
    if (!bDetected && !PE.is64() && PE.getImportHash64() === 0x124c114b87 && PE.getImportHash32() === 0xf7c9cbe1) {
        sVersion = "1.0";
        bDetected = true;
    }

    return result();
}
