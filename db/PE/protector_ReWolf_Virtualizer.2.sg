// https://github.com/rwfpl/rewolf-x86-virtualizer
meta("protector", "ReWolf Virtualizer");

function detect() {
    if (!PE.is64() && PE.compareEP("E8000000005B") && PE.section[PE.nLastSection].Name === ".VM") {
        bDetected = true;
    }

    return result();
}