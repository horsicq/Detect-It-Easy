// https://github.com/arsium/Packter
meta("packer", "Packter");

function detect() {
    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (PE.compareEP("55B9600000004889E541574156") && PE.isSectionNamePresent(".pack") && lastSection.Name === ".stub") {
        bDetected = true;
    }

    return result();
}