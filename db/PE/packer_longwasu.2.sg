// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/longwasu/PE_Packer
meta("packer", "longwasu");

function detect() {
    if (PE.is64()) return; // Doesn't support x64 binaries

    if (PE.isSectionNamePresent(".packed") && PE.isRichSignaturePresent() && PE.compareEP("E8C5030000E974FEFFFF558BEC6A00FF1510204000FF7508FF153C204000")) {
        bDetected = true;
    }

    return result();
}