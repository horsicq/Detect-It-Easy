// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:83, 577, 2582)

meta("protector", "Hmimys's Protector");

function detect() {
    // NFD: PE32, not .NET; import hash and the marker in the DOS header
    if (!PE.is64() && !PE.isNet()) {
        if (PE.getImportHash64() == 0x1db028dca && PE.getImportHash32() == 0x50ca53fc) {
            if (PE.compare("'MZ'............................................................'hmimys'27's ProtectV0.1'")) {
                sVersion = "0.1";
                bDetected = true;
            }
        }
    }

    return result();
}
