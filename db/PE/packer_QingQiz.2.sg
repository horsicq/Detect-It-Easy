// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/QingQiz/PEPacker
meta("packer", "QingQiz");

function detect() {
    if (PE.is32()) return; // Dosen't support x86

    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (lastSection && lastSection.Name === ".packed" && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "180FC5555655555551555555AAAA5555")) {
        bDetected = true;
    }

    return result();
}