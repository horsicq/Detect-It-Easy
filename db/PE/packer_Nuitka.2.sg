// https://github.com/Nuitka/Nuitka
meta("packer", "Nuitka");

function nuitkaRipTarget(text, displacement) {
    return text.VirtualAddress + displacement - text.FileOffset + 4 + PE.read_int32(displacement);
}

// MSVC x64 initializes the generated PyStructSequence descriptor and writes
// major, minor and micro using the same integer constructor and SetItem slot.
function nuitkaReadVersionAt(text, start, marker) {
    var end = text.FileOffset + text.FileSize,
        descriptorRva = nuitkaRipTarget(text, start + 3),
        descriptor = PE.RVAToOffset(descriptorRva);
    if (descriptor < 0 || PE.RVAToOffset(descriptorRva + 23) !== descriptor + 23 ||
        Binary.read_uint64(descriptor) !== PE.OffsetToVA(marker)) return "";

    var docAddress = Binary.read_uint64(descriptor + 8),
        docOffset = PE.VAToOffset(docAddress);
    if (docOffset < 0 || PE.VAToOffset(docAddress + 35) !== docOffset + 35 ||
        !PE.compare("'__compiled__'5C6E5C6E'Version information'", docOffset)) return "";
    if (nuitkaRipTarget(text, start + 10) !== nuitkaRipTarget(text, start + 23)) return "";

    var cursor = start + 33, tupleStorage = -1, makeInt = -1, setItem = -1, values = [];
    for (var index = 0; index < 3; index++) {
        if (cursor + 38 > end) return "";

        var value;
        if (PE.read_uint8(cursor) === 0xb9) {
            value = PE.read_uint32(cursor + 1);
            cursor += 5;
        } else if (PE.compare("33C9", cursor)) {
            value = 0;
            cursor += 2;
        } else {
            return "";
        }
        if (value > 99 || (index === 0 && value === 0)) return "";

        if (index === 0) {
            if (!PE.compare("488905", cursor)) return "";
            tupleStorage = nuitkaRipTarget(text, cursor + 3);
            cursor += 7;
        }

        if (!PE.compare("E8........488B0D........4C8BC0", cursor)) return "";
        var intTarget = nuitkaRipTarget(text, cursor + 1);
        if (intTarget < text.VirtualAddress || intTarget >= text.VirtualAddress + text.FileSize ||
            (index !== 0 && intTarget !== makeInt) || nuitkaRipTarget(text, cursor + 8) !== tupleStorage) return "";
        makeInt = intTarget;
        cursor += 15;

        if (index === 0) {
            if (!PE.compare("33D2", cursor)) return "";
            cursor += 2;
        } else {
            if (PE.read_uint8(cursor) !== 0xba || PE.read_uint32(cursor + 1) !== index) return "";
            cursor += 5;
        }
        if (!PE.compare("FF15", cursor)) return "";
        var itemTarget = nuitkaRipTarget(text, cursor + 2);
        if (index !== 0 && itemTarget !== setItem) return "";
        setItem = itemTarget;
        cursor += 6;
        values.push(value);
    }

    // Only a release is an exact version: the tuple has no candidate number.
    if (cursor + 34 > end || !PE.compare("488D0D........FF15........488B0D........BA030000004C8BC0FF15", cursor) ||
        nuitkaRipTarget(text, cursor + 16) !== tupleStorage || nuitkaRipTarget(text, cursor + 30) !== setItem) return "";

    var levelRva = nuitkaRipTarget(text, cursor + 3),
        levelOffset = PE.RVAToOffset(levelRva);
    if (levelOffset < 0 || PE.RVAToOffset(levelRva + 7) !== levelOffset + 7 || !PE.compare("'release'00", levelOffset)) return "";

    return values[0] + "." + values[1] + (values[2] ? "." + values[2] : "");
}

function nuitkaReadVersion(data) {
    if (PE.getImageFileHeader("Machine") !== 0x8664 || !PE.is64()) return "";

    var text = PE.section[".text"];
    if (!text) return "";

    var marker = PE.findSignature(data.FileOffset, data.FileSize, "'__nuitka_version__'00");
    if (marker === -1) return "";

    var cursor = text.FileOffset, end = cursor + text.FileSize;
    while (cursor + 33 <= end) {
        var start = PE.findSignature(cursor, end - cursor, "488D15........488D0D........FF15........488D0D........FF15........");
        if (start === -1) break;
        var version = nuitkaReadVersionAt(text, start, marker);
        if (version) return version;
        cursor = start + 1;
    }
    return "";
}

function nuitkaIsOnefile(data) {
    var marker = "NUITKA_ONEFILE_PARENT";
    if (data.FileSize < marker.length || !PE.isFunctionPresent("CreateProcessW")) return false;

    // Try the bootstrap strings near the end of .rdata before scanning the payload.
    var tailSize = Math.min(data.FileSize, 0x10000);
    return PE.findString(data.FileOffset + data.FileSize - tailSize, tailSize, marker) !== -1 ||
           (tailSize < data.FileSize && PE.findString(data.FileOffset, data.FileSize, marker) !== -1);
}

function detect() {
    var data = PE.section[".rdata"];
    if (data) {
        if (PE.isLibraryPresentExp(/^python/i) &&
            PE.findString(data.FileOffset, data.FileSize, "__nuitka_version__") !== -1) {
            bDetected = true;
            sVersion = nuitkaReadVersion(data);
        } else if (nuitkaIsOnefile(data)) {
            bDetected = true;
            sOptions = "OneFile";
        }
    }

    sLang = "Python";
    return result();
}
