includeScript("python");

// https://github.com/Nuitka/Nuitka
meta("packer", "Nuitka");

function detect() {
    var dataSection = PE.section[".rdata"];

    if (dataSection) {
        var dataSectionOffset = dataSection.FileOffset,
            dataSectionSize = dataSection.FileSize;

        var pythonRuntimeLibraryName = PE.isLibraryPresentExp(/^python/i);

        if (pythonRuntimeLibraryName && PE.findString(dataSectionOffset, dataSectionSize, "__nuitka_version__") !== -1) {
            sVersion = getPythonVersionByDll(pythonRuntimeLibraryName);
            bDetected = true;
        } else if (PE.findString(dataSectionOffset, dataSectionSize, "NUITKA_ONEFILE_PARENT") !== -1) {
            sOptions = "OneFile";
            bDetected = true;
        }
    }

    sLang = "Python";

    return result();
}