// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/xvillie/PE-Runtime-Packer
meta("packer", "PE Runtime Packer");

function detect() {
    if (PE.is32()) return; // Doesn't support x86 binaries

    if (PE.compareEP("65488B042560000000488B4010488DB000100000B9........B3..301E48FFC6FFC9")) {
        bDetected = true;
    }

    return result();
}