// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/0XE1P/BlindSpot-Framework
meta("cryptor", "BlindSpot");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    if (PE.compareEP("56534883EC78E85516000085C00F85DD000000B92B1963C4E8D3040000") && PE.getNumberOfImports() === 0 && PE.getNumberOfSections() === 8) {
        sVersion = "3.2";
        bDetected = true;
    }

    return result();
}