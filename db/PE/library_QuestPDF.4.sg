// https://github.com/QuestPDF/QuestPDF
meta("library", "QuestPDF");

function detect() {
    if (PE.isNetObjectPresent("IDocument") && PE.isNetObjectPresent("IDocumentContainer")) {
        bDetected = true;
    }

    return result();
}