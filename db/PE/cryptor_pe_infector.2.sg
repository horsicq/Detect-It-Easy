// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/m4rm0k/pe_infector
meta("cryptor", "pe_infector");

function detect() {
    if (PE.is64()) return; // Doesn't support x64

    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (PE.compareEP("60558BEC81EC00020000E83B0000008BD86A0053") && lastSection && lastSection.Name === ".inject" && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "60558BEC81EC00020000E83B0000008B")) {
        bDetected = true;
    }

    return result();
}