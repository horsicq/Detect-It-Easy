// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:947, 2796)

meta("protector", "!EProt");

function detect() {
    // NFD: PE32, not .NET; section name "!eprot"
    if (!PE.is64() && !PE.isNet() && PE.isSectionNamePresent("!eprot")) {
        sVersion = "0.01";
        bDetected = true;
    }

    return result();
}
