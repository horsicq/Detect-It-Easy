// https://www.greenxf.com/soft/29156.html
meta("protector", "EsProtect");

function detect() {
    if (PE.getNumberOfSections() > 3 &&
        PE.compareEP("F9") &&
        PE.getRelocsSection() === PE.nLastSection &&
        PE.getEntryPointSection() === PE.nLastSection &&
        PE.getResourceSection() === 2 &&
        PE.getImportSection() === 2) {
        sVersion = "1.3-3.9, custom UPX";
        bDetected = true;
    }

    if (bDetected) {
        if (PE.section[0].Name !== "Esp0" || PE.section[1].Name !== "Esp1" || !PE.section[PE.nLastSection].Name.match(/^\.Esp[! ]$/)) {
            sOptions = "modified";
        }
    }

    return result();
}