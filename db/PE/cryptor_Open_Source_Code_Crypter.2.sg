// Detect It Easy: detection rule file
// Tags: extra

meta("cryptor", "Open Source Code Crypter"); // ????????

function detect() {
    if (PE.compareEP("558BECB9090000006A006A004975F9535657B8........E828F8FFFF33C05568")) {
        bDetected = true;
    }

    // Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:524 _PE_importhash_records): the import hash pair alone, PE32
    if (!bDetected && !PE.is64() && PE.getImportHash64() === 0x1e843722ad && PE.getImportHash32() === 0x6061e509) {
        sVersion = "1.0";
        sOptions = "TEST";
        bDetected = true;
    }

    return result();
}
