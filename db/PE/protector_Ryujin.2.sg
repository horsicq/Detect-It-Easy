// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/keowu/Ryujin
meta("protector", "Ryujin");

function detect() {
    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (lastSection.Name === ".Ryujin" && lastSection.IsReadWriteExecute) {
        bDetected = true;
    }

    return result();
}