// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/owerosu/packerPE32
meta("packer", "packerPE32");

function detect() {
    if (PE.is64()) return; // Doesn't support x64 binaries

    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (PE.compareEP("E81B030000E906FEFFFFCCCCCCCCCCCC") && PE.isSectionNamePresent(".pack3") && lastSection.Name === ".pack4") {
        bDetected = true;
    }

    return result();
}