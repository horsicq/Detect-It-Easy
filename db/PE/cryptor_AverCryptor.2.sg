// Detect It Easy: detection rule file

// Author: DosX
// GitHub: https://github.com/DosX-dev
// Website: https://dosx.su
// Telegram: @DosX_dev

// https://web.archive.org/web/20071012084924/http://secnull.org/
meta("cryptor", "AverCryptor");

function detect() {
    if (PE.compareEP("60E8000000005D81ED........8BBD........8B8D........B8")) {
        bDetected = true;

        switch (PE.readByte(PE.getEntryPointOffset() + 65)) {
            case 0xFA: sVersion = "1.0"; break;
            case 0xF7: sVersion = "1.02";
        }

        if (!PE.isSectionNamePresent(".avc")) {
            sOptions = "modified";
        }
    }

    // Ported from Nauz File Detector "AverCryptor" (SpecAbstract modules/nfd_pe.cpp:335, 919, 2116):
    // PE32, not .NET; entry point signature and section name ".avc".
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        if (PE.isSectionNamePresent(".avc")) {
            if (PE.compareEP("60E8000000005D81ED........8BBD........8B8D........B8")) {
                sVersion = "1.XX";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}