// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:677, 4604)

meta("protector", "Fast File Crypt");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0x54fe70e1c && nHash32 == 0x12125e9a) {
            sVersion = "1.6";
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
