// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/coleak2021/PE64shell
meta("packer", "PE64shell");

function detect() {
    if (PE.isNet()) return; // Doesn't support .NET

    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (lastSection.Name === ".coleak" && lastSection.IsReadWriteExecute && PE.getNumberOfImports() === 0) {
        bDetected = true;
    }

    return result();
}