// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/makes3nse/Blue-Lagoon-Crypter
meta("cryptor", "Blue Lagoon");

function detect() {
    if (PE.isNetObjectPresent("WordsAreCool") && PE.isNetObjectPresent("LogEncryptionResult") && PE.isNetObjectPresent("LogDecryptedBase64")) {
        sVersion = "1.0.0";
        bDetected = true;
    }

    return result();
}