// https://revteam.re/forum/threads/r-scs-process-patcher-source-code-modified.2477/
meta("patcher", "R!SC Process Patcher");

function detect() {
    if (PE.compareEP("68........c705................68........68........6a..6a..6a..6a..6a..6a..6a..68........e8")) {
        sVersion = "1.X";
        sOptions = "by R!SC";
        bDetected = true;
    }

    return result();
}