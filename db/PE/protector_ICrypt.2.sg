// Detect It Easy: detection rule file
// Tags: extra

meta("protector", "ICrypt");

function detect() {
    if (PE.compareEP("558BEC83C4EC53565733C08945ECB8703B0010E83CFAFFFF33C055686C3C00")) {
        sVersion = "1.0";
        bDetected = true;
    }

    // Ported from Nauz File Detector "ICrypt" (SpecAbstract modules/nfd_pe.cpp:714, 4894):
    // PE32; import hash.
    if (!bDetected && !PE.is64()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x151f5b424a && nNfdHash32 == 0xdc6b4478)) {
            sVersion = "1.0";
            sOptions = "";
            bDetected = true;
        }
    }

    return result();
}
