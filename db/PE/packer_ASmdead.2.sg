// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/4D4J/Custom-PE-Packer
meta("packer", "ASmdead");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (lastSection && lastSection.Name === ".stub" && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "EFBEADDE") && PE.getNumberOfImports() === 0 && PE.getNumberOfResources() === 0) {
        bDetected = true;
    }

    return result();
}