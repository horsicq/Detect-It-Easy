// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://secureteam.net/acode-download
meta("protector", "Agile");

function detect() {
    if (_getNumberOfResults("protector") <= 2 && (
        PE.isNetObjectPresent("ObfuscatedByAgileDotNetAttribute") ||
        PE.isNetObjectPresent("<AgileDotNetRT>") ||
        PE.isNetObjectPresent("AgileDotNetRT.dll") ||
        PE.isNetObjectPresent("AgileDotNetRT64.dll")
    )) {
        bDetected = true;
    }

    return result();
}