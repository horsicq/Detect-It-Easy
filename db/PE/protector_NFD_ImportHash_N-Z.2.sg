// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:524 _PE_importhash_records,
// :4492 handle_VisualBasicCryptors, :4811 handle_DelphiCryptors)
// Products N-Z that NFD reports from the import hash pair alone (PE32 only).
// Each row: name, version, info, hash64, hash32. The first matching row of a name wins, as in NFD.

meta("protector", "NFD import hash cryptors (N-Z)");

function detect() {
    if (PE.is64()) {
        return;
    }

    var aRecords = [
        ["WingsCrypt", "1.0", "TEST", 0x216906261a, 0x86d73370],
        ["TsT Crypter", "1.0", "TEST", 0x216906261a, 0x86d73370],
        ["Turkojan Crypter", "1.0", "TEST", 0x216906261a, 0x86d73370],
        ["Whitell Crypt", "", "TEST", 0x27e360241a, 0x69740a38],
        ["PussyCrypter", "1.0", "TEST", 0x27e360241a, 0x69740a38],
        ["ZeldaCrypt", "1.0", "", 0x27e360241a, 0xffacb503],
        ["noX Crypt", "1.1", "", 0x36d2a71d08, 0x9b536657],
        ["SmokeScreen Crypter", "2.0", "TEST", 0x87606a2bd, 0xcfe4cd48],
        ["Snoop Crypt", "1.0", "TEST", 0x8bb735ad5, 0x22823ed8],
        ["StasFodidoCryptor", "1.0", "TEST", 0x339880106, 0xe8805018],
        ["Turkish Cyber Signature", "1.0", "TEST", 0x216ef51472, 0xfaacabe5],
        ["UnDo Crypter", "1.0", "TEST", 0x37b90cd5a, 0xaab92c4c],
        ["WL-Crypt", "1.0", "", 0xeaeea9a42, 0x0f0642ae],
        ["WouThrs EXE Crypter", "1.0", "", 0x1d8a9e5e20, 0xc9e08d88],
        ["RoguePack", "1.1", "TEST", 0xbb132a76d, 0xe23394a8],
        ["RoguePack", "3.3.1", "TEST", 0x855d9788c, 0x96ed2351],
        ["UnderGround Crypter", "1.0", "", 0x14921fe579, 0x06dfef0b],
        ["Nidhogg", "1.0", "TEST", 0xda5d3bb1f, 0xa52e27cc],
        ["NME", "1.1", "TEST", 0x84313106b, 0x8d73a5b4],
        ["OSC-Crypter", "", "TEST", 0x1e67f9aa68, 0xc45e88cf],
        ["p0ke Scrambler", "1.2", "TEST", 0x14017ccc57, 0x6766361e],
        ["Pandora", "1.0", "TEST", 0x1aa111e7ea, 0x5ee89fbb],
        ["PFE CX", "0.1", "", 0x37c8dbb1e7, 0x161cb3f4],
        ["PI Cryptor", "3.0", "", 0x22d7f64fb1, 0xfcde90f0],
        ["Poke Crypter", "", "TEST", 0x3abfae0702, 0xb99acbcc],
        // NFD's placeholder row: 0xFFFFFFFFFF is not its 0xFFFFFFFF wildcard, so the 64-bit hash must equal it.
        ["Pub Crypter", "", "TEST", 0xFFFFFFFFFF, -1],
        ["Sim Crypter", "", "TEST", 0x10c6960150, 0x3070a531],
        ["Simple Crypter", "1.2", "TEST", 0x23932eb2ab, 0x01e5337f],
        ["TGR Crypter", "1.0", "TEST", 0x1a0adc8c41, 0xc26df3a5],
        ["The Zone Crypter", "", "TEST", 0x316e900676, 0x67850921],
        ["unkOwn Crypter", "1.0", "", 0x19d3b4b92a, 0xeb51c252],
        ["WL-Group Crypter", "", "", 0x13bf0f6720, 0xb0f58a0d]
    ];

    var nHash64 = PE.getImportHash64(),
        nHash32 = PE.getImportHash32(),
        sDone = "|";

    for (var i = 0; i < aRecords.length; i++) {
        var aRecord = aRecords[i];

        if (aRecord[3] === nHash64 && (aRecord[4] === -1 || aRecord[4] === nHash32) && sDone.indexOf("|" + aRecord[0] + "|") === -1) {
            sDone += aRecord[0] + "|";
            _setResult("protector", aRecord[0], aRecord[1], aRecord[2]);
        }
    }

    return;
}
