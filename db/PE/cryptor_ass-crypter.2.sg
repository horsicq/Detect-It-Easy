// Detect It Easy: detection rule file
// Tags: extra

meta("cryptor", "ass-crypter");

function detect() {
    if (PE.compareEP("558BEC83C4EC53........8945ECB898400010E8ACEAFFFF33C055687851001064........206A0A6888510010A1E097001050E8D8EAFFFF8BD853A1E097001050E812EBFFFF8BF853A1E097001050E8DCEAFFFF8B")) {
        bDetected = true;
    }

    // Ported from Nauz File Detector "Ass Crypter" (SpecAbstract modules/nfd_pe.cpp:705, 4817):
    // PE32; import hash.
    if (!bDetected && !PE.is64()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x12d94ca858 && nNfdHash32 == 0x36fb88c9)) {
            sVersion = "1.0";
            sOptions = "TEST";
            bDetected = true;
        }
    }

    return result();
}
