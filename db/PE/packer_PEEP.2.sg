// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/moligarch/PEEP
meta("packer", "PE Enhanced Packer (PEEP)");

function detect() {
    if (PE.is32()) return; // Doesn't support x86 binaries

    var packedSection = PE.section[".packed"];

    if (packedSection && PE.isSignaturePresent(packedSection.FileOffset, packedSection.FileSize, "'PKR2'02")) {
        bDetected = true;
    }

    return result();
}