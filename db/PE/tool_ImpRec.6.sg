// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/trietptm/Import_REConstructor-Archive
meta("tool", "ImpRec")

function detect() {
    var macktSection = PE.section[".mackt"];

    if (macktSection && macktSection.hasFlags(0xE0000060)) {
        sOptions = "reconstructed dump";
        bDetected = true;
    }

    return result();
}