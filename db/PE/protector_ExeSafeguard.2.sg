// https://github.com/DosX-dev/ExeSafeGuard-archived
meta("protector", "ExeSafeguard");

function detect() {
    // The loader starts with randomized junk, but the packer always adds a .sg section and replaces the import table.
    if (!PE.isNet() && !PE.is64() && PE.nLastSection >= 1 && PE.section[PE.nLastSection].Name === ".sg" &&
        PE.section[PE.nLastSection].Flags === 0xE0000020 && PE.getEntryPointSection() === PE.nLastSection &&
        PE.getAddressOfEntryPoint() === PE.section[PE.nLastSection].VirtualAddress && PE.getImportSection() === PE.nLastSection &&
        PE.getNumberOfImports() === 1 && PE.isLibraryPresent("Advapi32.dll") && PE.getNumberOfImportThunks(0) === 1 &&
        PE.getImportFunctionName(0, 0) === "RegOpenKeyA") {
        sVersion = "1.0";
        bDetected = true;
    }

    return result();
}