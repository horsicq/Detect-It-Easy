// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:711, 4872)

meta("protector", "fEaRz Packer");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0xbeb44c9f3 && nHash32 == 0xf7a7ee23) {
            sVersion = "0.3";
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
