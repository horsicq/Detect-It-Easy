// https://github.com/TalosSec/Cronos-Crypter
meta("cryptor", "CronosCrypter");

function detect() {
    if (PE.isNet() && PE.getNetAssemblyName().indexOf("Cronos-Crypter") === 0) {
        bDetected = true;
    }

    return result();
}
