// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:584, 2130)

meta("protector", "AffilliateEXE");

function detect() {
    // NFD: PE32, not .NET; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64() && !PE.isNet()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0xaad68a6e94 && nHash32 == 0xe7046691) {
            sVersion = "1.0";
            sOptions = "TEST";
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
