// https://github.com/DosX-dev/obfus.h
meta("protection", "obfus.h");

function detect() {
    if (PE.getCompilerVersion() !== "6.0") return;

    if (PE.isSectionNamePresentExp(/^\.obfh(?:[0-9]{2})?$/) || PE.isExportFunctionPresent("WhatSoundDoesACowMake")) {
        bDetected = true;
    }

    sLang = "C";

    return result();
}
