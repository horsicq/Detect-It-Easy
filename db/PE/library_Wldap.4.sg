// https://www.nirsoft.net/dll_information/windows8/wldap32_dll.html
meta("library", "Win32 LDAP API");

function detect() {
    if (PE.isLibraryPresent("Wldap32.dll")) {
        bDetected = true;
    }

    return result();
}