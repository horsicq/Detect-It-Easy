// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/egebilecen/yugami
meta("packer", "Yugami");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    if (PE.compareEP("4883EC28E8B70200004883C428E96EFEFFFFCCCCCCCC") && PE.isTLSPresent() && PE.getNumberOfImports() === 12 && PE.isLibraryPresent("bcryptprimitives.dll")) {
        bDetected = true;
    }

    return result();
}