// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/toxicmouse7/PePacker
meta("packer", "toxicmouse7");

function detect() {
    if (PE.is64()) return; // Doesn't support x64 binaries

    var packedSection = PE.section[".packed"];

    if (packedSection && PE.isSignaturePresent(packedSection.FileOffset, packedSection.FileSize, "E8000000005E83EE058BFE81E60000FF")) {
        bDetected = true;
    }

    return result();
}