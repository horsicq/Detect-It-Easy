// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:708, 4846)

meta("protector", "AnslymPacker");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0xaf2e74867b && nHash32 == 0x51a4c42b) {
            sOptions = "TEST";
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
