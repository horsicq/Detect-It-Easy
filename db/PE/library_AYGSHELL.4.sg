// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://inthehand.com/2006/08/25/windows-mobile-context-menu-behaviour-on-windows-ce
meta("library", "Yet Another Gryphon Shell");

function detect() {
    if (PE.isLibraryPresent("AYGSHELL.dll")) {
        bDetected = true;
    }

    return result();
}