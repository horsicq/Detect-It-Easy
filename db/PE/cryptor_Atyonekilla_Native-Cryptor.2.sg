// https://github.com/atyonekilla/Native-Cryptor
meta("cryptor", "Atyonekilla Native-Cryptor");

function detect() {
    if (PE.getNumberOfImports() === 1 && PE.isImportPositionHashPresent(0, 0x4d0979fc)) {
        bDetected = true;
    }

    return result();
}