// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:687, 4683)

meta("protector", "Lightning Crypter ScanTime");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0x24bfbff151 && nHash32 == 0xea84dab2) {
            sVersion = "1.0";
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
