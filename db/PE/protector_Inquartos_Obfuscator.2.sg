// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

meta("protector", "Inquartos Obfuscator");

function detect() {
    if (PE.compareEP("e8$$$$$$$$bb........e8$$$$$$$$e8$$$$$$$$33c064ff306489204bccc3") && PE.isSectionNamePresent(".inq")) {
        bDetected = true;
    }

    // Ported from Nauz File Detector "Inquartos Obfuscator" (SpecAbstract modules/nfd_pe.cpp:628, 964, 2382):
    // PE32, not .NET; import hash, section name ".inq" and a generic tiny header.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if (PE.isSectionNamePresent(".inq") && PE.compare("'MZ'....................'PE'0000")) {
            if ((nNfdHash64 == 0x1046a0029 && nNfdHash32 == 0xf3f52749)) {
                sVersion = "";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}