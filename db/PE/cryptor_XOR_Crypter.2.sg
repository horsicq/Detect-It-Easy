// https://github.com/rootm0s/Protectors
meta("cryptor", "XOR_Crypter");

function detect() {
    if (PE.is64()) return; // Doesn't support x64

    if (PE.compareEP("E90ED00000E909450000E964F60000E9BFBD0000E91A680000E975860000E920B60000E95B370000") && PE.isLibraryPresent("ucrtbased.dll") && PE.getNumberOfImports() === 4) {
        bDetected = true;
    }

    return result();
}