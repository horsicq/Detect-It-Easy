// Detect It Easy: detection rule file

// // https://www.all-for-rus.narod.ru/files/pack/armp_0.3.rar (pass: "all-for-rus.narod.ru")
meta("protector", "ARM Protector");

function detect() {
    if (PE.getNumberOfImports() === 0 && PE.compareEP("E8040000008360EB0C5DEB05")) {
        switch (PE.readDword(PE.nEP + 42)) {
            case 0xAB3: sVersion = "0.5"; break;
            case 0xBA1: sVersion = "0.6"; break;
            default:
                sVersion = "0.1b-0.3b";
        }
        bDetected = true;
    }

    if (bDetected && !PE.isSectionNamePresent(".armp")) {
        sOptions = "modified";
    }

    return result();
}