// Detect It Easy: detection rule file
// Author: Eliseu Filipi

// https://exe-password-protector.soft112.com/
meta("protector", "EXE Password Protector");

function detect() {
    if (PE.compareEP("6A606810B54000E82E020000BF940000008BC7E822F4FFFF8965E88BF4893E56FF1510B040008B4E10890D00ED40008B4604")) {
        sVersion = "1.1";
        bDetected = true;
    }

    // Ported from Nauz File Detector "EXE Password Protector" (SpecAbstract modules/nfd_pe.cpp:394, 655, 1955):
    // PE32, not .NET; import hash and entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x30309e68ce && nNfdHash32 == 0x56ce963e)) {
            if (PE.compareEP("6A606810B54000E82E020000BF940000008BC7E822F4FFFF8965E88BF4893E56FF1510B040008B4E10890D00ED40008B4604")) {
                sVersion = "1.1";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}