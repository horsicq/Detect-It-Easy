// Detect It Easy: detection rule file
// Author: KDSS-Research

// https://github.com/aaaddress1/theArk
meta("packer", "theArk");

function detect() {
    if (PE.is64()) return; // Doesn't support x64 binaries

    if (PE.isSectionNamePresent("adr") && PE.isSectionNamePresent("have") && PE.isSectionNamePresent("30cm") && PE.isSectionNamePresent(".tw")) {
        bDetected = true;
    }

    return result();
}