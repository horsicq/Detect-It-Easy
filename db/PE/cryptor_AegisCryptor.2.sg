// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/NandaKyaw01/AegisCrypt
meta("cryptor", "AegisCryptor");

function detect() {
    if (PE.is32() && PE.compareEP("60BE....43008DBE00....FF57EB0B908A0646") && PE.getNumberOfImports() === 5 && PE.getNumberOfSections() === 3 && PE.isLibraryPresent("MFC42.dll")) { // UPX (3.05) sections
        sVersion = "2017";
        bDetected = true;
    }

    return result();
}