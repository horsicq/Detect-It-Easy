// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:3148 handle_TTProtect)

meta("protector", "TTprotect");

function detect() {
    if (!PE.isNet()) {
        var nEPSection = PE.getEntryPointSection();

        if (nEPSection > 0 && PE.section[nEPSection] && PE.section[nEPSection].Name == ".TTP") {
            if (PE.isImportPositionHashPresent(0, 0xf3f52749)) {
                bDetected = true;
            }
        }
    }

    return result();
}
