// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://compression.ru/arctest/self/cexe.htm
meta("packer", "CExe");

function detect() {
    if (PE.compareEP("558BEC81EC0C02....56BE........8D85F8FEFFFF56506A..FF15........8A8DF8FEFFFF33D284C98D85F8FEFFFF7416")) {
        sVersion = "1.0a";
        bDetected = true;
    }

    // Ported from Nauz File Detector "CExe" (SpecAbstract modules/nfd_pe.cpp:372, 638, 639, 640, 3009):
    // PE32, not .NET; import hash.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0xcda93f5a0 && nNfdHash32 == 0x6ad5f3a1)) {
            sVersion = "1.0";
            sOptions = "";
            bDetected = true;
        } else if ((nNfdHash64 == 0xd97446c35 && nNfdHash32 == 0x95065b94)) {
            sVersion = "1.0";
            sOptions = "";
            bDetected = true;
        } else if ((nNfdHash64 == 0xc45e50e8a && nNfdHash32 == 0x55e66552)) {
            sVersion = "1.0";
            sOptions = "";
            bDetected = true;
        }
    }

    return result();
}