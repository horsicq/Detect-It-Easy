// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:585, 974, 3103)

meta("protector", "lARP64");

function detect() {
    // NFD: PE64, not .NET; import hash and section name ".LARP"
    if (PE.is64() && !PE.isNet()) {
        if (PE.getImportHash64() == 0x1a89b5f0f && PE.getImportHash32() == 0xf44517d8) {
            if (PE.isSectionNamePresent(".LARP")) {
                sVersion = "1.0.3";
                sOptions = "TEST";
                bDetected = true;
            }
        }
    }

    return result();
}
