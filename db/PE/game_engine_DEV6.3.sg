// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://wiki.scummvm.org/index.php?title=Gob/DEV6_Information
meta("game engine", "DEV6");

function detect() {
    if (PE.compareOverlay("0100000010010000000000002E2E5C2E2E5C'ExeRelease/Loader.exe'") && PE.isLibraryPresent("Edit_Dev.dll")) {
        sVersion = "release";
        bDetected = true;
    } else if (PE.compareOverlay("4E423130000000000FA52E3E01000000'Y:'5c'DEV6'5c'ExeRelease'5c'Loader.pdb'") && PE.getNumberOfResources() === 14 && PE.isLibraryPresent("LoadServ.dll")) {
        sVersion = "release";
        bDetected = true;
    } else if (PE.compareOverlay("0100000010010000000000002E2E5C2E2E5C'ExeRelease/Loader.exe'") && PE.isLibraryPresent("LoadServ.dll")) {
        sVersion = "release";
        bDetected = true;
    } else if (PE.compareOverlay("4E4231300000000050B9E03740000000'D:'5c'ssafe katego'5c'DEV6'5c'ExeRelease'5c'Loader.pdb'") && PE.isLibraryPresent("LoadServ.dll")) {
        sVersion = "release";
        sOptions = "SourceSafe (Katego)"
        bDetected = true;
    }

    return result();
}