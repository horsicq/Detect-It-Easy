// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>
// Enhanced by: BJNFNE, DosX

// https://ru.wikipedia.org/wiki/SafeDisc
meta("protector", "SafeDisc");

function detect() {
    if (PE.isNet()) return; // Doesn't support .NET

    if (PE.compareEP("558bec60bb........33c98a0d........85c974..b8........2bc383e8..eb")) {
        bDetected = true;
    } else if (PE.getNumberOfSections() > 3 && PE.getSectionName(PE.nLastSection - 1) === "stxt774" && PE.getSectionName(PE.nLastSection) === "stxt371") {
        if (PE.getImportSection() === PE.nLastSection && PE.getEntryPointSection() === PE.nLastSection) {
            bDetected = true;
        }
    }

    return result();
}