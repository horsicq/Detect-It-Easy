// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

meta("packer", "ExE Pack");

function detect() {
    if (PE.compareEP("6068........B8........FF1068........50B8........FF1068........6A40FFD08905")) {
        if (PE.section[0].Name == "!EPack") {
            sVersion = "1.0-1.2";
            bDetected = true;
        }
    } else if (PE.compareEP("9090909061B8........FFE0558BEC60558B75088B7D0CE802000000EB048B1C24C381C3")) {
        sVersion = "1.4 lite final";
        bDetected = true;
    } else if (PE.compareEP("33C08BC068........68........E8")) {
        sVersion = "1.4 lite final";
        bDetected = true;
    } else if (PE.section[PE.nLastSection].Name == ".!ep") {
        sVersion = "1.4";
        bDetected = true;
    }

    // Ported from Nauz File Detector "!EP(EXE Pack)" (SpecAbstract modules/nfd_pe.cpp:178, 179, 180, 583, 948, 949, 2784):
    // PE32, not .NET; import hash and (entry point signature or section name).
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x263ed9b5a && nNfdHash32 == 0x117f896a)) {
            if (PE.compareEP("6068........B8........FF1068........50B8........FF10")) {
                sVersion = "1.0-1.2";
                sOptions = "";
                bDetected = true;
            } else if (PE.compareEP("33C08BC068........68........E8")) {
                sVersion = "1.4";
                sOptions = "";
                bDetected = true;
            } else if (PE.compareEP("EB01909068........68........E8")) {
                sVersion = "1.4";
                sOptions = "";
                bDetected = true;
            } else if (PE.isSectionNamePresent("!EPack")) {
                sVersion = "1.0";
                sOptions = "";
                bDetected = true;
            } else if (PE.isSectionNamePresent(".!ep")) {
                sVersion = "1.4";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}