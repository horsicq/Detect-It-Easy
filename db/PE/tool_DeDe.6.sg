// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://www.softpaz.com/software/download-dede-windows-192.htm
meta("tool", "DeDe (Delphi Decompiler)")

function detect() {
    var dafixerSection = PE.section[".dafixer"];

    if (dafixerSection && (dafixerSection.Characteristics & 0xC0000040)) {
        sOptions = "reconstructed dump";
        bDetected = true;
    }

    return result();
}