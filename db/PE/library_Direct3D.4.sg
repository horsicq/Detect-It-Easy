meta("library", "Direct3D");

function detect() {
    var re = /d3dx?(\d{1,2})/i,
        match = PE.isLibraryPresentExp(re);

    if (!match) {
        match = PE.isExportFunctionPresentExpFastAnchor("d3d", re);
    }

    if (match && /^\d+$/.test(match[1]) && Number(match[1]) > 0 && Number(match[1]) <= 13) {
        sVersion = match[1];
        bDetected = true;
    } else {
        sVersion = PE.isLibraryPresentExp(/^d3d(\d{1,2})/i);

        if (sVersion && sVersion.length > 1) {
            sVersion = sVersion[1];

            if (sVersion > 0 && sVersion <= 13) {
                bDetected = true;
            }
        }
    }

    return result();
}