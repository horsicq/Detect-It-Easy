// Detect It Easy: detection rule file
// Tags: extra

meta("cryptor", "Crypter"); // ????????????

function detect() {
    if (PE.compareEP("68FF6424F06858585858FFD4508B40F205B095F6950F850181BBFF68")) {
        sVersion = "3.1";
        bDetected = true;
    }

    // Ported from Nauz File Detector "Crypter" (SpecAbstract modules/nfd_pe.cpp:362, 927, 928, 3025):
    // PE32, not .NET; entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        if (PE.compareEP("68FF6424F06858585858FFD4508B40F205B095F6950F850181BBFF68")) {
            sVersion = "3.1";
            sOptions = "";
            bDetected = true;
        }
    }

    return result();
}
