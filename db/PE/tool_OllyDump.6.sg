// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://www.openrce.org/downloads/details/108/ollydump
meta("tool", "OllyDump")

function detect() {
    var newIIDSection = PE.section[".newIID"] || PE.section[".NewIID"]; // .newIID (Option1) / .NewIID (Option2)

    if (newIIDSection && (newIIDSection.Characteristics & 0xC0000040)) {
        sVersion = "Gigapede";
        sOptions = "reconstructed dump";
        bDetected = true;
    }

    return result();
}