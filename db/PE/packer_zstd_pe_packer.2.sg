// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/mikoto52/zstd-pe-packer
meta("packer", "zstd-pe-packer");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (PE.compareEP("48895C2408574883EC2033C9FF155EEB00004C8BC0B84D5A000066413900") && lastSection && lastSection.Name === ".zpp" && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "'ZPP1'01")) {
        sVersion = "1.0.2";
        bDetected = true;
    } else if (PE.compareEP("48895C2408574883EC2033C9FF152AAE00004C8BC0B84D5A000066413900") && lastSection && lastSection.Name === ".zpp" && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "'ZPP1'01")) {
        sVersion = "1.0.1";
        bDetected = true;
    }

    return result();
}