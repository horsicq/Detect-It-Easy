// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:661, 4508)

meta("protector", "Again Nativity Crypter");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32) and overlay marker, nfd_binary.cpp:2330
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0x21bae50da1 && nHash32 == 0xab934456) {
            bHash = true;
        }

        if (bHash && PE.compareOverlay("'<%*#%>'")) {
            bDetected = true;
        } else {
            sVersion = sOptions = "";
        }
    }

    return result();
}
