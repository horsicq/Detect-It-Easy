meta("sfx", "SpeedCommander");

function detect() {
    if (PE.compareEP("60BE004082008DBE00D0BDFF57EB0B908A0646")) {
        if (PE.compareOverlay("'SCSFX'00cfb001")) {
            sVersion = File.cleanString(PE.getFileVersion());
            bDetected = true;
        }
    }

    return result();
}