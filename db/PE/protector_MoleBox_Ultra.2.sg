// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:261, 1574; modules/nfd_binary.cpp:2337)

meta("protector", "MoleBox Ultra");

function detect() {
    // NFD: PE32; entry point signature and the overlay marker 'XOJUMANJ'
    if (!PE.is64() && PE.compareEP("5589E5E8........5DC3CC")) {
        if (PE.isOverlayPresent() && PE.compareOverlay("'XOJUMANJ'")) {
            sVersion = "4.X";
            bDetected = true;
        }
    }

    return result();
}
