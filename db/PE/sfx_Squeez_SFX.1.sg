// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

meta("sfx", "Squeez SFX");

function detect() {
    if (PE.compareEP("558bec6a..68........68........64a1........50648925........83ec..5356578965..33db895d..6a..ff15")) {
        if (PE.compareOverlay("'SQ5SFX'")) {
            sVersion = "6.0.0.0";
            bDetected = true;
        }
    }

    // Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:4333): NFD names it "Squeez Self Extractor"
    if (!bDetected && !PE.isNet() && PE.compareOverlay("'SQ5SFX'") && PE.getVersionStringInfo("ProductName").indexOf("Squeez") != -1) {
        sVersion = PE.getVersionStringInfo("FileVersion").trim();
        bDetected = true;
    }

    return result();
}