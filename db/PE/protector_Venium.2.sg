// Detect It Easy: detection rule file
// Author: Venium

meta("protector", "Venium - Protection");

function detect() {
    if (PE.compare("'VNM!'", 0x78) && PE.getNumberOfSections() >= 3) {
        sVersion = PE.readByte(0x7c) + "." + PE.readByte(0x7d);
        bDetected = true;
    }

    return result();
}
