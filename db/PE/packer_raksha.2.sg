// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/muhiminulhasan/raksha
meta("packer", "raksha");

function detect() {
    var lastSection = PE.section[PE.getNumberOfSections() - 1]; // NOTE: lastSection only without lastSection.Name because raksha with pack the an executable generates random section at last position with different names.

    if (lastSection && lastSection.IsReadWriteExecute && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "31C0C3CCCCCCCCCCCCCCCCCCCCCCCCCC504C")) {
        bDetected = true;
    }

    return result();
}