// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/TaviF24/ROPacker
meta("packer", "ROPacker");

function detect() {
    if (PE.is32()) return; // Doesn't support x86 binaries

    if (PE.getSize() > 20971520) {
        if (PE.compareEP("4883EC28488B05........C70000000000E8..FDFFFF90904883C428C3") && PE.isLibraryPresent("zlib1.dll")) {
            bDetected = true;
        }
    }

    return result();
}