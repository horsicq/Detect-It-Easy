// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:679, 4620)

meta("protector", "GhaZza CryPter");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0x2de302f688 && nHash32 == 0x1d13438c) {
            sVersion = "1.0";
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
