// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// http://www.gbppr.net/cracking/playtools/exe-packers/win/crunch.zip
meta("protector", "Crunch");

function detect() {
    if (PE.compareEP("EB100000000000000000000000000000000055E800000000")) {
        sVersion = "4.0";
        bDetected = true;
    } else if (PE.compareEP("EB1503000000060000000000000000000000680000000055E800000000")) {
        sVersion = "5.0";
        bDetected = true;
    } else if (PE.compareEP("55E8........5D83ED068BC5556089AD........2B85")) {
        switch (PE.getEntryPointSignature(32, 2)) {
            case "80BD": sVersion = "1.0"; break;
            case "55BB": sVersion = "2.0"; break;
        }
        bDetected = true;
    }

    // Ported from Nauz File Detector "Crunch" (SpecAbstract modules/nfd_pe.cpp:260, 548, 926, 2226):
    // PE32, not .NET; import hash and entry point signature.
    // Also used to fill in the version when the rule above found the product without one.
    if ((!bDetected || (!sVersion && !sOptions)) && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x90c17bc0b && nNfdHash32 == 0x5e67bbdd)) {
            if (PE.compareEP("55E8000000005D83ED068BC55560")) {
                sVersion = "1.0";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}