// https://github.com/CommunityToolkit/dotnet
meta("library", "CommunityToolkit.Mvvm");

function detect() {
    if (PE.isNetObjectPresent("ObservableObject") && PE.isNetObjectPresent("RelayCommand")) {
        bDetected = true;
    }

    return result();
}