// https://download.cnet.com/hide-protect/3000-2092_4-10380452.html
meta("protector", "Hide&Protect");

function detect() {
    if (PE.compareEP("909090E9D8..050095..5300954A5000") ||
        PE.compareEP("909090E9........0000000000000000")) {
        sVersion = "1.016";
        bDetected = true;
    }

    // Ported from Nauz File Detector "Hide&Protect" (SpecAbstract modules/nfd_pe.cpp:327, 632, 2391):
    // PE32, not .NET; import hash and entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x26ff222837 && nNfdHash32 == 0xb136eb55)) {
            if (PE.compareEP("909090E9D8..050095..5300954A5000")) {
                sVersion = "1.016";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}