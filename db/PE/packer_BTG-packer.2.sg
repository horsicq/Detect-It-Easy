// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/uzokingkong/BTG-packer
meta("packer", "BTG-packer");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    var textbSection = PE.section[".textb"];

    if (textbSection && textbSection.IsReadWriteExecute && PE.isSignaturePresent(textbSection.FileOffset, textbSection.FileSize, "68....000068........EB14")) {
        sVersion = "1.0.0-1.0.2";
        bDetected = true;
    }

    return result();
}