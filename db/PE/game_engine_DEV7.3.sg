// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://wiki.scummvm.org/index.php?title=DEV7_Information
meta("game engine", "DEV7");

function detect() {
    if (PE.getVersionStringInfo("ProductName") == "Dev7 VM v1.30b") {
        sVersion = "1.30b";
        bDetected = true;
    } else if (PE.getVersionStringInfo("ProductName") == "Loader 7 v1.10a" && PE.isResourceNamePresent("IDD_DEV7VM_ERRORWINDOW")) {
        sVersion = "1.10a";
        bDetected = true;
    } else if (PE.getVersionStringInfo("ProductName") == "Dev7 VM v1.30a" && PE.isResourceNamePresent("IDI_DBWIN_SYSTRAY")) {
        sVersion = "1.30a";
        bDetected = true;
    } else if (PE.getVersionStringInfo("ProductName") == "Dev7 VM v1.30" && PE.isResourceNamePresent("IDI_OBCFILE_ICON")) {
        sVersion = "1.30";
        bDetected = true;
    } else if (PE.getVersionStringInfo("LegalCopyright") == "Havas Interactive Europe - Coktel - Copyright © 2001" && PE.isResourceNamePresent("IDD_DEV7VM_ERRORWINDOW")) {
        sVersion = "1.20";
        bDetected = true;
    } else if (PE.getVersionStringInfo("LegalCopyright") == "VUIPI - Coktel - Copyright © 2002") {
        sVersion = "1.30";
        bDetected = true;
    }
    return result();
}