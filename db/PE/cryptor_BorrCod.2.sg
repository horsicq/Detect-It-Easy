// httpsgithub.comBorrCodCrypter
meta("cryptor", "BorrCod");

function detect() {
    if (PE.getNetModuleName() === "Crypted.exe" && PE.isNetObjectPresent("StubEch")) {
        bDetected = true;
    }

    return result();
}