// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://www.softpedia.com/get/Programming/Packers-Crypters-Protectors/MEW-SE.shtml
meta("packer", "MEW");

function detect() {
    if (PE.compareEP("33C0e9$$$$$$$$be........ac91ad95ad92ad515687f297fcb2..33dba4b3..ff55")) {
        sVersion = "1.0";
        bDetected = true;
    } else if (PE.compareEP("E9........000000020000000C")) {
        sVersion = "SE 1.0";
        bDetected = true;
    } else if (PE.compareEP("E9......FF0C")) {
        sVersion = "SE 1.1-1.2";
        bDetected = true;
    } else if (PE.compareEP("e9$$$$$$$$be........8bdeadad50ad97b2")) {
        sVersion = "SE 1.1-1.2";
        bDetected = true;
    } else if (PE.compareEP("BE5B00....AD91AD9353AD96565FACC0C0")) {
        bDetected = true;
    } else if (PE.compareEP("2BC0E9D090FFFF6AE0E8382B23700EA31C504018186824511007E565F8E8AF7022DD15D8023B558B00EC535756817D0C1060")) {
        sVersion = "10 1.0";
        bDetected = true;
    }

    // Ported from Nauz File Detector "MEW10 / MEW11 SE" (SpecAbstract modules/nfd_pe.cpp:93, 95, 96, 385, 386, 448, 540, 541, 976, 977, 2496, 2503):
    // PE32, not .NET; MEW10: import hash and entry point signature; MEW11 SE: import hash and header marker.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x13e215a53 && nNfdHash32 == 0x381aae8d)) {
            if (PE.compareEP("33C0E9$$$$$$$$BE........AC91AD95AD92AD515687F297FCB2..33DBA4B3..FF55")) {
                sVersion = "10 1.0";
                sOptions = "";
                bDetected = true;
            }
        }

        if (!bDetected && (nNfdHash64 == 0x13e215a53 && nNfdHash32 == 0xdf3c1e0)) {
            if (PE.compare("'MZkernel32.dll'0000'PE'0000")) {
                sVersion = "SE 1.0";
                sOptions = "";
                bDetected = true;
            } else if (PE.compare("'MZ'00000000000000000000'PE'00004C010200000000000000000000000000")) {
                sVersion = "SE 1.1-1.2";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}