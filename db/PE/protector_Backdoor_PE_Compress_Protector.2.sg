// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:573, 2023)

meta("protector", "Backdoor PE Compress Protector");

function detect() {
    // NFD: PE32, not .NET; import hashes (getImportHash64, getImportHash32) and section name, nfd_pe.cpp:921
    if (!PE.is64() && !PE.isNet()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0x3404eaa9b && nHash32 == 0x3789c118) {
            sVersion = "1.0";
            bHash = true;
        } else if (nHash64 == 0x231271f8e && nHash32 == 0x986028bf) {
            bHash = true;
        }

        if (bHash && PE.isSectionNamePresent(".BCPack")) {
            bDetected = true;
        } else {
            sVersion = sOptions = "";
        }
    }

    return result();
}
