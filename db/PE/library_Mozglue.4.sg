// https://cytomate.medium.com/reverse-engineering-report-on-firefox-trojan-e22fcd760d8f
meta("library", "Mozglue");

function detect() {
    if (PE.isLibraryPresent("mozglue.dll")) {
        bDetected = true;
    }

    return result();
}