meta("protector", "pepack's Protect");

function detect() {
    if (!PE.is64() && !PE.isNet()) {
        if (PE.getImportHash64() === 0x1db028dca && PE.getImportHash32() === 0x50ca53fc) {
            if (PE.compare("'pepack'27's ProtectV2.3'", 0x20)) {
                sVersion = "2.3";
                bDetected = true;
            } else if (PE.isSectionNamePresent("okpack")) {
                sVersion = "2.3";
                bDetected = true;
            }
        }
    }

    return result();
}
