// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/karity-0/karity-protector
meta("protector", "karity-protector");

function detect() {
    if (PE.is32()) return; // Doesn't support x86 binaries
    
    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (PE.compareEP("E9") && lastSection.Name === ".kvm" && lastSection.IsReadWriteExecute && PE.findSignature(lastSection.FileOffset, lastSection.FileSize, "554889E59C5350488D1D321E0000488B")) {
        bDetected = true;
    }

    return result();
}