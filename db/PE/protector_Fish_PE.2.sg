// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

meta("protector", "Fish PE");

function detect() {
    if (PE.getNumberOfSections() == 2) {
        if (PE.section[0].FileSize == 0) {
            if (PE.compareEP("60e8070000006168........c35e56")) {
                sVersion = "1.2";
                bDetected = true;
            } else if (PE.compareEP("60e821000000eb$$6168........c35e56")) {
                sVersion = "1.3";
                bDetected = true;
            } else if (PE.compareEP("60b8........ffd05a")) {
                sVersion = "1.4";
                bDetected = true;
            }
        }
    }

    // Ported from Nauz File Detector "Fish PE Packer" (SpecAbstract modules/nfd_pe.cpp:196, 538, 2374):
    // PE32, not .NET; import hash and entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32();

        if ((nHash64 == 0x1eb276f62 && nHash32 == 0xdb8fbb75) || (nHash64 == 0x13e215a53 && nHash32 == 0xdf3c1e0)) {
            if (PE.compareEP("60E8........6168........C3")) {
                sVersion = "1.02";
                bDetected = true;
            } else if (PE.compareEP("60E8........EB")) {
                sVersion = "1.03";
                bDetected = true;
            } else if (PE.compareEP("60B8........FFD0")) {
                sVersion = "1.04";
                bDetected = true;
            }
        }
    }

    return result();
}