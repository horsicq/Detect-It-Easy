// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:671, 4564)

meta("protector", "Cryptable Seduction");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0x379caa9586 && nHash32 == 0x497a33ab) {
            sVersion = "1.0";
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
