// Detect It Easy: detection rule file
// Tags: extra

meta("protector", "Alex Protector");

function detect() {
    if (PE.compareEP("60E8000000005D81ED06104000E824000000")) {
        sVersion = "1.0";
        bDetected = true;
    } else if (PE.compareEP("60E801000000C783C40433C9E8010000006883C404E8010000006883C404")) {
        sVersion = "0.4 beta 1";
        bDetected = true;
    }

    // Ported from Nauz File Detector "Alex Protector" (SpecAbstract modules/nfd_pe.cpp:151, 547, 911, 2512):
    // PE32, not .NET; import hash and entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x1d6f34b26 && nNfdHash32 == 0x63fe4ff9)) {
            if (PE.compareEP("60E8000000005D81ED........E8")) {
                sVersion = "1.0";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}
