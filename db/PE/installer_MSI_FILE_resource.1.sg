// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// A setup stub that carries its Windows Installer package as a resource of
// type "MSI_FILE" (Classic Shell / Open-Shell setup).
meta("installer", "MSI_FILE resource wrapper");

function detect() {
    if (PE.isResourceGroupNamePresent("MSI_FILE")) {
        var sProduct = PE.getVersionStringInfo("ProductName");

        if (/Open-Shell|Classic Shell/.test(sProduct)) {
            sName = "Classic Shell / Open-Shell setup";
        }

        sOptions = "MSI_FILE resource";
        bDetected = true;
    }

    return result();
}
