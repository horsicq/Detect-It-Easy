// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/aaaddress1/Ahri
meta("packer", "Ahri");

function detect() {
    var ahriSection = PE.section[".ahri"];

    if (ahriSection && PE.isSignaturePresent(ahriSection.FileOffset, ahriSection.FileSize, "648F051400000068ADDE000068EFBE00")) {
        bDetected = true;
    }

    return result();
}