// Detect It Easy: detection rule file
// Tags: extra

meta("protector", "Cryptic");

function detect() {
    if (PE.compareEP("B8........BB........B900100000BA........03D803C803D13BCA74068031..41EBF6FFE3")) {
        sVersion = "2.0";
        bDetected = true;
    }

    // Ported from Nauz File Detector "Cryptic" (SpecAbstract modules/nfd_pe.cpp:672, 4572):
    // PE32; import hash.
    if (!bDetected && !PE.is64()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x2551095bcf && nNfdHash32 == 0x28ee87cc)) {
            sVersion = "2.1";
            sOptions = "";
            bDetected = true;
        }
    }

    return result();
}
