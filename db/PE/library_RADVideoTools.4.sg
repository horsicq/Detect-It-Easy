// https://www.radgametools.com/bnkdown.htm
meta("library", "RAD Video Tools");

function detect() {
    if (PE.isLibraryPresentExp(/^(binkw|bink2|video_bink)/i)) {
        bDetected = true;
    }

    return result();
}