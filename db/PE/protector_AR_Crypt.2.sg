// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:660, 4517)

meta("protector", "AR Crypt");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0x608b5ca5f && nHash32 == 0x27f8d01f) {
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
