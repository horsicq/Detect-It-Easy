// https://strontic.github.io/xcyclopedia/library/difxapi.dll-9C22EDFA77CB9232FAD1702C43FC77A6.html
meta("library", "Driver Install Framework API");

function detect() {
    if (PE.isLibraryPresent("difxapi.dll")) {
        bDetected = true;
    }

    return result();
}