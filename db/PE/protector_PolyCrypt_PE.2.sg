meta("protector", "JLabSoftware PolyCrypt PE");

function detect() {
    if (PE.compareEP("60e8$$$$$$$$918bf4adfec9803408..e2..c3")) {
        sVersion = "2004-2005";
        bDetected = true;
    }

    return result();
}