// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

// https://www.softpaz.com/software/download-polycrypt-pe-windows-94960.htm
meta("protector", "JLabSoftware PolyCrypt PE");

function detect() {
    if (PE.compareEP("60e8$$$$$$$$918bf4adfec9803408..e2..c3")) {
        sVersion = "2004-2005";
        bDetected = true;
    }

    // Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:2560; records :318 entry point, :625 import hash): PE32, not .NET
    if (!bDetected && !PE.is64() && !PE.isNet() && PE.getImportHash64() === 0x2870982b && PE.getImportHash32() === 0x15bfcac8) {
        if (PE.compareEP("60E8........EB")) {
            var nEPSection = PE.getEntryPointSection();

            if (nEPSection >= 0 && PE.getImportSection() == nEPSection && PE.isDeepScan() && PE.section[nEPSection] && PE.section[nEPSection].FileSize > 0) {
                if (PE.findString(PE.section[nEPSection].FileOffset, PE.section[nEPSection].FileSize, "PolyCrypt PE (c) 2004-2005, JLabSoftware.") == -1) {
                    sOptions = "Modified";
                }
            }

            bDetected = true;
        }
    }

    return result();
}