meta("protector", "DragonArmor");

function detect() {
    if (PE.compareEP("BF........83C9FF33C068........F2AEF7D1495168........E8110A000083C40C68")) {
        sVersion = "0.0.4.1";
        bDetected = true;
    }

    if (bDetected && !PE.isSectionNamePresentExp(/^(\.)?DAStub$/)) {
        sOptions = "modified";
    }

    // Ported from Nauz File Detector "DragonArmor" (SpecAbstract modules/nfd_pe.cpp:387, 530, 935, 1922):
    // PE32, not .NET; import hash and entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x0ee8cb83a && nNfdHash32 == 0xa4083f58)) {
            if (PE.compareEP("BF........83C9FF33C068........F2AEF7D1495168........E8110A000083C40C68")) {
                sVersion = "0.0.4.1";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}