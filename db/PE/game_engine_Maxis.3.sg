// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://en.wikipedia.org/wiki/Maxis
meta("game engine", "Maxis");

function detect() {
    if (PE.isExportFunctionPresent("GZDllGetGZCOMDirector")) {
        sOptions = PE.getVersionStringInfo("Comments");
        bDetected = true;
    } else if (PE.getVersionStringInfo("CompanyName") == "Maxis, a division of Electronic Arts Inc.") {
        sOptions = PE.getVersionStringInfo("Comments");
        bDetected = true;
    } else if (PE.getVersionStringInfo("CompanyName") == "Maxis, a division of Electronic Arts") {
        bDetected = true;
    } else if (PE.getVersionStringInfo("LegalCopyright") == "Copyright © 2003 Maxis. All Rights Reserved") {
        bDetected = true;
    }

    if (bDetected) sVersion = File.cleanString(PE.getFileVersion());

    return result();
}