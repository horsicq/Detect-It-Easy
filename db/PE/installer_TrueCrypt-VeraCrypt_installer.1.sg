// Detect It Easy: detection rule file format
// Author: A.S.L. <asl@onet.eu> 2019.05 updated 2025.01.31
// Tags: extra

meta("installer", "TrueCrypt or VeraCrypt installer");

function detect() {
    if (PE.compareEP("E8....0000E9") && PE.compareOverlay("..'CINSTRT'")) {
        sVersion = "1.X-7.X";
        bDetected = true;
    } else {
        // VeraCrypt only, TrueCrypt closed
        if (PE.compareEP("558BEC83EC0C56") && PE.compareOverlay("'VCINSTRT'")) {
            sVersion = "1.26 2025";
            bDetected = true;
        }
    }

    // Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:4120): NFD names it "VeraCrypt" from the version resource
    if (!bDetected && !PE.isNet() && PE.getVersionStringInfo("ProductName").indexOf("VeraCrypt") != -1) {
        sVersion = PE.getVersionStringInfo("FileVersion").trim();
        bDetected = true;
    }

    return result();
}
