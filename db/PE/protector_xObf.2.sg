// https://github.com/d35ha/xObf
meta("protector", "xObf");

function detect() {
    var xObfLastSection = PE.section[PE.nLastSection];

    if (xObfLastSection && xObfLastSection.Name === ".xObf" && ((xObfLastSection.Characteristics & 0xE0000000) >>> 0) === 0xE0000000) {
        bDetected = true;
    }

    return result();
}
