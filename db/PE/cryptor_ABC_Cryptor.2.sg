// Detect It Easy: detection rule file
// Tags: extra

meta("cryptor", "ABC Cryptor");

function detect() {
    if (PE.compareEP("68FF6424F0685858585890FFD4508B40F205B095F6950F850181BBFF")) {
        sVersion = "1.0";
        bDetected = true;
    }

    // Ported from Nauz File Detector "ABC Cryptor" (SpecAbstract modules/nfd_pe.cpp:217, 909, 3050):
    // PE32, not .NET; entry point signature, entry point at offset 1 of its section.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdEpSection = PE.getEntryPointSection();

        if (nNfdEpSection >= 0 && PE.getImageOptionalHeader("AddressOfEntryPoint") - PE.section[nNfdEpSection].VirtualAddress == 1) {
            if (PE.compareEP("68FF6424F0685858585890FFD4")) {
                sVersion = "1.0";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}
