meta("protector", "DirTy CrYpt0r");

function detect() {
    if (PE.compareEP("b8........32dbfec33018403d........7e..68........e8")) {
        bDetected = true;
    } else if (!PE.is64() && PE.getImportHash64() == 0x2d5043f921 && PE.getImportHash32() == 0x1278f5f4) {
        // Ported from Nauz File Detector "DirTy Cryptor" (SpecAbstract modules/nfd_pe.cpp:674, 4588): PE32 import hash.
        sOptions = "TEST";
        bDetected = true;
    }

    return result();
}
