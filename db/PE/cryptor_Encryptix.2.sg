// https://github[.]com/malpract/Encryptix-Crypter
// ATTENTION! The source contains embedded malicious code in the file
// "Encryptix Crypter\Encryptix Crypter.csproj" that runs automatically
// during compilation. Compile ONLY in a virtual machine without important 
// information that you don't mind losing.
meta("cryptor", "Encryptix");

function detect() {
    if (PE.getNetModuleName().indexOf("by-unknown") === 0 && PE.isNetObjectPresent("WriteProcessMemory")) {
        bDetected = true;
    }

    return result();
}