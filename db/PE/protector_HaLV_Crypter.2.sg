// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:682, 4641)

meta("protector", "HaLV Crypter");

function detect() {
    // NFD: PE32; import hashes (getImportHash64, getImportHash32)
    if (!PE.is64()) {
        var nHash64 = PE.getImportHash64(),
            nHash32 = PE.getImportHash32(),
            bHash = false;

        if (nHash64 == 0x3c92864a7 && nHash32 == 0x1921b4b9) {
            sOptions = "TEST";
            bHash = true;
        }

        bDetected = bHash;
    }

    return result();
}
