// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/LongWayHomie/PolyEngine
meta("packer", "PolyEngine");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    if (PE.compareEP("40555356574154415541564157") && PE.isSectionNamePresent(".CRT") && PE.getNumberOfImports() === 3) {
        bDetected = true;
    }

    return result();
}