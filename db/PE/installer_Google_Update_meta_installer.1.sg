// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Google Update (Omaha) meta-installer: the product's own installer travels as
// an "EXE" resource next to the "GOOGLEUPDATE" tag resource (Picasa, Earth ...).
meta("installer", "Google Update meta-installer");

function detect() {
    if (PE.isResourceGroupNamePresent("GOOGLEUPDATE") && PE.isResourceGroupNamePresent("EXE")) {
        sOptions = "EXE resource";
        bDetected = true;
    }

    return result();
}
