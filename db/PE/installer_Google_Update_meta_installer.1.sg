// Detect It Easy: detection rule file
// Author: hors <horsicq@gmail.com>

// Google Update (Omaha) meta-installer: the product's own installer travels as
// an "EXE" resource next to the "GOOGLEUPDATE" tag resource (Picasa, Earth ...).
meta("installer", "Google Update meta-installer");

function detect() {
    if (PE.isResourceGroupNamePresent("GOOGLEUPDATE") && PE.isResourceGroupNamePresent("EXE")) {
        sOptions = "EXE resource";
        bDetected = true;
    }

    // Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:4105): NFD names it "Google" from the version resource
    if (!bDetected && !PE.isNet() && PE.getVersionStringInfo("ProductName").indexOf("Google Update") != -1) {
        sVersion = PE.getVersionStringInfo("FileVersion").trim();
        bDetected = true;
    }

    return result();
}
