// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

meta("protector", "G!X Protector");

function detect() {
    if (PE.compareEP("60EB05E8EB044000EBFAE80A000000")) {
        sVersion = "1.2";
        bDetected = true;
    }

    // Ported from Nauz File Detector "G!X Protector" (SpecAbstract modules/nfd_pe.cpp:396, 959, 1977):
    // PE32, not .NET; entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        if (PE.compareEP("60EB05E8EB044000EBFAE80A000000")) {
            sVersion = "1.2";
            sOptions = "";
            bDetected = true;
        }
    }

    return result();
}