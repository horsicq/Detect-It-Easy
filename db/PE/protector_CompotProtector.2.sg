// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/aronpaaul/CompotProtector
meta("protector", "CompotProtector");

function detect() {
    if (PE.is32()) return; // Doesn't support x86 binaries

    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (lastSection.Name === ".compot" && PE.findSignature(lastSection.FileOffset, lastSection.FileSize, "00436F6D706F7450726F746563746F72003D3D2050726F74656374656420627920436F6D706F7450726F746563746F72203D3D0068747470733A2F2F6769746875622E636F6D2F61726F6E706161756C2F436F6D706F7450726F746563746F72") && PE.compareOverlay("0a'--- CompotProtector watermark ---'")) {
        sOptions = "watermark present";
        bDetected = true;
    }

    return result();
}