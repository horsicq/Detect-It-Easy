// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://www.vanduyne.com/
meta("game engine", "Calcium");

function detect() {
    if (PE.getVersionStringInfo("FileDescription") == "CALCIUM Application" && PE.isResourcesPresent("CALCIUM")) {
        sVersion = File.cleanString(PE.getFileVersion());
        bDetected = true;
    }

    return result();
}