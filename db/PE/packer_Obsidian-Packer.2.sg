// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/Zibgame/Obsidian-Packer
meta("packer", "Obsidian-Packer");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (lastSection && lastSection.Name === ".obsram" && PE.getNumberOfImports() === 4 && PE.getNumberOfSections() == 10 && PE.isLibraryPresent("libgcc_s_seh-1.dll")) {
        bDetected = true;
    }

    return result();
}