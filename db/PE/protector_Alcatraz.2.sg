// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/weak1337/Alcatraz
// https://www.elastic.co/security-labs/deobfuscating-alcatraz (protector was used in doubleloader)
meta("protector", "Alcatraz");

function detect() {
    if (PE.is32()) return; // Doesn't support x86 binaries

    var zeroDevSection = PE.section[".0Dev"];

    if (zeroDevSection && (zeroDevSection.Characteristics & 0x60000020)) {
        bDetected = true;
    }

    return result();
}