// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/HHT0rro/Xenolith
meta("packer", "Xenolith");

function detect() {
    if (PE.is32()) return; // Doesn't support x86

    var lastSection = PE.section[PE.getNumberOfSections() - 1]; // NOTE: lastSection only without lastSection.Name because Xenolith with pack the an executable generates random section at last position with different names.

    if (PE.compareEP("4531C941BA........41BB........4181F2........4181F3........535556") && lastSection && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "'XLV2'02") && PE.getNumberOfImports() === 0) {
        sVersion = "1.2.0rc";
        bDetected = true;
    }

    return result();
}