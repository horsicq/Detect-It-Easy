// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://www.yaldex.com/Bestsoft/Utilities/acprotect.htm
meta("protector", "ACProtect");

function detect() {
    if (PE.compareEP("60F950E801000000..58584950E801000000..5858790466B9B872E801000000")) {
        sVersion = "1.09g";
    } else if (PE.compareEP("E801000000..83")) {
        sVersion = "1.41";
    } else if (PE.compareEP("6050E801000000..83")) {
        sVersion = "1.3X";
    } else if (PE.compareEP("60E801000000..83042406C3")) {
        sVersion = "1.4X";
    } else if (PE.compareEP("600F87020000001BF8E801000000..83042406C3")) {
        sVersion = "1.90g";
    } else if (PE.compareEP("68........68........C3C3")) {
        sVersion = "2.0.X";
    } else {
        var perplexSection = PE.section[".perplex"];

        if (perplexSection && perplexSection.hasFlags(0xE0000060)) {
            sVersion = "1.X";
        }
    }

    bDetected = bDetected || Boolean(sVersion) || Boolean(sOptions);

    // Ported from Nauz File Detector "ACProtect" (SpecAbstract modules/nfd_pe.cpp:150, 338, 340, 341, 342, 343, 344, 534, 910, 2442, 2470):
    // PE32, not .NET; entry point signature, or (deep scan) import hash and "MineImport_Endss" in the import section.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if (PE.compareEP("68........68........C3C3")) {
            sVersion = "2.0.X";
            sOptions = "";
            bDetected = true;
        } else if (PE.compareEP("60F950E801000000..58584950E801000000..5858790466B9B872E801000000")) {
            sVersion = "1.09g";
            sOptions = "";
            bDetected = true;
        } else if (PE.compareEP("E801000000..83")) {
            sVersion = "1.41";
            sOptions = "";
            bDetected = true;
        } else if (PE.compareEP("6050E801000000..83")) {
            sVersion = "1.3X";
            sOptions = "";
            bDetected = true;
        } else if (PE.compareEP("60E801000000..83042406C3")) {
            sVersion = "1.4X";
            sOptions = "";
            bDetected = true;
        } else if (PE.compareEP("600F87020000001BF8E801000000..83042406C3")) {
            sVersion = "1.90g";
            sOptions = "";
            bDetected = true;
        } else if (PE.compareEP("68........68........C3C3")) {
            sVersion = "2.0.X";
            sOptions = "";
            bDetected = true;
        }

        if (!bDetected && PE.isDeepScan() && PE.getImportSection() >= 0 && ((nNfdHash64 == 0x26d690da0 && nNfdHash32 == 0x2301e49c)) &&
            PE.isSignatureInSectionPresent(PE.getImportSection(), "'MineImport_Endss'")) {
            sVersion = "1.XX-2.XX";
            sOptions = "";
            bDetected = true;
        }
    }

    return result();
}