// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>
// Improved by: BJNFNE

meta("protector", "RLP");

function detect() {
    if (PE.is64()) return; // Doesn't support x64 binaries

    if (PE.isSectionNamePresent(".rlp")) {
        if (PE.compareEP("6800....00E801000000C3C3")) {
            sVersion = "0.7.3b";
            bDetected = true;
        }
    }

    return result();
}