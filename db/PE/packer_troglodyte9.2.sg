// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/troglodyte9/packer
meta("packer", "troglodyte9");

function detect() {
    if (PE.isNet()) return; // Doesn't support .NET binaries

    var pkrSection = PE.section[".pkr"];

    if (pkrSection && (pkrSection.Characteristics & 0xE0000060)) {
        bDetected = true;
    }

    return result();
}