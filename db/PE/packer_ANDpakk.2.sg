// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

meta("packer", "ANDpakk");

function detect() {
    if (PE.compareEP("60FCBED4004000BF001000015783CDFF33C9F9EB05A402DB75058A1E4612DB72F4")) {
        sVersion = "2.0.06";
        bDetected = true;
    } else if (PE.getNumberOfSections() == 1 && PE.getNumberOfImports() == 1 && PE.getNumberOfImportThunks(0) == 2) {
        if (PE.section[0].Name == "ANDpakk2") {
            sVersion = "2.X";
            bDetected = true;
        }
    }

    // Ported from Nauz File Detector "ANDpakk2" (SpecAbstract modules/nfd_pe.cpp:74, 144, 145, 527, 914, 2208):
    // PE32, not .NET; (import hash or header marker) and entry point signature.
    if (!bDetected && !PE.is64() && !PE.isNet()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x134c8cd1e && nNfdHash32 == 0x29188619) ||
            PE.compare("'MZ'00'ANDpakk2'00'PE'0000")) {
            if (PE.compareEP("60FCBE........BF........5783CDFF33C9F9EB05A402DB7505")) {
                sVersion = "0.06";
                sOptions = "";
                bDetected = true;
            } else if (PE.compareEP("FCBE........BF........5783CDFF33C9F9EB05A402DB7505")) {
                sVersion = "0.18";
                sOptions = "";
                bDetected = true;
            }
        }
    }

    return result();
}