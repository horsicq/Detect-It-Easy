// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/blue-devil/pe-armor
meta("packer", "PE-Armor");

function detect() {
    if (PE.is64()) return; // Doesn't support x64

    var lastSection = PE.section[PE.getNumberOfSections() - 1];

    if (PE.compareEP("60E8410100002E") && lastSection && lastSection.Name === ".stub" && PE.isSignaturePresent(lastSection.FileOffset, lastSection.FileSize, "60E8410100002E") && PE.getNumberOfImports() === 1) {
        bDetected = true;
    }

    return result();
}