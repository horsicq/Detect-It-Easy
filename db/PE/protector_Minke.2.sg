// Detect It Easy: detection rule file
// Tags: extra

meta("protector", "Minke");

function detect() {
    if (PE.compareEP("558BEC83C4F053..........10E87AF6FFFFBE........33C05568........64FF30648920E8FAF8FFFFBA")) {
        sVersion = "1.0.1";
        bDetected = true;
    }

    // Ported from Nauz File Detector "Minke" (SpecAbstract modules/nfd_pe.cpp:718, 4915):
    // PE32; import hash.
    if (!bDetected && !PE.is64()) {
        var nNfdHash64 = PE.getImportHash64(),
            nNfdHash32 = PE.getImportHash32();

        if ((nNfdHash64 == 0x161bc831e3 && nNfdHash32 == 0xb1440658)) {
            sVersion = "1.01";
            sOptions = "TEST";
            bDetected = true;
        }
    }

    return result();
}
