// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://github.com/packing-box/dataset-packed-pe/tree/main/packed/WinUpack
meta("packer", "(Win)Upack");

function detect() {
    if (PE.compareEP("BE........AD8BF895A533C033")) {
        sVersion = "0.1X/0.20/0.21/0.24 beta";
    } else if (PE.compareEP("BE........AD8BF86A0495A533C0AB")) {
        sVersion = "0.21 beta";
    } else if (PE.compareEP("BE........AD8BF895AD91F3A5ADB5")) {
        sVersion = "0.24-0.27 beta/0.28 alpha";
    } else if (PE.compareEP("BE........AD50FF7634EB7C4801")) {
        switch (PE.readByte(PE.getEntryPointOffset() + 62)) {
            case 0x37: sVersion = "0.37 beta"; break;
            case 0x38: sVersion = "0.38 beta"; break;
            case 0x39: sVersion = "0.39 final"; break;
            case 0x3A: sVersion = "0.399"; break;
        }
    } else if (PE.compareEP("6A07BE........AD8BF85995F3A5")) {
        sVersion = "0.22/0.23 beta";
    } else if (PE.compareEP("BE........AD50..AD91F3A5")) {
        sVersion = "0.32 beta";
        sOptions = "Patch";
    } else if (PE.compareEP("BE........AD50..AD91..F3A5")) {
        sVersion = "0.32 beta";
    } else if (PE.compareEP("BE........AD50....AD91F3A5")) {
        sVersion = "0.32 beta";
    } else if (PE.compareEP("BE........AD50AD5066BE....6A..BF")) {
        sVersion = "0.34";
    } else if (PE.compareEP("BE........FF36E9C3000000")) {
        sVersion = "0.36 beta";
    } else if (PE.compareEP("60E809000000..................33C95E870E")) {
        sOptions = "Alt stub";
        // The sectioned 0.39/0.399 producer layout retains its version tag
        // in MinorLinkerVersion. Keep other alternate stubs unversioned.
        var nNT = PE.readDword(0x3c);
        if (nNT === 0x40 && PE.compare("0b0100", nNT + 24) &&
            PE.isSectionNamePresent(".Upack") &&
            PE.compareEP("60E809000000..................33C95E870EE3F4")) {
            switch (PE.readByte(nNT + 27)) {
                case 0x39: sVersion = "0.39 final"; break;
                case 0x3a: sVersion = "0.399"; break;
            }
        }
    } else if (PE.readDword(0x3c) === 0x10 &&
               PE.compare("0b01", 0x28) && PE.readDword(0x38) === 0x1018) {
        // Compact outputs execute the decoder inside the overlapping COFF
        // header. API-name strings alone also survive in unpacked images.
        if (PE.compare("BE........AD50FF7634EB7C4801", 0x18)) {
            bDetected = true;
            switch (PE.readByte(0x56)) {
                case 0x37: sVersion = "0.37 beta"; break;
                case 0x38: sVersion = "0.38 beta"; break;
                case 0x39: sVersion = "0.39 final"; break;
                case 0x3a: sVersion = "0.399"; break;
            }
        } else if (PE.compare("BE........FF36E9C3000000", 0x18)) {
            bDetected = true;
            if (PE.readByte(0x56) === 0x36) sVersion = "0.36 beta";
        }
    }

    bDetected = bDetected || Boolean(sVersion) || Boolean(sOptions);

    return result();
}