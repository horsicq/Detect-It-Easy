// https://www.nvidia.com/en-gb/drivers/physx/physx-9-19-0218-driver/
meta("library", "Nvidia PhysX");

function detect() {
    if (PE.is64() && PE.section[".rdata"] && PE.isLibraryPresentExp(/^physx/i)) {
        bDetected = true;
    }

    return result();
}