// https://github.com/Hoaxr/DekkCrypt
meta("cryptor", "DekkCrypt");

function detect() {
    if (PE.isNetUStringPresent("encfile") && PE.isNetObjectPresent("Encrypted.resources")) {
        bDetected = true;
    }

    return result();
}