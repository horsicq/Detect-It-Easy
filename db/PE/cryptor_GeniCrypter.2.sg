// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://github.com/zakariasalhi12/GeniCrypter
meta("cryptor", "GeniCrypter");

function detect() {
    if (PE.is32()) return; // Doesn't support x86 binaries

    var rdataSection = PE.section[".rdata"];

    if (PE.compareEP("4883EC28E8470500004883C428E96EFEFFFFCCCCCCCC") && rdataSection && PE.isRichSignaturePresent() && PE.isLibraryPresent("bcryptprimitives.dll") && PE.findString(rdataSection.FileOffset, rdataSection.FileSize, "Failed to decrypt payload. The encrypted data may be corrupted or the key/nonce may be incorrect.") !== -1) {
        bDetected = true;
    }

    return result();
}