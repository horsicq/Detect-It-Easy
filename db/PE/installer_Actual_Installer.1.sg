// Detect It Easy: detection rule file
// Author: hypn0 <hypn0@mail.ru>

// https://www.actualinstaller.ru/
meta("installer", "Actual Installer");

function detect() {
    if (PE.compareEP("558bec83c4..b8........e8$$$$$$$$538bd833c0a3........6a..e8........a3........a1........a3........33c0a3........33c0a3........e8........ba........8bc3e8........5bc3")) {
        if (PE.compareOverlay("....................'MSCF'00")) {
            sVersion = "1.0.0.0";
            bDetected = true;
        }
    }

    // Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:4077 version resource, :1501 setup form caption in deep scan)
    if (!bDetected) {
        if (!PE.isNet() && PE.getVersionStringInfo("Comments").indexOf("Actual Installer") != -1) {
            sVersion = PE.getVersionStringInfo("FileVersion").trim();
            bDetected = true;
        } else if (PE.isDeepScan()) {
            var nResourceSection = PE.getResourceSection();

            if (nResourceSection >= 0 && PE.section[nResourceSection] && PE.section[nResourceSection].FileSize > 0 &&
                PE.findString(PE.section[nResourceSection].FileOffset, PE.section[nResourceSection].FileSize, "Actual Installer") != -1) {
                bDetected = true;
            }
        }
    }

    return result();
}