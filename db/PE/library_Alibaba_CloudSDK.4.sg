// https://github.com/aliyun/aliyun-openapi-net-sdk
meta("library", "Alibaba Cloud SDK");

function detect() {
    if (PE.isNetObjectPresent("aliyun-net-sdk-ram")) {
        bDetected = true;
    }

    return result();
}