// Detect It Easy: detection rule file
// Author: BJNFNE <bjnfne@web.de>

// https://logicoma.io/squishy/
meta("packer", "Squishy");

function detect() {
    if (PE.is32()) return; // Doesn't support x86 binaries

    if (PE.isSectionNamePresent("logicoma") && PE.compareEP("55FCE825000000488D05D5000000E8......00488B0520010000488B1D21010000E8")) {
        bDetected = true;
    }

    return result();
}