// https://github.com/dr4k0nia/Origami
meta("packer", "Origami");

function detect() {
    if (PE.isNet()) {
        if (PE.isNetUStringPresent("Origami could not find a valid EntryPoint to invoke")) {
            bDetected = true;
        }
    }

    return result();
}