// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_pe.cpp:4498; modules/nfd_binary.cpp:2327)

meta("protector", "1337 Exe Crypter");

function detect() {
    // NFD: overlay marker at the overlay start and an import of MSVBVM60.DLL (case-insensitive)
    if (PE.isOverlayPresent() && PE.isLibraryPresent("MSVBVM60.DLL")) {
        if (PE.compareOverlay("60'*[S-P-L-I-T]*'60")) {
            sVersion = "1";
            bDetected = true;
        } else if (PE.compareOverlay("'~SPLIT~'")) {
            sVersion = "2";
            bDetected = true;
        }
    }

    return result();
}
