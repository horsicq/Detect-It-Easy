// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

meta("format", "Microsoft Office");

function detect() {
    if (CFBF.getSize() >= 0x202 && CFBF.read_uint16(0x200) === 0xA5EC) {
        sName = "Microsoft Office Word";
        sVersion = "97-2003";
        bDetected = true;
    } else if (CFBF.getFileFormatVersion() == 3.62) {
        sVersion = "1997-2003";
        bDetected = true;
    }

    return result();
}