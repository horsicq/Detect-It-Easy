// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract modules/nfd_cfbf.cpp:66-83)

meta("installer", "Advanced Installer");

function detect() {
    if (CFBF.isDeepScan()) {
        var nAIOffset = CFBF.findString(0, CFBF.getSize(), "AI_PACKAGING_TOOL");
        if (nAIOffset !== -1) {
            var sTail = CFBF.read_ansiString(nAIOffset + 17, 64);
            if (sTail.indexOf("Advanced Installer") === 0) {
                var aParts = sTail.split(" ");
                if (aParts.length >= 3) {
                    sVersion = aParts[2];
                }
            }
            bDetected = true;
        }
    }

    return result();
}
