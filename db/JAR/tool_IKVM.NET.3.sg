// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_jar.cpp:131-137, 147-157)

meta("tool", "IKVM.NET");

function detect() {
    if (JAR.getManifestRecord("Created-By").indexOf("(Jeroen Frijters)") != -1) {
        bDetected = true;
    }

    return result();
}
