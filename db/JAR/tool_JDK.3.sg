// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_jar.cpp:93-112, 147-157)

meta("tool", "JDK");

function detect() {
    // Created-By of a known JDK vendor gives the version (first word); Build-Jdk overrides it.
    var sCreatedBy = JAR.getManifestRecord("Created-By"),
        sBuildJdk = JAR.getManifestRecord("Build-Jdk"),
        aVendors = ["(Sun Microsystems Inc.)", "(BEA Systems, Inc.)", "(The FreeBSD Foundation)", "(Oracle Corporation)", "(Apple Inc.)",
            "(Google Inc.)", "(Jeroen Frijters)", "(IBM Corporation)", "(JetBrains s.r.o)", "(Alibaba)"];

    for (var i = 0; i < aVendors.length; i++) {
        if (sCreatedBy.indexOf(aVendors[i]) != -1) {
            sVersion = sCreatedBy.split(" ")[0];
            bDetected = true;
            break;
        }
    }

    if (sBuildJdk != "") {
        sVersion = sBuildJdk;
        bDetected = true;
    }

    // NFD derives "Language: Java" from this tool (nfd_binary.cpp getLanguage).
    sLang = "Java";

    return result();
}
