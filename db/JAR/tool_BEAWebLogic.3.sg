// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_jar.cpp:139-145, 147-157)

meta("tool", "BEA WebLogic");

function detect() {
    if (JAR.getManifestRecord("Created-By").indexOf("(BEA Systems, Inc.)") != -1) {
        bDetected = true;
    }

    return result();
}
