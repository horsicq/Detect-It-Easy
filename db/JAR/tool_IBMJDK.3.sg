// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_jar.cpp:76-82, 147-157)

meta("tool", "IBM JDK");

function detect() {
    if (JAR.getManifestRecord("Created-By").indexOf("(IBM Corporation)") != -1) {
        bDetected = true;
    }

    // NFD derives "Language: Java" from this tool (nfd_binary.cpp getLanguage).
    sLang = "Java";

    return result();
}
