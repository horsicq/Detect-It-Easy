// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_jar.cpp:123-129, 147-157)

meta("tool", "JetBrains");

function detect() {
    if (JAR.getManifestRecord("Created-By").indexOf("(JetBrains s.r.o)") != -1) {
        bDetected = true;
    }

    return result();
}
