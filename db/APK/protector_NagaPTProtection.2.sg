// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#naga

meta("protector", "NagaPTProtection");

function detect() {
    bDetected = APK_isRecordExp("lib(e|d|f|v)dog\\.so|libchaosvmp\\.so|libxloader\\.so|assets/maindata/fake_classes\\.dex");

    return result();
}