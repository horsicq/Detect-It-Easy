// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_apk.cpp:727-786)

meta("protector", "_Unknown");

function detect() {
    // Verbose diagnostic. NFD lists META-INF/MANIFEST.MF Protected-By/Created-By/Built-By when no
    // known meta-info tool was found; NFD_ZIP::handle_Metainfos never records one, so it always runs.
    if (APK.isVerbose()) {
        var sProtectedBy = APK.getManifestRecord("Protected-By"),
            sCreatedBy = APK.getManifestRecord("Created-By"),
            sBuiltBy = APK.getManifestRecord("Built-By"),
            sProtected = "";

        if (sProtectedBy != "") {
            sProtected = "Protected: " + sProtectedBy;
        }

        // NFD also requires "-By" in the manifest text, which these three non-empty records already imply
        // (APK.getManifest() is not filled for APKs by the C engine).
        if ((sProtectedBy != "") && (sCreatedBy != "") && (sBuiltBy != "")) {
            sProtected = "CHECK";
        }

        if (sProtected != "") {
            _setResult("protector", "_Unknown", sProtected, "");
        }

        if ((sCreatedBy != "") && (sCreatedBy != "1.0 (Android)")) {
            _setResult("protector", "_Unknown", "Created: " + sCreatedBy, "");
        }

        if (sBuiltBy != "") {
            _setResult("protector", "_Unknown", "Built: " + sBuiltBy, "");
        }
    }

    return result();
}
