// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/obfuscators.yara#gemalto_protector

meta("protector", "Gemalto");

function detect() {
    bDetected = APK_isRecordExp("lib/(arm64-v8a|armeabi-v7a|armeabi|mips|mips64|x86|x86_64)/libmedl\\.so");

    return result();
}