// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#kony

meta("packer", "Kony");

function detect() {
    bDetected = (APK_isRecordExp("libkonyjsvm\\.so") && APK_isRecordExp("assets/application\\.properties") && APK_isRecordExp("assets/js/startup\\.js")) ||
        (APK.isArchiveRecordPresent("libkonyjsvm.so"));

    return result();
}