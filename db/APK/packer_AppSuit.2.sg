// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#appsuit_packer

meta("packer", "AppSuit");

function detect() {
    bDetected = APK_countRecordExp(["assets/appsuit/momo", "assets/appsuit/meme", "libAppSuit\\.so"]) >= 2;

    return result();
}
