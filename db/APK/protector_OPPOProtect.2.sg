// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/protectors.yara#oppo_protect

meta("protector", "OPPO Protect SDK");

function detect() {
    bDetected = APK_isRecordExp("lib/(arm.*|x86.*)/(libOPPOProtect(2019)?|libomesStdSco)\\.so");

    return result();
}
