// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/protectors.yara#ahnlab_v3_engine

meta("protector", "Ahnlab V3 engine");

function detect() {
    bDetected = APK_countRecordExp(["lib/(arm|x86).*/libEngineManager\\.so", "assets/ahnlab/engine/(arm|x86).*/lib(rc|av)engine", "assets/ahnlab/engine/rootchecker2\\.rcd"]) >= 2;

    return result();
}
