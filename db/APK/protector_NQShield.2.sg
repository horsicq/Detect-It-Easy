// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#nqshield

meta("protector", "NQShield");

function detect() {
    bDetected = APK_isRecordExp("nqshield|nqshell") || (APK.isArchiveRecordPresent("assets/libnqshieldx86.so") ||
            APK.isArchiveRecordPresent("assets/nqdata") ||
            APK.isArchiveRecordPresent("lib/armeabi/libnqshield.so"));

    return result();
}