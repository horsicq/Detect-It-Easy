// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/protectors.yara#dpt_shell

meta("protector", "DPT Shell");

function detect() {
    bDetected = APK_isRecordExp("assets/app_name|assets/app_acf") && APK_isRecordExp("assets/(.*)/(arm.*|x86.*)/libdpt\\.so");

    return result();
}
