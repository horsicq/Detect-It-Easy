// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_apk.cpp:255-290)

meta("tool", "Android SDK");

function detect() {
    // NFD reads the decoded AndroidManifest.xml with the same regexes as getAndroidManifestRecord,
    // accepts API levels 1..40 and prefers compileSdkVersion, then minSdkVersion, then targetSdkVersion.
    var sCompileSdk = APK.getAndroidManifestRecord("android:compileSdkVersion"),
        sMinSdk = APK.getAndroidManifestRecord("android:minSdkVersion"),
        sTargetSdk = APK.getAndroidManifestRecord("android:targetSdkVersion");

    if (!APK_NFD_checkStringNumber(sCompileSdk, 1, 40)) sCompileSdk = "";
    if (!APK_NFD_checkStringNumber(sMinSdk, 1, 40)) sMinSdk = "";
    if (!APK_NFD_checkStringNumber(sTargetSdk, 1, 40)) sTargetSdk = "";

    var sApi = sCompileSdk;

    if (sApi == "") sApi = sMinSdk;
    if (sApi == "") sApi = sTargetSdk;

    if (sApi != "") {
        sVersion = "API " + sApi;
        bDetected = true;
    }

    return result();
}
