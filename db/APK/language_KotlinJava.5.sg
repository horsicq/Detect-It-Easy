// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_apk.cpp:229-235, 828-829)

// NFD emits this language record directly for every valid APK (not derived from a compiler),
// so it is a plain result like NPM/language_*.sg, not a verbose-only _setLang() derivation.
meta("language", "Java");

function detect() {
    if (APK.isArchiveRecordPresent("META-INF/androidx.core_core-ktx.version") || APK.isArchiveRecordPresent("kotlin/kotlin.kotlin_builtins")) {
        sName = "Kotlin";
    }

    bDetected = true;

    return result();
}
