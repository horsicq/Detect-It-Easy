// https://build38.com
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/protectors.yara#build38

meta("protector", "build38");

function detect() {
    bDetected = (APK.isArchiveRecordPresent("__license.tak") || APK.isArchiveRecordPresent("license.tak")) ||
        (APK_countRecordExp(["lib/(arm.*|x86.*)/libtak\\.so", "__license\\.tak", "license\\.tak"]) >= 2);

    return result();
}