// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#appguard, #appguard_a, #appguard_b, #appguard_c, #appguard_d

meta("protector", "AppGuard");

function detect() {
    if (APK_isRecordExp("lib/(arm.*|x86.*)/(libloader|libdiresu)\\.so") &&
        APK_isRecordExp("assets/classes[1-9]{0,1}\\.(jet|zip)|assets/m7a|assets/m8a|assets/agconfig|assets/agmetainfo")) {
        // appguard_c
        sOptions = "TOAST-NHNent";
        bDetected = true;
    }

    if (APK_isRecordExp("assets/appguard/") ||
        APK_isRecordExp("assets/AppGuard0\\.jar|assets/AppGuard\\.dgc|lib/(arm.*|x86.*)/libAppGuard\\.so|libAppGuard-x86\\.so") ||
        (APK.isArchiveRecordPresent("assets/AppGuard.dgc") ||
            APK.isArchiveRecordPresent("assets/AppGuard0.jar") ||
            APK.isArchiveRecordPresent("lib/armeabi-v7a/libAppGuard.so") ||
            APK.isArchiveRecordPresent("lib/armeabi/libAppGuard-x86.so") ||
            APK.isArchiveRecordPresent("lib/armeabi/libAppGuard.so"))) {
        bDetected = true;
    }

    return result();
}