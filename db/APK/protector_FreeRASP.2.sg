// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/protectors.yara#free_rasp_old, #free_rasp_new

meta("protector", "FreeRASP");

function detect() {
    bDetected = APK_isRecordExp("lib/(arm.*|x86.*)/libsecurity\\.so") && APK_isRecordExp("lib/(arm.*|x86.*)/libpolarssl\\.so");

    return result();
}
