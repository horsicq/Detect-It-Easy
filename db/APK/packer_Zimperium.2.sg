// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#zimperium_zshield_apk

meta("packer", "Zimperium (zShield)");

function detect() {
    bDetected = APK_isRecordExp("assets/.*\\.szip") && APK_isRecordExp("assets/.*/0\\.odex") && APK_isRecordExp("lib/(arm.*|x86.*)/lib.*\\.so");

    return result();
}
