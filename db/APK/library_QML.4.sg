// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_apk.cpp:151, 717-722)

meta("library", "QML");

function detect() {
    if (APK.isArchiveRecordPresent("AndroidManifest.xml") && APK.isArchiveRecordPresent("lib/arm64-v8a/libQt6Qml_arm64-v8a.so")) {
        sVersion = "6.X";
        bDetected = true;
        // NFD derives "Language: QML" from this library (nfd_binary.cpp getLanguage).
        sLang = "QML";
    }

    return result();
}
