// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_apk.cpp:202-217)

meta("sign tool", "APK Signature Scheme");

function detect() {
    // Block presence only (no cryptographic check). NFD reports v2 when both v2 and v3 are present.
    if (APK_NFD_isSigBlockIDPresent(0x7109871A)) {
        sVersion = "v2";
        bDetected = true;
    } else if (APK_NFD_isSigBlockIDPresent(0xF05368C0)) {
        sVersion = "v3";
        bDetected = true;
    }

    return result();
}
