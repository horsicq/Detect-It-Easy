// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#manxi_sec

meta("packer", "Manxi Security");

function detect() {
    bDetected = APK_isRecordExp("assets/mxsafe/(arm.*|x86.*)/libdSafeShell\\.so|assets/mx/(arm.*|x86.*)/libmxacc\\.so|lib/(arm.*|x86.*)/libmanxi\\.so|assets/mxsafe\\.(data|config|jar)");

    return result();
}
