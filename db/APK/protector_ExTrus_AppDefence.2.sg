// https://www.extrus.co.kr/en/products/appdefence
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/protectors.yara#appdefence

meta("protector", "ExTrus AppDefence");

function detect() {
    bDetected = APK_isRecordExp("assets/appdefence_xml");

    return result();
}