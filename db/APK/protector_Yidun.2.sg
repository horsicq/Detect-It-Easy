// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#yidun

meta("protector", "Yidun");

function detect() {
    // yidun: #lib > 1 (raw count of "libnesec.so") or (nedata and nedig); the DEX-string branch needs DEX bytes
    bDetected = (APK_isRecordExp("libnesec\\.so") && (APK_countRawString("libnesec.so", 2) > 1)) ||
        (APK_isRecordExp("assets/nedata\\.db") && APK_isRecordExp("assets/nedig\\.properties")) ||
        (APK.isArchiveRecordPresent("lib/arm64-v8a/libnesec.so") ||
            APK.isArchiveRecordPresent("lib/armeabi-v7a/libnesec.so") ||
            APK.isArchiveRecordPresent("lib/armeabi/libnesec.so") ||
            APK.isArchiveRecordPresent("lib/x86/libnesec.so"));

    return result();
}