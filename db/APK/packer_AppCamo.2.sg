// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#appcamo

meta("packer", "AppCamo");

function detect() {
    bDetected = APK_isRecordExp("lib/(.*)/libalib\\.so") && APK_isRecordExp("assets/[0-9a-f]{32}/[0-9a-f]{32}\\.png");

    return result();
}
