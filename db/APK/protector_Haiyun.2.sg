// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/protectors.yara#haiyun

meta("protector", "Haiyun'an Security");

function detect() {
    bDetected = APK_isRecordExp("lib/(arm.*|x86.*)/libitsec\\.so") && APK_isRecordExp("assets/itse");

    return result();
}
