// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#secenh

meta("packer", "Secenh");

function detect() {
    bDetected = APK_isRecordExp("assets/libsecenh\\.so|assets/libsecenh_x86\\.so") && APK_isRecordExp("assets/respatcher\\.jar|assets/res\\.zip");

    return result();
}
