// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_apk.cpp:292-299)

meta("library", "Android Jetpack");

function detect() {
    // NFD checks this only for APKs with an AndroidManifest.xml.
    if (APK.isArchiveRecordPresent("AndroidManifest.xml") && APK.isArchiveRecordPresent("META-INF/androidx.core_core.version")) {
        var sText = APK_NFD_readMemberText("META-INF/androidx.core_core.version", 4096);

        if (sText != "") {
            // regExp("(.*?)\n") then remove "\r": the text before the first line feed, "" without one.
            var nEnd = sText.indexOf("\n");

            sVersion = (nEnd != -1) ? sText.substring(0, nEnd).replace(/\r/g, "") : "";
            bDetected = true;
        }
    }

    return result();
}
