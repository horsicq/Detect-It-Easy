// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_apk.cpp:224-227)

meta("tool", "Google Play");

function detect() {
    // APK Signing Block record 0x2146444e (Google Play frosting).
    bDetected = APK_NFD_isSigBlockIDPresent(0x2146444E);

    return result();
}
