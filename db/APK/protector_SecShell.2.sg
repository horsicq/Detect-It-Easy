// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#bangcle_secshell

meta("protector", "SecShell");

function detect() {
    bDetected = (APK_countRecordExp(["assets/secData0\\.jar", "libSecShell\\.so", "libSecShell-x86\\.so"]) >= 2) || (APK.isArchiveRecordPresent("assets/secData0.jar") ||
            APK.isArchiveRecordPresent("lib/armeabi/libSecShell-x86.so") ||
            APK.isArchiveRecordPresent("lib/armeabi/libSecShell.so"));

    return result();
}