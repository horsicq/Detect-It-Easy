// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#qihoo360

meta("protector", "Qihoo360Protection");

function detect() {
    // qihoo360: libprotectClass.so and not kiro
    bDetected = (APK_isRecordExp("libprotectClass\\.so") && !(APK_isRecordExp("libkiroro\\.so") && APK_isRecordExp("assets/sbox"))) ||
        (APK.isArchiveRecordPresent("lib/armeabi-v7a/libprotectClass.so") ||
            APK.isArchiveRecordPresent("lib/armeabi/libprotectClass.so") ||
            APK.isArchiveRecordPresent("lib/x86/libprotectClass.so"));

    return result();
}