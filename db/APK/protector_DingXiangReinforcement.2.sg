// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#dingxiang_apk

meta("protector", "DingXiang Reinforcement");

function detect() {
    bDetected = (APK_countRecordExp(["lib/(arm.*|x86.*)/libsys_misc\\.so", "assets/csn.*\\.data\\d?", "assets/__param\\.data",
            "assets/__version\\.txt", "dsnstub000\\.vd"]) >= 2) ||
        (APK.isArchiveRecordPresent("com/security/shell/AppStub1") ||
            APK.isArchiveRecordPresent("com/security/inner/stub000"));

    return result();
}