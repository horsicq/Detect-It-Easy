// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#gpresto_apk

meta("packer", "G-Presto (anti-cheat)");

function detect() {
    bDetected = APK_countRecordExp(["lib/(arm.*|x86.*)/libATG_L\\.so", "assets/ATG_E.*\\.sec", "assets/libData\\.so"]) >= 2;

    return result();
}
