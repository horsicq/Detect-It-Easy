// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/protectors.yara#alibaba_sec

meta("protector", "Alibaba Security SDK");

function detect() {
    bDetected = APK_isRecordExp("lib/(arm.*|x86.*)/lib(alisecuritysdk|demolish(data)?|reverify1)\\.so|assets/ali_sec\\.dat");

    return result();
}
