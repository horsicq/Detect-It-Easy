// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/protectors.yara#vkey_apk

meta("protector", "Vkey (V-OS App Protection)");

function detect() {
    var sArch = "lib/(x86_64|armeabi-v7a|arm64-v8a|x86)/";

    bDetected = APK_isRecordExp("assets/vkeylicensepack|assets/vkwbc_ta\\.bin|assets/voscodesign\\.vky") &&
        APK_isRecordExp("assets/firmware|assets/kernel\\.bin|assets/signature") &&
        (APK_countRecordExp([sArch + "libvosWrapperEx\\.so", sArch + "libvtap\\.so", sArch + "libloadTA\\.so", sArch + "libchecks\\.so"]) >= 2);

    return result();
}
