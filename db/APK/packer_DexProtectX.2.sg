meta("packer", "DexProtect X (DexShellx)");

function detect() {
    bDetected = APK_isRecordExp("assets/libVMDexShellx\\.so|assets/dexshell/(arm.*|x86.*)/libdexshell\\.so|assets/DexShell\\.mp3");

    return result();
}
