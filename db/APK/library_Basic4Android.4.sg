// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_apk.cpp:154-156, 703-708)

meta("library", "Basic4Android");

function detect() {
    // Archive record name regex "assets\/(.*).bal" (B4A layout files).
    if (APK.isArchiveRecordPresent("AndroidManifest.xml") && APK.isArchiveRecordPresentExp("assets\\/(.*).bal")) {
        bDetected = true;
        // NFD derives "Language: BASIC" from this library (nfd_binary.cpp getLanguage).
        sLang = "BASIC";
    }

    return result();
}
