// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_apk.cpp:237-253)

meta("sign tool", "_Unknown");

function detect() {
    // Verbose diagnostic: every APK Signing Block record ID above 0xFFFF that is not
    // v2 (0x7109871a), v3 (0xf05368c0) or padding (0x42726577), as NFD lists them.
    if (APK.isVerbose()) {
        var aIDs = APK_NFD_getSigBlockIDs();

        for (var i = 0; i < aIDs.length; i++) {
            var nID = aIDs[i];

            if ((nID > 0xFFFF) && (nID != 0x7109871A) && (nID != 0xF05368C0) && (nID != 0x42726577)) {
                var sHex = nID.toString(16);

                while (sHex.length < 8) {
                    sHex = "0" + sHex;
                }

                _setResult("sign tool", "_Unknown", sHex, "");
            }
        }
    }

    return result();
}
