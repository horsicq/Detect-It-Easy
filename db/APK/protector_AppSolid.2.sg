// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#medusah_appsolid

meta("protector", "AppSolid");

function detect() {
    bDetected = (APK.isArchiveRecordPresent("assets/high_resolution.png")) || (APK_isRecordExp("assets/high_resolution\\.png") && !APK_isRecordExp("libmd\\.so"));

    return result();
}