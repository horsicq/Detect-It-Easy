// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#aegis

meta("packer", "Aegis - Android Republic Mods");

function detect() {
    bDetected = APK_isRecordExp("assets/aegis/(aegis\\.mf|aegis\\.sig|aegis[0-9]\\.dat|nmsscr\\.nmss|nmssey\\.nmss|nmsskc\\.nmss|shield\\.dat)");

    return result();
}
