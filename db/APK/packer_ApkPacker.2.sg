// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#apkpacker

meta("packer", "ApkPacker");

function detect() {
    bDetected = APK_isRecordExp("assets/ApkPacker/apkPackerConfiguration") && APK_isRecordExp("assets/ApkPacker/classes\\.dex");

    return result();
}
