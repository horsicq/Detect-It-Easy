meta("protector", "PangXie");

function detect() {
    bDetected =
        APK.isArchiveRecordPresent("lib/armeabi-v7a/libnsecure.so") ||
        APK.isArchiveRecordPresent("lib/armeabi/libnsecure.so");

    return result();
}