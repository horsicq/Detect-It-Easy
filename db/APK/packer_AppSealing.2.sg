// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#appsealing, #appsealing_a

meta("packer", "AppSealing");

function detect() {
    if (APK_isRecordExp("libcovault\\.so") && APK_isRecordExp("libcovault-appsec\\.so") &&
        APK_isRecordExp("assets/appsealing\\.dex") && APK_isRecordExp("assets/sealed1\\.dex")) {
        // appsealing: all four names
        bDetected = true;
    } else if (APK_isRecordExp("assets/AppSealing/")) {
        // appsealing_a: #a1 > 3 counts raw occurrences (local and central names)
        bDetected = APK_countRawString("assets/AppSealing/", 4) > 3;
    }

    return result();
}
