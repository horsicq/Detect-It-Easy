// Detect It Easy: DiE-JS framework file
// Don't change anything unless you're sure about what you're doing

var File = APK;
var X = APK;


var APK_isArchiveRecordPresent = APK.isArchiveRecordPresent,
    APK_archiveRecordSearchResults = {};

/**
 * Check if an archive record is present and cache the result.
 * @returns {Boolean}
 */
APK.isArchiveRecordPresent = function (sRecordName) {
    var sCacheKey = "$" + sRecordName;

    if (APK_archiveRecordSearchResults[sCacheKey] === undefined) {
        APK_archiveRecordSearchResults[sCacheKey] = APK_isArchiveRecordPresent(sRecordName);
    }

    return APK_archiveRecordSearchResults[sCacheKey];
}

var APK_archiveRecordExpResults = {};

/**
 * Cached APK.isArchiveRecordPresentExp: true when any record name matches the
 * regular expression (unanchored, like a raw YARA string on the APK bytes).
 * @returns {Boolean}
 */
function APK_isRecordExp(sRegExp) {
    var sCacheKey = "$" + sRegExp;

    if (APK_archiveRecordExpResults[sCacheKey] === undefined) {
        APK_archiveRecordExpResults[sCacheKey] = APK.isArchiveRecordPresentExp(sRegExp);
    }

    return APK_archiveRecordExpResults[sCacheKey];
}

/**
 * Number of regular expressions in the list that match a record name
 * (YARA "N of ($a*)" over record names).
 * @returns {Number}
 */
function APK_countRecordExp(aRegExps) {
    var nResult = 0;

    for (var i = 0; i < aRegExps.length; i++) {
        if (APK_isRecordExp(aRegExps[i])) {
            nResult++;
        }
    }

    return nResult;
}

/**
 * Number of raw occurrences of a string in the whole file (YARA "#s"),
 * counted up to nLimit. fnCheck(nOffset), when given, must accept a hit.
 * @returns {Number}
 */
function APK_countRawString(sString, nLimit, fnCheck) {
    var nSize = APK.getSize(),
        nOffset = 0,
        nResult = 0;

    while ((nResult < nLimit) && (nOffset < nSize)) {
        var nFound = APK.findString(nOffset, nSize - nOffset, sString);

        if (nFound < 0) {
            break;
        }

        if ((fnCheck === undefined) || fnCheck(nFound)) {
            nResult++;
        }

        nOffset = nFound + 1;
    }

    return nResult;
}
