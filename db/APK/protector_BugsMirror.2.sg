// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/protectors.yara#bugsmirror

meta("protector", "BugsMirror");

function detect() {
    bDetected = APK_countRecordExp(["lib/(arm.*|x86.*)/libdefender\\.so", "res/xml/(com_bugsmirror_)?(defender|bugsmirror)_authenticator\\.xml", "lib/(arm.*|x86.*)/libsettings\\.so"]) >= 2;

    return result();
}
