// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#secneo_a, #secneo_b, #secneo_c

meta("protector", "SecNeo");

function detect() {
    if (APK_isRecordExp("libDexHelper\\.so|libDexHelper-x86\\.so|assets/classes0\\.jar")) {
        // secneo_base
        var bC = APK_isRecordExp("libdatajar\\.so"),
            bB = APK_isRecordExp("libdexjni\\.so|libdexjni%s\\.so");

        sVersion = bB ? (bC ? "B, C" : "B") : (bC ? "C" : "A");
        bDetected = true;
    } else {
        bDetected = (APK.isArchiveRecordPresent("lib/arm64-v8a/libDexHelper-x86_64.so") ||
            APK.isArchiveRecordPresent("lib/arm64-v8a/libDexHelper.so") ||
            APK.isArchiveRecordPresent("lib/armeabi-v7a/libDexHelper-x86.so") ||
            APK.isArchiveRecordPresent("lib/armeabi-v7a/libDexHelper.so") ||
            APK.isArchiveRecordPresent("lib/armeabi/libDexHelper-x86.so") ||
            APK.isArchiveRecordPresent("lib/armeabi/libDexHelper.so") ||
            APK.isArchiveRecordPresent("lib/x86/libDexHelper.so"));
    }

    return result();
}