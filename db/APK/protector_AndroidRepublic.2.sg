// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/obfuscators.yara#androidrepublic, #androidrepublic_vip

meta("protector", "AndroidRepublic");

function detect() {
    if (APK_isRecordExp("assets/androidrepublic\\.org/(.*)\\.png")) {
        sVersion = "VIP";
        bDetected = true;
    } else if (APK_isRecordExp("assets/emt\\.androidrepublic/(config|monkey|system|system_00[0-5])\\.png")) {
        bDetected = true;
    }

    return result();
}