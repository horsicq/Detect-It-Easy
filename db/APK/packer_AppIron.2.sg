// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#appiron

meta("packer", "Secucen AppIron");

function detect() {
    bDetected = APK_countRecordExp(["lib/(.*)/libAppIron-jni_v(.*)\\.so", "libAppIronExpress_v(.*)\\.so", "assets/appiron/(.*)"]) >= 2;

    return result();
}
