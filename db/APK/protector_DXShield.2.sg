// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#dxshield

meta("protector", "DXShield");

function detect() {
    bDetected = APK_isRecordExp("libdxbase\\.so|assets/DXINFO\\.XML");

    return result();
}