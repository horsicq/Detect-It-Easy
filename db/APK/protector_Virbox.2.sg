// https://appsec.virbox.com/
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/protectors.yara#virbox_apk

meta("protector", "Virbox");

function detect() {
    bDetected = APK_isRecordExp("libsandhook\\.so|libsandhook-native\\.so") && APK_isRecordExp("libv\\+\\+_64\\.so|libv\\+\\+\\.so");

    return result();
}