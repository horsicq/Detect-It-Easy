// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/protectors.yara#vguard

meta("protector", "VGuard");

function detect() {
    bDetected = APK_countRecordExp(["lib/(arm.*|x86.*)/libedex\\.so", "assets/dexsky\\.(d|e)b(a|b|x|y)", "assets/dex[a-z0-9]{3}\\.zip", "assets/vguard\\.(key|enginehash)", "assets/dexsky\\.ini"]) >= 2;

    return result();
}
