// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#tencent_legu, #tencent_legu_VMP

meta("protector", "TencentLegu");

function detect() {
    if (APK_isRecordExp("assets/libwsDataEncryption_AZAPP.*\\.so") && APK_isRecordExp("assets/wslib/(arm.*|x86.*)/libWSSec(V?)\\.so") &&
        APK_isRecordExp("assets/wsDal\\.jar") && APK_isRecordExp("assets/WSSEC(A|B|C|D)\\.jar")) {
        // tencent_legu_VMP
        sVersion = "VMP";
        bDetected = true;
    }

    if (APK_isRecordExp("assets/0OO00l111l1l") && APK_isRecordExp("assets/tosversion|assets/0OO00oo01l1l|assets/o0oooOO0ooOo\\.dat") &&
        !APK_isRecordExp("lib/(arm.*|x86.*)/(libshell|libmobisecy)\\.so|/mix\\.dex") &&
        !APK_isRecordExp("lib/(arm.*|x86.*)/libshell(a|x)-\\d\\.\\d\\.\\d\\.\\d\\.so") &&
        !(APK_isRecordExp("lib/(arm.*|x86.*)/libshell-superv(.*)\\.\\d{4}\\.so") && APK_isRecordExp("assets/dexMethod.*\\.dat"))) {
        // tencent_legu: not tencent, tencent_a, tencent_b
        bDetected = true;
    }

    if ((APK.isArchiveRecordPresent("assets/0OO00l111l1l") ||
            APK.isArchiveRecordPresent("assets/0OO00oo01l1l") ||
            APK.isArchiveRecordPresent("assets/libshellx-super.2019.so") ||
            APK.isArchiveRecordPresent("assets/o0oooOO0ooOo.dat") ||
            APK.isArchiveRecordPresent("lib/arm64-v8a/libshell-super.2019.so") ||
            APK.isArchiveRecordPresent("lib/armeabi/libshell-super.2019.so"))) {
        bDetected = true;
    }

    return result();
}