// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/obfuscators.yara#obfuscapk_libencryption

meta("protector", "Obfuscapk");

function detect() {
    if (APK_isRecordExp("assets/lib\\.arm(eabi|64)-v[0-9a-zA-Z]{2}\\.[!-~]+\\.so") ||
        APK_isRecordExp("assets/lib\\.x86(_64)?\\.[!-~]+\\.so")) {
        sOptions = "LibEncryption";
        bDetected = true;
    }

    return result();
}