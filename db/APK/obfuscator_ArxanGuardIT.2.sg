// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/obfuscators.yara#arxan_guardit

meta("obfuscator", "Arxan GuardIT");

function detect() {
    // #cfg > 1 for { 00 "guardit4j.fin" }: a root record name (local and central header copies)
    bDetected = APK_isRecordExp("^guardit4j\\.fin");

    return result();
}
