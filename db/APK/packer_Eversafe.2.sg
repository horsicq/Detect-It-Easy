// Detect It Easy: detection rule file
// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#eversafe

meta("packer", "Eversafe");

function detect() {
    bDetected = APK_countRecordExp(["lib/(.*)/libeversafe\\.so", "lib/(.*)/libeversafe-loader\\.so", "assets/eversafe/eversafe_(.*)\\.data"]) >= 2;

    return result();
}
