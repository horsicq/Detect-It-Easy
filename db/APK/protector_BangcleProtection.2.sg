meta("protector", "BangcleProtection");

function detect() {
    bDetected =
        APK.isArchiveRecordPresent("lib/armeabi/libsecexe.so") ||
        APK.isArchiveRecordPresent("lib/x86/libsecexe.so");

    return result();
}