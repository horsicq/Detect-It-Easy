// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#bangcle

meta("protector", "BangcleProtection");

function detect() {
    bDetected = APK_isRecordExp("libsecexe\\.so|libsecmain\\.so|assets/bangcleplugin/container\\.dex|bangcleclasses\\.jar|bangcle_classes\\.jar");

    return result();
}