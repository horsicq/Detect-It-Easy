// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#kiro

meta("protector", "Kiro");

function detect() {
    bDetected = (APK_isRecordExp("libkiroro\\.so") && APK_isRecordExp("assets/sbox")) || (APK.isArchiveRecordPresent("lib/armeabi/libkiroro.so"));

    return result();
}