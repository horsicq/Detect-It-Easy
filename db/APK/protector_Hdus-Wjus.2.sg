// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#chornclickers

meta("protector", "Hdus-Wjus");

function detect() {
    bDetected = (APK_isRecordExp("lib/armeabi/libhdus\\.so") && APK_isRecordExp("lib/armeabi/libwjus\\.so")) || (APK.isArchiveRecordPresent("lib/armeabi/libhdus.so") ||
            APK.isArchiveRecordPresent("lib/armeabi/libwjus.so"));

    return result();
}