// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#tencent, #tencent_a

meta("protector", "MobileTencentProtect");

function detect() {
    bDetected = APK_isRecordExp("lib/(arm.*|x86.*)/(libshell|libmobisecy)\\.so|/mix\\.dex") ||
        APK_isRecordExp("lib/(arm.*|x86.*)/libshell(a|x)-\\d\\.\\d\\.\\d\\.\\d\\.so") ||
        (APK.isArchiveRecordPresent("lib/armeabi-v7a/mix.dex") ||
            APK.isArchiveRecordPresent("lib/armeabi/mix.dex"));

    return result();
}