// Ported from APKiD 3.2.0 (RedNaga, GPL-3.0) rule apk/packers.yara#jiagu, #jiagu_a

meta("protector", "Jiagu");

function detect() {
    if (APK_isRecordExp("libjiagu\\.so|libjiagu_art\\.so") || (APK.isArchiveRecordPresent("assets/libjiagu.so") ||
            APK.isArchiveRecordPresent("assets/libjiagu_a64.so") ||
            APK.isArchiveRecordPresent("assets/libjiagu_ls.so") ||
            APK.isArchiveRecordPresent("assets/libjiagu_x64.so") ||
            APK.isArchiveRecordPresent("assets/libjiagu_x86.so"))) {
        bDetected = true;
    } else if (APK_isRecordExp("assets/jiagu_data\\.bin") && APK_isRecordExp("assets/sign\\.bin") && APK_isRecordExp("libapktoolplus_jiagu\\.so")) {
        // jiagu_a
        sOptions = "ApkToolPlus";
        bDetected = true;
    }

    return result();
}