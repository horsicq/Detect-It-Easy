        var nThreshold = ((list[i][0] << 16) | (list[i][1] << 8) | list[i][2]) >>> 0;

        if (nVersion < nThreshold) {
            return list[i][3];
        }
    }

    return String();
}

function detect() {
    var nMagic = readU32(0, false),
        bBE = false,
        bIs64 = false;

    if (nMagic == 0xFEEDFACE) {
        bIs64 = false;
    } else if (nMagic == 0xFEEDFACF) {
        bIs64 = true;
    } else if (nMagic == 0xCEFAEDFE) {
        bBE = true;
    } else if (nMagic == 0xCFFAEDFE) {
        bBE = true;
        bIs64 = true;
    } else {
        return;
    }

    var nNumberOfCommands = readU32(0x10, bBE),
        nSizeOfCommands = readU32(0x14, bBE),
        nOffset = bIs64 ? 0x20 : 0x1C,
        nEnd = Math.min(nOffset + nSizeOfCommands, MACH.getSize()),
        bCodeSignature = false,
        nBuildVersionOffset = -1,
        nVersionMinOffset = -1,
        nVersionMinCommand = 0,
        bObjCSegment = false;

    for (var i = 0; (i < nNumberOfCommands) && (i < 0x10000) && (nOffset + 8 <= nEnd); i++) {
        var nCommand = readU32(nOffset, bBE),
            nCommandSize = readU32(nOffset + 4, bBE);

        if (nCommand == 0x1D) {
            bCodeSignature = true;
        } else if (nCommand == 0x32) {
            if (nBuildVersionOffset == -1) nBuildVersionOffset = nOffset;
        } else if (nCommand == 0x25 || nCommand == 0x24 || nCommand == 0x2F || nCommand == 0x30) {
            if (nVersionMinOffset == -1) {
                nVersionMinOffset = nOffset;
                nVersionMinCommand = nCommand;
            }
        } else if (nCommand == 0x1 || nCommand == 0x19) {
            if (MACH.getString(nOffset + 8, 16) == "__OBJC") bObjCSegment = true;
        }

        if (nCommandSize < 8) {
            break;
        }

        nOffset += nCommandSize;
    }

    var nOSColumn = getOSColumn(MACH.getOperationSystemName()),
        sSDKName = String(),
        sSDKVersion = String(),
        sXcodeVersion = String(),
        bGCC = MACH.isLibraryPresent("libgcc_s.1.dylib"),
        bClang = false,
        sClangVersion = String(),
        bSwift = false,
        sSwiftVersion = String(),
        bLinker = false,
        sLinkerVersion = String(),
        sObjC = String();

    if (bCodeSignature) {
        _setResult("sign tool", "codesign", String(), String());
    }

    if (MACH.isLibraryPresent("Foundation")) {
        var nFoundationVersion = MACH.getLibraryCurrentVersion("Foundation") >>> 0;

        if (nOSColumn == 0) {
            sSDKName = "macOS SDK";
            sSDKVersion = getSDKVersionFromFoundation(nFoundationVersion, 0);
        } else if (nOSColumn == 1) {
            sSDKName = "iOS SDK";
            sSDKVersion = getSDKVersionFromFoundation(nFoundationVersion, 1);
        }

        _setResult("library", "Foundation", getFullVersion(nFoundationVersion), String());
    }

    if (MACH.isSectionNamePresent("__swift5_proto") || MACH.isSectionNamePresent("__swift5_types") ||
        MACH.isSectionNamePresent("__swift2_proto") || MACH.isLibraryPresent("libswiftCore.dylib")) {
        bSwift = true;
    }

    if (MACH.isSectionNamePresent("__objc_selrefs") || bObjCSegment || MACH.isLibraryPresent("libobjc.A.dylib")) {
        sObjC = "Objective-C";
    }

    var listTools = [];

    if (nBuildVersionOffset != -1) {
        var nPlatform = readU32(nBuildVersionOffset + 8, bBE),
            nSDK = readU32(nBuildVersionOffset + 16, bBE),
            nTools = readU32(nBuildVersionOffset + 20, bBE),
            nCmdSize = readU32(nBuildVersionOffset + 4, bBE);

        if (nPlatform == 1) sSDKName = "macOS SDK";
        else if (nPlatform == 5) sSDKName = "bridgeOS";
        else if (nPlatform == 2 || nPlatform == 7) sSDKName = "iOS SDK";
        else if (nPlatform == 3 || nPlatform == 8) sSDKName = "tvOS SDK";
        else if (nPlatform == 4 || nPlatform == 9) sSDKName = "watchOS SDK";

        if (nSDK) {
            sSDKVersion = getFullVersion(nSDK);
        }

        if (nCmdSize > 24) {
            nTools = Math.min(nTools, 64);

            for (var j = 0; j < nTools; j++) {
                listTools.push([readU32(nBuildVersionOffset + 24 + j * 8, bBE), readU32(nBuildVersionOffset + 28 + j * 8, bBE)]);
            }
        }
    } else if (nVersionMinOffset != -1) {
        if (nVersionMinCommand == 0x25) sSDKName = "iOS SDK";
        else if (nVersionMinCommand == 0x24) sSDKName = "macOS SDK";
        else if (nVersionMinCommand == 0x2F) sSDKName = "tvOS SDK";
        else if (nVersionMinCommand == 0x30) sSDKName = "watchOS SDK";

        var nVersionMinSDK = readU32(nVersionMinOffset + 12, bBE);

        if (nVersionMinSDK) {
            sSDKVersion = getFullVersion(nVersionMinSDK);
        }
    }

    if (sSDKName && sSDKVersion) {
        sXcodeVersion = getXcodeVersionFromSDK(sSDKVersion, nOSColumn);

        if (sXcodeVersion) {
            var listToolchain = getToolchain(sXcodeVersion);

            if (listToolchain[0]) {
                bClang = true;
                sClangVersion = listToolchain[0];
            }

            if (listToolchain[1]) {
                bSwift = true;
                sSwiftVersion = listToolchain[1];
            }
        }
    }

    for (var k = 0; k < listTools.length; k++) {
        var sToolVersion = getFullVersion(listTools[k][1]);

        if (listTools[k][0] == 2) {
            bSwift = true;
            sSwiftVersion = sToolVersion;
        } else if (listTools[k][0] == 1) {
            bClang = true;
            sClangVersion = sToolVersion;
        } else if (listTools[k][0] == 3) {
            bLinker = true;
            sLinkerVersion = sToolVersion;
        }
    }

    if (bLinker) {
        _setResult("linker", "Xcode ld", sLinkerVersion, String());
    }

    if (!bGCC && !bClang) {
        bClang = true;
    }

    if (bClang && !_isResultPresent("compiler", "clang")) {
        _setLang("C/C++");
        _setResult("compiler", "clang", sClangVersion, sObjC);
    }

    if (bSwift && !_isResultPresent("compiler", "Swift")) {
        _setLang("Swift");
        _setResult("compiler", "Swift", sSwiftVersion, String());
    }

    if (sSDKName) {
        _setResult("tool", sSDKName, sSDKVersion, String());
        _setResult("tool", "Xcode", sXcodeVersion, String());
    }
}
