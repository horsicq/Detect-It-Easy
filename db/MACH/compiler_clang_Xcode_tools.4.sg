// Detect It Easy: detection rule file
// Ported from Nauz File Detector (SpecAbstract nfd_mach.cpp:70-366, NFD_MACH::handle_Tools; tables from
// Formats/exec/xmach.cpp: _TABLE_XCODE_VERSIONS, _TABLE_XCODE_TOOLCHAINS_5, _TABLE_FOUNDATION_VERSIONS,
// _TABLE_IOS_FOUNDATION_VERSIONS)
// Results: sign tool codesign (LC_CODE_SIGNATURE), library Foundation, tool macOS/iOS/tvOS/watchOS SDK or
// bridgeOS (LC_BUILD_VERSION / LC_VERSION_MIN_* / Foundation version), tool Xcode, linker Xcode ld and compilers
// clang / Swift (LC_BUILD_VERSION tools, Xcode toolchain table). clang is the default compiler when gcc
// (libgcc_s.1.dylib) is not linked, as in NFD.

function readU32(nOffset, bBE) {
    if (bBE) {
        return ((MACH.readByte(nOffset) << 24) | (MACH.readByte(nOffset + 1) << 16) | (MACH.readByte(nOffset + 2) << 8) | MACH.readByte(nOffset + 3)) >>> 0;
    }

    return ((MACH.readByte(nOffset + 3) << 24) | (MACH.readByte(nOffset + 2) << 16) | (MACH.readByte(nOffset + 1) << 8) | MACH.readByte(nOffset)) >>> 0;
}

// XBinary::get_uint32_full_version
function getFullVersion(nValue) {
    return ((nValue >>> 16) & 0xFFFF) + "." + ((nValue >>> 8) & 0xFF) + "." + (nValue & 0xFF);
}

// "1.0.0" == "1.0" == "1" (XMACH::getXcodeVersionFromSDK)
function normalizeVersion(sVersion) {
    while (sVersion.length > 2 && sVersion.substr(sVersion.length - 2) == ".0") {
        sVersion = sVersion.substr(0, sVersion.length - 2);
    }

    return sVersion;
}

// 0: macOS, 1: iOS, 2: watchOS, 3: tvOS, -1: other
function getOSColumn(sOSName) {
    if (sOSName == "macOS" || sOSName == "OS X" || sOSName == "Mac OS X") return 0;
    if (sOSName == "iOS" || sOSName == "iPhoneOS" || sOSName == "iPhone OS" || sOSName == "iPadOS") return 1;
    if (sOSName == "watchOS") return 2;
    if (sOSName == "tvOS") return 3;
    return -1;
}

