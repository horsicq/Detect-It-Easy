// Detect It Easy: detection rule file
// Author: horsicq <horsicq@gmail.com>

// https://upx.github.io/
meta("packer", "UPX");

function detect() {
    var nSection = MACH.getSectionNumber("upxTEXT");
    var nSize = MACH.getSize();
    var nSearchOffset = 0;
    var nSearchSize = 0;

    if (nSection !== -1) {
        var nSectionOffset = MACH.getSectionFileOffset(nSection);
        var nSectionSize = MACH.getSectionFileSize(nSection);

        // l_info and p_info precede the compressed data. ARM64/ARM64e
        // executables have one section; older layouts can have more.
        if (nSectionOffset > 0 && nSectionSize >= 24 &&
            nSectionOffset <= nSize && nSectionSize <= nSize - nSectionOffset &&
            MACH.compare("'UPX!'", nSectionOffset + 4)) {
            var nFormat = MACH.readByte(nSectionOffset + 11);

            // UPX_F_MACH: i386, ARM, AMD64, ARM64, PPC32, PPC64.
            if (nFormat === 29 || nFormat === 32 || nFormat === 34 ||
                nFormat === 37 || nFormat === 131 || nFormat === 139) {
                bDetected = true;

                var nEntryPoint = MACH.getEntryPointOffset();
                var nLoaderSize = MACH.readByte(nSectionOffset + 8) +
                    256 * MACH.readByte(nSectionOffset + 9);
                if (nFormat === 131 || nFormat === 139) {
                    nLoaderSize = 256 * MACH.readByte(nSectionOffset + 8) +
                        MACH.readByte(nSectionOffset + 9);
                }

                // IDENTSTR is part of the loader, not the compressed payload.
                if (nEntryPoint >= nSectionOffset + 24 &&
                    nEntryPoint < nSectionOffset + nSectionSize &&
                    nLoaderSize <= nSectionOffset + nSectionSize - nEntryPoint) {
                    nSearchOffset = nEntryPoint;
                    nSearchSize = nLoaderSize;
                }
            }
        }
    } else if (MACH.getNumberOfSections() === 2) {
        // Legacy stubs: search only the file-backed section containing the EP.
        var nLegacyEntryPoint = MACH.getEntryPointOffset();
        for (var i = 0; i < 2; i++) {
            var nLegacyOffset = MACH.getSectionFileOffset(i);
            var nLegacySize = MACH.getSectionFileSize(i);
            if (nLegacyOffset > 0 && nLegacySize >= 13 &&
                nLegacyOffset <= nSize && nLegacySize <= nSize - nLegacyOffset &&
                nLegacyEntryPoint >= nLegacyOffset &&
                nLegacyEntryPoint < nLegacyOffset + nLegacySize) {
                nSearchOffset = nLegacyOffset;
                nSearchSize = nLegacySize;
                break;
            }
        }
    }

    if (nSearchSize >= 13) {
        var nOffset = MACH.findString(nSearchOffset, nSearchSize, "$Id: UPX ");
        if (nOffset !== -1 && nOffset <= nSearchOffset + nSearchSize - 13) {
            var sUPXVersion = MACH.getString(nOffset + 9, 4);
            // The header revision is not a product version. --small may omit it.
            if (/^[0-9]\.[0-9]{2}$/.test(sUPXVersion)) {
                sVersion = sUPXVersion;
                bDetected = true;
            }
        }
    }

    return result();
}
