// https://github.com/fxgenstudio/NetPacker
meta("packer", "NetPacker");

function detect() {
    if (PE.isNet()) {
        if (PE.isNetUStringPresent("Packed.exetemp_c.dat")) {
            bDetected = true;
        }
    }

    return result();
}