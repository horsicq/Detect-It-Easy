meta("protector", "Sepanta");

function detect() {
    if (PE.isOverlayPresent()) {
        if (PE.findString(PE.getOverlayOffset(), 2048, "Sepanta>") !== -1) {
            bDetected = true;
        }
    }

    return result();
}