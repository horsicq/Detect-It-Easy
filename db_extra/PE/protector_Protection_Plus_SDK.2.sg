// Detect It Easy: detection rule file
// Author: Xylitol <xylitol@temari.fr>

// Distinctive paths documented in the official SDK license schema.
// searched once as ASCII and once as UTF-16LE.
// https://www.softwarekey.com/help/plus5/Content/License_File_Schema.html
meta("protector", "Protection PLUS SDK");

function detect() {
    var size = PE.getSize();
    // "/SoftwareKey/PrivateData/License/" as ASCII, then as UTF-16LE.
    if (PE.isSignaturePresent(0, size, "2F536F6674776172654B65792F50726976617465446174612F4C6963656E73652F") ||
        PE.isSignaturePresent(0, size, "2F0053006F006600740077006100720065004B00650079002F00500072006900760061007400650044006100740061002F004C006900630065006E00730065002F00")) {
        sVersion = "5.x";
        bDetected = true;
    }
    return result();
}
