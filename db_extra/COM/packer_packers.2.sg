meta("packer", "Packer");

function detect() {
    if (Binary.compare("565056fd8bfc83ef..b9....be....f3a447ffe7")) {
        sOptions = "1997 by CyberWare";
        bDetected = true;
    } else if (Binary.compare("508cc890ba....05....3b06....72..b4..ba....cd21b8....cd21")) {
        sOptions = "1996 by LostSoul";
        bDetected = true;
    }

    return result();
}