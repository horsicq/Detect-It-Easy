// Detect It Easy: unsigned AI attribution research rule for ZIP-derived formats
// Complements marker_AI_provenance: it only fires when the archive carries NO
// META-INF/content_credential.c2pa carrier. Evidence is plain text in STORED
// (method 0) member payloads (the Claude office samples store
// docProps/core.xml, docProps/app.xml, docProps/custom.xml, meta.xml, and
// content.opf uncompressed) and in the end-of-central-directory archive
// comment. LIMITATION: real-world Office/ODF/EPUB writers normally DEFLATE
// their metadata members, and this rule cannot read deflated text.
// Attribution, not proof.

includeScript("_ai_provenance");
meta("marker", "AI attribution (unsigned)");

function detect() {
    if (!aiDetectZipC2pa()) {
        var oAttribution = aiDetectZipUnsignedAttribution();

        if (oAttribution) {
            sVersion = oAttribution.version;
            sOptions = oAttribution.options;
            bDetected = true;
        }
    }

    return result();
}
