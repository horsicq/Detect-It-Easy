// Detect It Easy: unsigned AI attribution research rule for generic files
// Runs for files DIE dispatches to its generic Binary scanner (plain text,
// source code, RTF, WAV LIST INFO, SQLite, SVG/HTML, and similar). DIE sends
// recognized PNG/JPEG/ZIP/PDF/PE files to their own signature folders, which
// have their own copies of this marker, so there is no double report.
// Complements marker_AI_provenance: it only fires when no C2PA carrier is
// recognized. Evidence is plain text within the first 16 KB or the trailing
// 64 KB — trailing metadata regions (TIFF IFD text tags, RIFF LIST/EXIF/XMP
// chunks in WAV/WebP) sit near end-of-file. Attribution, not proof.

includeScript("_ai_provenance");
meta("marker", "AI attribution (unsigned)");

function detect() {
    if (!aiDetectBinaryC2pa()) {
        var nFileSize = Binary.getSize();
        var oState = aiNewAttributionState();

        aiScanAttributionRegion(oState, 0, Math.min(nFileSize, 16 * 1024), "leading 16 KB");

        var nTailStart = nFileSize - (64 * 1024);

        if (nTailStart < (16 * 1024)) {
            nTailStart = 16 * 1024;
        }

        if (nTailStart < nFileSize) {
            aiScanAttributionRegion(oState, nTailStart, nFileSize - nTailStart, "trailing 64 KB");
        }

        var sEvidence = aiFormatAttributionEvidence(oState);

        if (sEvidence) {
            sVersion = "generic text";
            sOptions = sEvidence;
            bDetected = true;
        }
    }

    return result();
}
