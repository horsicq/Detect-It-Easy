// Detect It Easy: C2PA carrier research rule for RIFF, BMFF, TIFF, GIF, SVG, and OpenType

includeScript("_ai_provenance");
meta("marker", "C2PA manifest carrier");

function detect() {
    var oCarrier = aiDetectBinaryC2pa();

    if (oCarrier) {
        sVersion = oCarrier.version;
        sOptions = oCarrier.options;
        bDetected = true;
    }

    return result();
}
