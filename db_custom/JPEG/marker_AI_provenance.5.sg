// Detect It Easy: C2PA carrier research rule for JPEG

includeScript("_ai_provenance");
meta("marker", "C2PA manifest carrier");

function detect() {
    var oCarrier = aiDetectJpegC2pa();

    if (oCarrier) {
        sVersion = oCarrier.version;
        sOptions = oCarrier.options;
        bDetected = true;
    }

    return result();
}
