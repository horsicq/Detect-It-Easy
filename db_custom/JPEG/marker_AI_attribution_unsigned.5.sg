// Detect It Easy: unsigned AI attribution research rule for JPEG
// Complements marker_AI_provenance: it only fires when the file carries NO
// C2PA APP11/JUMBF carrier. Evidence is plain text in APP1 (EXIF/XMP) and COM
// segment payloads: attribution, not proof.

includeScript("_ai_provenance");
meta("marker", "AI attribution (unsigned)");

function detect() {
    if (!aiDetectJpegC2pa()) {
        var oAttribution = aiDetectJpegUnsignedAttribution();

        if (oAttribution) {
            sVersion = oAttribution.version;
            sOptions = oAttribution.options;
            bDetected = true;
        }
    }

    return result();
}
