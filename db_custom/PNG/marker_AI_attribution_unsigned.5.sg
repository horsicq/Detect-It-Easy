// Detect It Easy: unsigned AI attribution research rule for PNG
// Complements marker_AI_provenance: it only fires when the file carries NO
// C2PA manifest carrier, so a signed-carrier file is reported once, by the
// carrier rule. Evidence is plain text in tEXt/iTXt/zTXt/eXIf chunk payloads:
// attribution, not proof.

includeScript("_ai_provenance");
meta("marker", "AI attribution (unsigned)");

function detect() {
    if (!aiDetectPngC2pa()) {
        var oAttribution = aiDetectPngUnsignedAttribution();

        if (oAttribution) {
            sVersion = oAttribution.version;
            sOptions = oAttribution.options;
            bDetected = true;
        }
    }

    return result();
}
