// Detect It Easy: unsigned AI attribution research rule for PE
// DIE dispatches PE files to the PE signature folder, so the generic Binary
// rule never runs for them. Attribution strings in .rdata regularly sit
// beyond the first 16 KB, so this rule scans the whole file bounded to 4 MB.
// ASCII text only; UTF-16LE VERSIONINFO strings are not decoded by this scan.
// Attribution, not proof.

includeScript("_ai_provenance");
meta("marker", "AI attribution (unsigned)");

function detect() {
    var oAttribution = aiDetectGenericUnsignedAttribution(4 * 1024 * 1024, "PE text", "file bounded to 4 MB");

    if (oAttribution) {
        sVersion = oAttribution.version;
        sOptions = oAttribution.options;
        bDetected = true;
    }

    return result();
}
