// Detect It Easy: C2PA embedded-file carrier research rule for PDF

meta("marker", "C2PA manifest carrier");

function detect() {
    var nFileSize = Binary.getSize();
    var nSubtypeOffset = Binary.findString(0, nFileSize, "/Subtype /application#2Fc2pa");
    var nRelationshipOffset = Binary.findString(0, nFileSize, "/AFRelationship /C2PA_Manifest");

    if ((nSubtypeOffset !== -1) && (nRelationshipOffset !== -1)) {
        sVersion = "PDF associated file";
        sOptions = "PDF C2PA embedded-file dictionary present; embedded stream and cryptography unverified";
        bDetected = true;
    }

    return result();
}
