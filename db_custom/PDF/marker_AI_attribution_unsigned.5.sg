// Detect It Easy: unsigned AI attribution research rule for PDF
// Complements marker_AI_provenance: it only fires when the PDF carries NO
// C2PA associated-file dictionary candidate. Evidence is plain text in the
// first/last 1 MB (Info dictionary near the trailer, uncompressed XMP
// packets). Text inside compressed object streams is not visible to this
// rule. Attribution, not proof.

includeScript("_ai_provenance");
meta("marker", "AI attribution (unsigned)");

function detect() {
    if (!aiPdfHasC2paTokens()) {
        var oAttribution = aiDetectPdfUnsignedAttribution();

        if (oAttribution) {
            sVersion = oAttribution.version;
            sOptions = oAttribution.options;
            bDetected = true;
        }
    }

    return result();
}
