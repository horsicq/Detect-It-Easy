function detect(){if(8<=X.Sz()&&X.c("1B'Lua'..00")){switch(bDetected=1,X.U8(4)){case 80:sVersion="v5.0"
break
case 81:sVersion="v5.1"
break
case 82:sVersion="v5.2"
break
case 83:sVersion="v5.3"
break
case 84:sVersion="v5.4"
break
default:return}if(X.isVerbose())switch(X.U8(6)){case 0:sOption("BigEndian")
break
case 1:sOption("LittleEndian")
break
default:return}}return sLang="Lua",result()}meta("format","Lua Bytecode (.LUAC)")