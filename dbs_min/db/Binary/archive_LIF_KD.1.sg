function detect(){for(var e=X.Sz(),r=0,a=0;r+54<e&&a<4096;){var t=X.getString(r,34)
if(!/^[0-9a-fA-F]{32}0[12]$/.test(t))break
var i=X.readByte(r+34)
if(i<33||126<i)break
i=parseInt(t.substring(8,16),16)
if(0==i||e-r-54<i)break
if(a++,(r+=54+i)==e){sOptions=a+" members",bDetected=1
break}}return result()}meta("archive","KDC LIF packed file")