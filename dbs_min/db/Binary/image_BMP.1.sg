function detect(){if(40<=X.Sz()&&X.c("'BM'")&&X.Sz()>=X.readDword(2)){switch(X.readDword(14)){case 40:sVersion="3"
break
case 108:sVersion="4"
break
case 124:sVersion="5"}if(sVersion){switch(X.readDword(30)){case 1:case 2:sOptions="RLE"
break
case 4:sOptions="JPEG"
break
case 5:sOptions="PNG"}(nHeight=~~X.readDword(22))<0&&(nHeight=-nHeight,sOptions=sOptions.append("top-down")),sOptions=sOptions.append(X.readDword(18)+"x"+nHeight,X.readWord(28)+"bpp")}bDetected=1}return result()}meta("image","Windows Bitmap")