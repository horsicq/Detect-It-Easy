function detect(){if(!PE.isNet()){var e=PE.section[".rdata"]
if(e){var i=PE.findSignature(e.FileOffset,Math.min(20480,e.FileSize),"'\\mod.rs'")
if(-1!==i){for(var t=e.FileOffset+e.FileSize,r=i,a=0;a<7;a++){var f=Math.min(4096,t-r)
if(f<15)break
if(-1===(r=PE.findSignature(r,f,"%% %% %% %% %% %% %% %% %% %% %% '.rs' 00")))break
r+=15}7===a&&(bDetected=1)}}return sLang="Rust",result()}}meta("compiler","Rust")