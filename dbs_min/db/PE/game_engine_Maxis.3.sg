function detect(){return X.isExportFunctionPresent("GZDllGetGZCOMDirector")||"Maxis, a division of Electronic Arts Inc."==X.getVersionStringInfo("CompanyName")?(sOptions=X.getVersionStringInfo("Comments"),bDetected=1):"Maxis, a division of Electronic Arts"!=X.getVersionStringInfo("CompanyName")&&"Copyright © 2003 Maxis. All Rights Reserved"!=X.getVersionStringInfo("LegalCopyright")||(bDetected=1),bDetected&&(sVersion=File.cleanString(X.getFileVersion())),result()}meta("game engine","Maxis")