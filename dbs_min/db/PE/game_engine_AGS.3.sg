function detect(){return(bDetected=!X.compareOverlay("434c49421a")&&"This game was created using AGS - http://www.adventuregamestudio.co.uk/"!=X.getVersionStringInfo("Comment")&&"Adventure Game Studio run-time engine"!=X.getVersionStringInfo("FileDescription")&&"Made with Adventure Game Studio"!=X.getVersionStringInfo("ProductName")?bDetected:!0)&&(sVersion=File.cleanString(X.getFileVersion())),result()}meta("game engine","Adventure Game Studio (AGS)")