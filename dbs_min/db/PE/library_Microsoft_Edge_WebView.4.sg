function detect(){return(X.isLibraryPresent("WebView2Loader.dll")||X.isLibraryPresent("msedge_elf.dll")||X.isNetObjectPresent("Microsoft.Web.WebView2")||X.isNetObjectPresent("Microsoft.Web.WebView2.WinForms")||X.isNetObjectPresent("Microsoft.Web.Wpf"))&&(bDetected=1),result()}meta("library","Microsoft Edge Chromium WebView")