function detect(){return X.isExportFunctionPresent("_FindEmbeddedMovie")||X.isExportFunctionPresent("_GetCurrentEmbeddedMovie")||"Copyright © 1985-1996 Macromedia, Inc."==X.getVersionStringInfo("LegalCopyright")||"Copyright © 1985-1997 Macromedia, Inc."==X.getVersionStringInfo("LegalCopyright")?bDetected=1:"Director 8 Shockwave Studio"==X.getVersionStringInfo("ProductName")||"Director 8.5 Shockwave Studio"==X.getVersionStringInfo("ProductName")?(sOptions="Shockwave Studio",bDetected=1):"Copyright © 1985-2002 Macromedia, Inc."==X.getVersionStringInfo("LegalCopyright")||"Copyright © 1985-2003 Macromedia, Inc."==X.getVersionStringInfo("LegalCopyright")?bDetected=1:"Director MX 2004"==X.getVersionStringInfo("ProductName")?(sOptions="MX 2004",bDetected=1):"Director 11.3"==X.getVersionStringInfo("ProductName")||"Director 11.5"==X.getVersionStringInfo("ProductName")?bDetected=1:"12.0.1 Development"==X.getVersionStringInfo("ProductVersion")&&(sOptions="Development build",bDetected=1),bDetected&&(sVersion=File.cleanString(X.getFileVersion())),result()}meta("game engine","Director")