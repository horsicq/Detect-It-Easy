function detect(){for(var e=0,r=/d3dx?(\d{1,2})/i,t=0;t<X.getNumberOfImports();t++)-1!==(s=X.getImportLibraryName(t)).toLowerCase().indexOf("d3d")&&(i=s.match(r))&&/^\d+$/.test(i[1])&&Number(i[1])>e&&(e=Number(i[1]))
for(var s,i,t=0;t<X.getNumberOfExportFunctions();t++)-1!==(s=X.getExportFunctionName(t)).toLowerCase().indexOf("d3d")&&(i=s.match(r))&&/^\d+$/.test(i[1])&&Number(i[1])>e&&(e=Number(i[1]))
return 0<e&&e<=13?(sVersion=String(e),bDetected=1):(sVersion=X.isLibraryPresentExp(/^d3d(\d{1,2})/i))&&1<sVersion.length&&0<(sVersion=sVersion[1])&&sVersion<=13&&(bDetected=1),result()}meta("library","Direct3D")