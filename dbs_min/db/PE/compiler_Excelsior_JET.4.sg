function detect(){for(var e=0,t=0;t<=PE.nLastSection;t++){var i=PE.section[t].FileOffset,a=PE.section[t].Name
if(".jidata"==a?PE.isSignaturePresent(i,Math.min(PE.section[t].FileSize,16),"'JIMP'")&&++e:".jedata"==a?PE.isSignaturePresent(i,Math.min(PE.section[t].FileSize,16),"'JEXP'")&&++e:".config"==a&&++e,3==e){bDetected=1
break}}return sLang="Java",result()}meta("compiler","Excelsior JET")