function detect(){return bDetected=X.isArchiveRecordPresent("assets/ap.others/apkprotect.bin")||X.isArchiveRecordPresent("assets/ap.src/apkprotect-v1.bin")||X.isArchiveRecordPresent("assets/ap.src/apkprotect-v2.bin")||X.isArchiveRecordPresent("assets/ap.src/apkprotect-v3.bin")||X.isArchiveRecordPresent("lib/arm64-v8a/libapkprotect.so")||X.isArchiveRecordPresent("lib/armeabi-v7a/libapkprotect.so")||X.isArchiveRecordPresent("lib/x86/libapkprotect.so")||X.isArchiveRecordPresent("lib/x86_64/libapkprotect.so"),result()}meta("protector","APKProtector")