function detect(){return bDetected=X.isArchiveRecordPresent("assets/nedata.db")||X.isArchiveRecordPresent("assets/nedig.properties")||X.isArchiveRecordPresent("lib/arm/libnesec.so")||X.isArchiveRecordPresent("lib/arm/libnesec-x86.so")||X.isArchiveRecordPresent("lib/arm/libnshelper.so")||X.isArchiveRecordPresent("com/netease/nis/wrapper")||X.isArchiveRecordPresent("com/netease/nis/wrapper/MyApplication"),result()}meta("protector","NetEase EasyShield")