function detect(){return bDetected=X.isArchiveRecordPresent("assets/baiduprotect.jar")||X.isArchiveRecordPresent("assets/libbaiduprotect_x86.so")||X.isArchiveRecordPresent("lib/armeabi-v7a/libbaiduprotect.so")||X.isArchiveRecordPresent("lib/armeabi/libbaiduprotect.so")||X.isArchiveRecordPresent("lib/mips/libbaiduprotect.so")||X.isArchiveRecordPresent("lib/x86/libbaiduprotect.so"),result()}meta("protector","BaiduProtection")