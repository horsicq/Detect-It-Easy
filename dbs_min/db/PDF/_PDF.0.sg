function detect(){return sName=PDF.getFileFormatName(),sVersion=PDF.getFileFormatVersion(),sOptions=PDF.getFileFormatOptions(),PDF.isEncrypted()&&((sEnc=PDF.getEncryption())&&(sOptions=sOptions.append(sEnc)),sPerm=PDF.getPermissions())&&(sOptions=sOptions.append(", allow["+sPerm+"]")),bDetected=1,result()}meta("format","PDF")